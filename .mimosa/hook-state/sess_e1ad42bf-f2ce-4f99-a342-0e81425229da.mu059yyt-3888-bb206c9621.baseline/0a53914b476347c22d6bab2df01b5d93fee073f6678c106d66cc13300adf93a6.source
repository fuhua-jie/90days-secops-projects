  q('q826', '网络与流量', 2, '端口 4444/3333 出现外联连接，优先怀疑？', ['网页浏览', 'C2 回连或矿池', 'DNS 解析', '打印服务'], 1, '4444（Metasploit 默认）/3333（矿池常用）是高危外联端口。');
  q('q827', '网络与流量', 2, 'DNS 隧道外传数据的流量特征是？', ['超长子域名高频 TXT 查询', '全 200 状态码', 'UDP 短包', 'HTTPS 加密'], 0, '把数据编码进子域名，产生超长子域名+高频 TXT 查询的组合特征。');
