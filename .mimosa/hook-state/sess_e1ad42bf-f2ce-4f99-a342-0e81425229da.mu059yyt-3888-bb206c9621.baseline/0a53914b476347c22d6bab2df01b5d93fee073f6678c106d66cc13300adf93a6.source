  q('q816', 'Windows与域', 2, 'Sysmon 相比默认日志最大的增强是？', ['界面好看', '进程级遥测（命令行/哈希/网络/注入）', '更省电', '自动修漏洞'], 1, 'Sysmon 提供进程创建命令行、网络连接、镜像加载等高级遥测，是 EDR 检测的数据底座。');
  q('q817', 'Windows与域', 3, '黄金票据伪造的是哪类票据？', ['TGT（用 krbtgt 哈希加密）', 'Web Session', 'SSH 密钥', 'API Token'], 0, '持有 krbtgt 哈希即可给任意账号签发 TGT——解药是 krbtgt 重置两次。');
  q('q818', 'Windows与域', 2, 'Net-NTLMv2 哈希被捕获后最有效的利用方式？', ['直接登录', '离线爆破出明文', '删除日志', '重装系统'], 1, 'Net-NTLMv2 不可直接重放（区别于 NT 哈希），需字典/彩虹表离线爆破。');
  q('q819', 'Windows与域', 3, '关闭 LLMNR/NBNS 可以防住哪类攻击？', ['DDoS', 'Responder 投毒抓哈希', 'SQL 注入', 'XSS'], 1, 'LLMNR/NBNS 名称解析投毒靠这两个协议劫持认证——组策略禁用是最直接防御。');
  q('q820', 'Windows与域', 2, '组策略偏好（GPP）漏洞的根源是？', ['cpassword 使用公开 AES 密钥加密', '密码太长', '域太大', 'U 盘'], 0, 'MS14-025 前的 cpassword 用公开密钥加密，任何人可解密——残留 XML 必须清理。');
  q('q821', 'Windows与域', 3, 'AD CS ESC1 漏洞的核心配置错误是？', ['证书过期', '模板允许申请者自填 SAN 且域管可授权', '证书太长', '用了 ECC'], 1, 'ENROLLEE_SUPPLIES_SUBJECT + 域管授权模板 = 任意身份证书申请（ESC1）。');
  q('q822', 'Windows与域', 2, '排查"谁在什么时候动了注册表 Run 键"，最直接的证据来源？', ['Sysmon 事件 12-14', '系统日志 6005', 'DNS 日志', '防火墙日志'], 0, 'Sysmon 12-14 记录注册表增删改，是自启动持久化排查的第一数据源。');
  q('q823', 'Windows与域', 2, 'secretsdump 类工具批量导出 NTLM 哈希后，正确的响应是？', ['只改一个域管密码', '全量轮换暴露凭据并排查横向', '重启所有机器', '无动作'], 1, '哈希库泄露意味着所有使用 NT 哈希的账号都可能被 PTH，必须全量轮换。');
  q('q824', 'Windows与域', 1, 'Wevtutil cl Security 对应的事件 ID 是？', ['1102', '4624', '7045', '4688'], 0, '1102=审计日志被清除，出现即最高级别警报。');
  q('q825', 'Windows与域', 3, '域环境检测 DCSync 的关键事件是？', ['4662 DSReplicationGetChangesAll', '4624', '7045', '4625'], 0, '4662 带复制权限的目录访问就是 DCSync 特征，重点盯非 DC 账号发起。');

