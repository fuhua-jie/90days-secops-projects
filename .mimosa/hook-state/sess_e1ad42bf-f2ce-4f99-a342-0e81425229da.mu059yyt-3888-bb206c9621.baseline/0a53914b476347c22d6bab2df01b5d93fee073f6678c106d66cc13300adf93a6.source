   ============================================================ */
(function () {
  const Q = [];
  const q = (id, cat, lv, qText, opts, a, ex) => Q.push({ id, cat, lv, q: qText, opts, a, ex });

  /* —— Linux 与日志 —— */
  q('q801', 'Linux与日志', 1, '查看 SSH 登录成功/失败记录的日志文件是？', ['/var/log/secure 或 auth.log', '/etc/passwd', '/var/log/nginx', '~/.bashrc'], 0, 'CentOS 系在 /var/log/secure，Debian/Ubuntu 系在 /var/log/auth.log。');
  q('q802', 'Linux与日志', 2, '清理日志的行为在 Linux 上留下的痕迹是？', ['无痕迹', 'secure 文件归零但 wtmp/btmp 仍有记录', '自动备份', '内核报错'], 1, '只清单个文件会与其他日志（wtmp/last、journalctl）产生时间与内容矛盾——交叉比对即可识破。');
  q('q803', 'Linux与日志', 2, '排查 SUID 后门文件的命令是？', ['find 全盘搜索 -perm -4000 的文件', 'ls -la /tmp', 'grep suid /etc/passwd', 'chmod 递归 400'], 0, 'find 按权限位全盘搜索 SUID 文件，对照基线清单找异常。');
  q('q804', 'Linux与日志', 2, 'kill 后自动复活的进程，最优先排查？', ['CPU 温度', 'crontab 与 systemd 定时器/服务', '磁盘空间', 'DNS'], 1, '复活说明有拉起机制：cron、systemd service/timer、rc.local、profile 是四大驻留点。');
  q('q805', 'Linux与日志', 2, '命令 ss -antp 中 -p 参数的作用是？', ['显示端口', '显示占用端口的进程', '持久化', '协议'], 1, '-p 显示进程信息，是"外联定位进程"的关键参数。');
  q('q806', 'Linux与日志', 3, '日志集中存储（SIEM 采集）最大的安全价值是？', ['省磁盘', '攻击者无法通过清本机日志灭迹', '界面好看', '加快开机'], 1, '日志实时外发后，本机清日志只是"删副本"，SIEM 侧证据链完好。');
  q('q807', 'Linux与日志', 1, '查看当前所有监听端口的命令是？', ['ss 或 netstat 查看全部 TCP 连接', 'ps aux', 'cat /etc/passwd', 'ifconfig'], 0, 'ss 是 netstat 的现代替代，-a 全部 -t TCP -n 数字 -p 进程。');
  q('q808', 'Linux与日志', 2, '/etc/passwd 中某账号 shell 字段为 /sbin/nologin 说明？', ['该账号可登录', '该账号禁止交互登录', '账号已删除', '账号是管理员'], 1, 'nologin 表示不能交互登录，但可能仍有服务身份——排查时同样要关注。');
  q('q809', 'Linux与日志', 3, '攻击者在 /etc/ld.so.preload 写入恶意库属于？', ['动态库劫持（LD_PRELOAD 类）', 'DNS 劫持', 'ARP 欺骗', '端口扫描'], 0, 'LD_PRELOAD 类 rootkit 让 ps/ls 等命令"隐身"，审计环境变量与 MFT 比对是识别方法。');
  q('q810', 'Linux与日志', 2, 'history 记录被清空（history -c）意味着？', ['正常退出', '可能灭迹，需查其他日志交叉验证', '系统故障', '账号过期'], 1, 'history 只是众多证据之一，auth.log/last/文件时间戳交叉比对才能还原。');

  /* —— Windows 与域 —— */
  q('q811', 'Windows与域', 1, 'Windows 事件 4625 表示？', ['登录成功', '登录失败', '进程创建', '服务安装'], 1, '4625=登录失败，是爆破检测的核心数据源。');
  q('q812', 'Windows与域', 1, 'Windows 事件 4688 表示？', ['新进程创建', '账号创建', '日志清除', '共享访问'], 0, '4688 记录进程创建及命令行（需开启审计），是进程链分析的基础。');
