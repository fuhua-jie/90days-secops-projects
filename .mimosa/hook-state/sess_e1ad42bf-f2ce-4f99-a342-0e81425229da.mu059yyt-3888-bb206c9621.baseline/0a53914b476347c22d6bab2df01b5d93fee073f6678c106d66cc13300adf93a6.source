  q('q833', 'Web安全', 2, '文件上传漏洞最彻底的修复？', ['前端 JS 校验后缀', '白名单+重命名+上传目录禁执行', '限制文件大小', '隐藏上传入口'], 1, '前端校验可绕、扩展名可伪装——"目录不可执行"让上传物永远弹不起来。');
  q('q834', 'Web安全', 2, 'CSRF Token 校验失败的请求应该？', ['直接执行', '拒绝并记录来源', '重定向首页', '返回 200'], 1, '拒绝 + 记录（高频出现说明有扫描器或真实攻击尝试）。');
  q('q835', 'Web安全', 2, '命令注入中常用分号被过滤，还能用哪些"命令连接符"绕过？', ['逻辑与/管道符/URL 编码换行等连接符', '只有分号', '逗号', '引号'], 0, '连接符家族庞大——黑名单永远列不全，白名单校验输入格式才是正解。');
  q('q836', 'Web安全', 2, 'SQL 盲注中"逐字符猜解"依靠的是？', ['报错信息', '构造真假条件的页面/时间差异', '字典', '社工'], 1, 'AND SUBSTR+ASCII 让数据库用"是/否"或"快/慢"传递信息。');
  q('q837', 'Web安全', 1, 'XSS 的 HttpOnly Cookie 属性作用是？', ['加密 Cookie', '禁止 JS 读取该 Cookie', '缩短有效期', '绑定 IP'], 1, 'HttpOnly 让 document.cookie 读不到，XSS 偷会话的收益大减。');
