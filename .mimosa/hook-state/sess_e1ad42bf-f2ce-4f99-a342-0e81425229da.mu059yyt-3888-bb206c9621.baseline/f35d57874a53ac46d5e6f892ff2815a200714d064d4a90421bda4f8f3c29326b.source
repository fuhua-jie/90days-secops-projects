/* ============================================================
   data-glossary2.js — 术语表扩容包 C（+116 条 → 总量 200）
   追加进 GLOSSARY / GLOSSARY_CATS（data-glossary.js 保持原样）
   ============================================================ */
(function () {
  const G = [];
  const g = (t, en, c, d, eg) => G.push({ t, en, c, d, eg });

  /* —— Windows 与域 —— */
  g('Sysmon', 'System Monitor', 'Windows与域', '微软 Sysinternals 的系统监控工具，记录进程创建/网络连接/注册表改动等高级遥测，是 EDR 检测的数据底座。', '部署 SwiftOnSecurity 配置后，PowerShell 混淆命令一览无余。');
  g('LSASS', 'Local Security Authority Subsystem Service', 'Windows与域', 'Windows 认证凭据的"保险柜"进程，攻击者读取它=窃取全部登录凭据。', 'Mimikatz 的经典动作就是读取 LSASS 内存。');
  g('事件 4624 / 4625', 'Logon Event', 'Windows与域', 'Windows 登录成功/失败事件，配合 Logon Type 可还原登录方式（交互/RDP/网络/PTH）。', 'Type 9 = NewCredentials，哈希传递的标志。');
  g('事件 4688', 'Process Creation', 'Windows与域', '进程创建审计事件（含命令行），进程链分析的数据源。', 'WINWORD 拉起 cmd 的宏攻击链在 4688 里一目了然。');
  g('事件 7045', 'Service Install', 'Windows与域', '新服务安装事件，psexec 类横向工具的标志动作。', '内网多台机器先后出现 7045 = 横向移动进行中。');
  g('事件 1102', 'Audit Log Cleared', 'Windows与域', '审计日志被清除事件——出现即最高级别警报（正常系统不会清审计日志）。', '攻击者 wevtutil cl Security 后，1102 本身就是留下的"签名"。');
  g('Mimikatz', '—', 'Windows与域', '最著名的凭据提取工具：读 LSASS、DCSync、黄金票据一把抓。防守方用它验证自己能否被拿下。', 'EDR 对 Mimikatz 的行为特征（摸 LSASS）已全面覆盖。');
  g('哈希传递 PTH', 'Pass-the-Hash', 'Windows与域', '不用明文密码、直接用 NTLM 哈希完成认证的横向手法。', '拿到哈希就能"登录"——所以泄露哈希必须轮换而非只改明文。');
  g('DCSync', '—', 'Windows与域', '假冒域控复制协议向 DC 请求全部账号哈希的攻击。', '事件 4662 带 DSReplicationGetChangesAll 是其指纹。');
  g('黄金票据', 'Golden Ticket', 'Windows与域', '持有 krbtgt 哈希后可给任意账号伪造 10 年有效的 TGT。', '解药：krbtgt 密码重置两次（间隔大于票据寿命）。');
  g('Zerologon', 'CVE-2020-1472', 'Windows与域', 'Netlogon 协议漏洞，可将域控机器密码置空进而接管域。', '修补后仍需重置机器密码与 krbtgt 两次。');
  g('LLMNR / NBNS', 'Link-Local Multicast Name Resolution', 'Windows与域', 'Windows 的本地名称解析协议，可被 Responder 投毒劫持认证哈希。', '组策略禁用 LLMNR/NBNS + 禁 NTLMv2 是标准加固。');
  g('AD CS', 'Active Directory Certificate Services', 'Windows与域', '域证书服务。模板配置不当（如 ESC1）可导致任意身份证书申请=提权。', 'Certipy/Locksmith 是 AD CS 错误配置的审计工具。');
  g('Sysvol', '—', 'Windows与域', '域共享目录，存放组策略。历史遗留的 GPP 密码 XML 就藏在里面。', '定期扫描 SYSVOL 中的 groups.xml 残留。');
  g('Kerberoasting', '—', 'Windows与域', '请求服务账号 TGS 票据并离线破解其密码的攻击。', '服务账号密码必须长而随机，否则一个 SPN 就出卖整个域。');
  g('AS-REP Roasting', '—', 'Windows与域', '针对"关闭 Kerberos 预认证"账号的离线密码破解。', '启用账号预认证+长密码即可免疫。');
  g('GPO', 'Group Policy Object', 'Windows与域', '组策略对象，域内批量下发配置的机制——也可被攻击者用于全域持久化。', '异常 GPO 创建/修改要审计（攻击者的全域投放通道）。');
  g('AppLocker / WDAC', '—', 'Windows与域', 'Windows 的应用白名单机制：只允许"名单内"程序运行，直接废掉大部分恶意载荷。', '白名单模式下 certutil 下载器也会被拦。');
  g('域控 DC', 'Domain Controller', 'Windows与域', '域的大脑：认证、策略、目录全在这。域控失陷=全域失陷。', '域控上任何新服务/新账号都要逐条审计。');
  g('SYSVOL / NETLOGON', '—', 'Windows与域', '域内所有设备同步的共享目录——攻击者可从中翻出脚本与密码残留。', '老脚本里藏着明文密码是常见翻车点。');

  /* —— 云与容器 —— */
  g('AK / SK', 'Access Key / Secret Key', '云与容器', '云 API 的访问密钥对。泄露=把云账号钥匙挂门上。', 'GitHub 泄露 AK 是云上失陷的头号入口。');
  g('ActionTrail / CloudTrail', '—', '云与容器', '云的操作审计日志（记录谁在何时对云做了什么操作），AK 泄露溯源的依据。', '审计日志实时外发，才能回溯泄露 AK 的全部动作。');
  g('CSPM', 'Cloud Security Posture Management', '云与容器', '云安全态势管理：持续巡检安全组/桶权限/加密配置等"配置漂移"。', '公开桶、全开放安全组会被 CSPM 自动抓出来。');
  g('CWPP', 'Cloud Workload Protection Platform', '云与容器', '云工作负载保护：主机/容器/Serverless 的运行时检测与防护。', '云安全中心类产品就是 CWPP。');
  g('IAM', 'Identity and Access Management', '云与容器', '云的身份与访问管理：子账号/角色/策略，云上"最小权限"的载体。', 'RAM 用户只授予必要权限是云上第一原则。');
  g('Bucket 公共读', '—', '云与容器', '对象存储桶权限为"任何人可读"——数据裸奔，重大泄露的头号原因。', '备份桶公共读=把数据库备份挂到公网。');
  g('元数据接口', 'Metadata Service', '云与容器', '云主机内部的 169.254.169.254 服务，可读取实例角色临时凭据——SSRF 的头号目标。', 'SSRF 打元数据→拿到 AK→横向接管云账号。');
  g('容器逃逸', 'Container Escape', '云与容器', '从容器突破到宿主机的攻击：privileged+挂根是最直接路径。', '生产集群默认禁止 privileged 与宿主根挂载。');
  g('K8s RBAC', 'Role-Based Access Control', '云与容器', 'Kubernetes 基于角色的访问控制。配错=开发者能建 cluster-admin 绑定。', 'clusterrolebinding 创建与 pods/exec 必须审计告警。');
  g('镜像签名', 'Image Signing', '云与容器', '对容器镜像做签名验证，防止仓库被投毒或镜像被篡改。', '签名校验 FAIL 的镜像直接拒绝部署。');
  g('Falco', '—', '云与容器', '开源容器运行时检测工具：基于系统调用规则实时告警（容器内下载执行等）。', '容器里 curl 管道执行脚本会被 Falco 当场抓住。');
  g('Serverless', '—', '云与容器', '无服务器架构（函数计算）——攻击者用它做多源代理池，防守方用它做自动化处理。', '护网红队的云函数多源扫描就是 Serverless 滥用。');

  /* —— 攻击术语 —— */
  g('水坑攻击', 'Watering Hole', '攻击术语', '埋伏在目标常访问的网站上，等目标自己"踩进来"。', '行业协会官网被注入跳板脚本，访问的员工陆续中招。');
  g('鱼叉攻击', 'Spear Phishing', '攻击术语', '针对特定人的定向钓鱼：邮件里有你真实的名字、职务、项目——可信度极高。', '"张工，你上周的方案见附件"比群发钓鱼命中率高十倍。');
  g('BEC', 'Business Email Compromise', '攻击术语', '商业邮箱诈骗：仿冒 CEO/供应商骗转账，不碰技术只攻人心。', '仿冒域名+紧急话术+变更收款账户=BEC 三件套。');
  g('供应链攻击', 'Supply Chain Attack', '攻击术语', '从你信任的上游（供应商/更新源/依赖库）下毒。"信任链被滥用"是最难防的一类。', 'SolarWinds 事件：更新包本身带毒，全部客户中招。');
  g('依赖混淆', 'Dependency Confusion', '攻击术语', '在公共仓库抢注企业内部包名的高版本，让构建机自动下载恶意包。', 'postinstall 钩子执行下载脚本是典型手法。');
  g('C2', 'Command and Control', '攻击术语', '远控指挥信道：木马听命令、回传数据的通道。', '阻断 C2 域名/IP，木马就变成聋子。');
  g('Beacon', '—', '攻击术语', 'C2 心跳：等间隔小包回连（带抖动）。等间隔小包是流量检测的经典特征。', '60 秒一次 286 字节的 HTTPS 外联，规律得像钟表。');
  g('Loader / Dropper', '—', '攻击术语', '负责"把真正的恶意软件拉下来并执行"的第一阶段载荷。', '邮件附件是 Loader，跑起来再下载真正的远控。');
  g('RAT', 'Remote Access Trojan', '攻击术语', '远控木马：文件管理/键盘记录/屏幕监控全功能的恶意远控。', '冰蝎/哥斯拉/Gh0st 都是常见 RAT 家族。');
  g('Fileless', '无文件攻击', '攻击术语', '载荷不落盘、只在内存/合法工具里运行——磁盘取证找不到文件。', 'PowerShell 内存执行 + 进程注入是无文件两大流派。');
  g('LOLBAS', 'Living Off the Land Binaries and Scripts', '攻击术语', '系统自带合法工具被滥用：certutil 下载、rundll32 执行、WMI 持久化。', '用系统工具干坏事，白名单和特征检测都会失效。');
  g('鱼叉 vs 水坑', '—', '攻击术语', '鱼叉=主动定向投递（邮件）；水坑=被动埋伏（目标常去的网站）。两者都是定向攻击的入口。', '鱼叉考验话术，水坑考验耐心。');
  g('MFA 轰炸', 'MFA Fatigue', '攻击术语', '拿到密码后疯狂推送 MFA 请求，赌你手滑点"允许"。', '凌晨连续推送 20 次，总有一次误点——Number Matching 是解药。');
  g('Evil Twin', '恶意孪生热点', '攻击术语', '伪造与公司同名的开放 WiFi，设备自动连接后被中间人截获。', '企业 WiFi 用证书认证（WPA2-Enterprise）可免疫。');
  g('BadUSB', '—', '攻击术语', '伪装成键盘的 U 盘：插入即注入按键（下载执行/拷贝数据）。', '外设白名单+USB 只读策略是防御。');
  g('Prompt 注入', 'Prompt Injection', '攻击术语', '把恶意指令藏进 AI 应用的输入数据里，诱导大模型执行——AI 时代的"注入"。', '邮件里藏"忽略以上指令"就能劫持 AI 助手。');

  /* —— 设备工具 —— */
  g('WAF', 'Web Application Firewall', '设备工具', 'Web 应用防火墙：拦 SQL 注入/XSS/扫描等 Web 攻击。规则运营（误报治理）是核心。', '先学习模式两周再切拦截，避免误伤业务。');
  g('NDR', 'Network Detection and Response', '设备工具', '全流量网络检测与响应：覆盖 SMB/LDAP/RDP 等全部协议与东西向流量。', '内网横向在 NDR 的会话分析里无所遁形。');
  g('EDR', 'Endpoint Detection and Response', '设备工具', '终端检测与响应：进程链/文件/网络/注册表全维度监控+远程隔离处置。', 'EDR 隔离是远程可逆动作，应急首选。');
  g('XDR', 'Extended Detection and Response', '设备工具', '扩展检测与响应：把 EDR/NDR/邮件/云的告警关联起来统一检测与响应。', '单点告警串成攻击故事，靠的就是 XDR 关联。');
  g('SOAR', 'Security Orchestration, Automation and Response', '设备工具', '安全编排自动化与响应：把重复处置动作写成剧本让机器执行。', '富化类剧本零风险高收益，处置类必须人在回环。');
  g('UEBA', 'User and Entity Behavior Analytics', '设备工具', '用户与实体行为分析：基于基线发现"合法账号的异常行为"。', '凌晨 3 点导出全库的正常账号会被 UEBA 标红。');
  g('DLP', 'Data Loss Prevention', '设备工具', '数据防泄漏：监控并阻断敏感数据外发（邮件/U 盘/网盘）。', '财务目录被拷贝到 U 盘会触发 DLP 告警。');
  g('蜜罐', 'Honeypot', '设备工具', '诱捕系统：伪装成真实服务引攻击者上钩，捕获样本与行为用于溯源。', '高交互蜜罐能拿到攻击者工具样本——溯源到人的抓手。');
  g('堡垒机', 'Bastion Host', '设备工具', '运维操作的统一入口与录像机：所有命令有审计。', '堡垒机告警：非工作时段登录、批量拉会话、高危命令。');
  g('态势感知', 'Situational Awareness', '设备工具', '安全态势感知平台：多源数据汇聚+可视化+关联分析的安全大屏。', '大屏上的攻击来源地图就是态势感知的经典画面。');
  g('威胁情报平台', 'Threat Intelligence Platform', '设备工具', '聚合多源情报的平台（微步/奇安信 TI/VT），告警富化与 IOC 查询的日常工具。', '研判时查一眼 IP 信誉，是 Tier 1 的标准动作。');
  g('CVSS', 'Common Vulnerability Scoring System', '设备工具', '通用漏洞评分系统（0-10 分）：衡量漏洞基础严重性——但优先级还要加资产与在野利用。', 'CVSS 9.8 的内网低价值主机漏洞，未必比 7.5 的互联网洞紧急。');
  g('KEV', 'Known Exploited Vulnerabilities', '设备工具', 'CISA 的"已被在野利用"漏洞目录——上榜的洞必须最优先处置。', 'KEV 清单是漏管排期的第一依据。');
  g('沙箱', 'Sandbox', '设备工具', '隔离执行可疑文件并记录行为的自动化分析环境。', '邮件附件先进沙箱跑一遍再放行。');

  /* —— 应急响应 —— */
  g('Volatility', '—', '应急响应', '开源内存取证框架：pslist/malfind/netscan/cmdline 等插件还原内存中的攻击现场。', '断电前抓的内存镜像，能用 malfind 直接定位注入进程。');
  g('MFT', 'Master File Table', '应急响应', 'NTFS 主文件表：记录全部文件的创建/修改时间——时间线取证的核心数据源。', '$SI 与 $FN 时间戳不一致=时间戳被篡改。');
  g('超级时间线', 'Super Timeline', '应急响应', '把 MFT/注册表/日志多源证据统一到一条时间轴（plaso/log2timeline）。', '一条时间轴还原攻击者从进入到外泄的完整动作序列。');
  g('黄金镜像', 'Gold Image', '应急响应', '事先做好的"干净系统+标准配置"母盘，应急恢复与合规基线的基准。', '恢复用黄金镜像，比对异常也用黄金镜像做基线。');
  g('IOC', 'Indicator of Compromise', '应急响应', '失陷指标：可机器比对的确凿证据（恶意 IP/域名/哈希）。', 'IOC 有时效性，C2 三天一换——需要持续更新。');
  g('TTP', 'Tactics, Techniques and Procedures', '应急响应', '攻击者的战术/技术/过程——比 IOC 更稳定的"打法指纹"。', 'IOC 三天失效，TTP 层特征可用一年。');
  g('YARA', '—', '应急响应', '恶意样本指纹规则语言：字符串/条件描述家族特征，批量扫文件与内存。', '互斥体名+特征串+编译时间窗三件套起步。');
  g('MTTD', 'Mean Time to Detect', '应急响应', '平均检测时间：从攻击发生到被发现的时长——越短越强。', 'MTTD≤30 分钟是成熟防守队的标准。');
  g('MTTR', 'Mean Time to Respond', '应急响应', '平均响应时间：从发现到完成处置的时长。', 'MTTR≤4 小时为成熟队，≥24 小时为失控。');
  g('PIR', 'Post-Incident Review', '应急响应', '事后复盘：时间线/根因/整改清单/责任到人——把事故变成能力的环节。', '复盘整改项必须有时限与责任人，否则白复盘。');
  g('暴露面收敛', 'Attack Surface Reduction', '应急响应', '关停不必要的互联网暴露：端口/后台/僵尸系统/影子资产。', '护网战前第一件事就是把暴露面砍到最少。');

  /* —— 网络协议 —— */
  g('SMB', 'Server Message Block', '网络协议', 'Windows 文件共享协议（445 端口）。永恒之蓝/勒索传播/哈希抓取的重灾区。', '445 不该出现在互联网，内网也要最小化开放。');
  g('RDP', 'Remote Desktop Protocol', '网络协议', '远程桌面（3389）。裸奔公网的 RDP=爆破第一目标。', 'RDP 必须走 VPN+双因子，绝不直连公网。');
  g('LDAP', 'Lightweight Directory Access Protocol', '网络协议', '域目录查询协议（389/636）。匿名枚举可拉出全部域用户清单。', '禁匿名绑定+枚举频率告警。');
  g('Kerberos', '—', '网络协议', '域认证协议（88 端口）。TGT/TGS 票据体系，黄金/白银票据都在这里做文章。', 'krbtgt 账号是 Kerberos 的根，泄露即全域失陷。');
  g('NTLM', 'NT LAN Manager', '网络协议', '老旧认证协议，支持哈希直通认证（PTH）——微软正在推动全面禁用。', '审计并逐步禁用 NTLM，迁移 Kerberos。');
  g('DoH / DoT', 'DNS over HTTPS/TLS', '网络协议', '加密 DNS。绕过传统 DNS 监控——恶意软件用它隐藏 C2 解析。', '监控 DoH 目标地址与 SNI 是新的检测点。');
  g('QUIC', '—', '网络协议', '基于 UDP 的 HTTP/3 协议——部分检测设备对 UDP 加密流量的可视性不足。', '攻击者开始用 QUIC 藏 C2 流量，流量设备需支持解析。');
  g('mDNS', 'Multicast DNS', '网络协议', '内网多播名称解析（5353）。投毒可实施内网欺骗。', '内网异常 mDNS 应答要关注。');

  /* —— 基础概念 —— */
  g('最小权限', 'Least Privilege', '基础概念', '只授予完成任务所需的最小权限——所有安全设计的地基。', 'DBA 账号也能读写业务库=违反最小权限。');
