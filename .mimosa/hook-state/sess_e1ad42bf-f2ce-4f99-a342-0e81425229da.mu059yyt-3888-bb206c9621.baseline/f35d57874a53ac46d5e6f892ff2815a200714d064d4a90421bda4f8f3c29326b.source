  g('风险评估', 'Risk Assessment', '合规认证', '识别资产→威胁→脆弱性→计算风险→按风险排序处置。', '风险评估不是一次性的，每年至少一轮。');
  g('BCP / DRP', '业务连续性/灾难恢复计划', '合规认证', '业务连续性与灾难恢复计划：RTO/RTO 目标、备份策略、演练频率。', '没有演练过的 BCP 等于没有。');
  g('SOC 2', '—', '合规认证', '面向服务型公司的安全控制审计报告（安全性/可用性/保密性）。', 'SaaS 公司拿企业客户的敲门砖。');
  g('渗透测试报告', 'Pentest Report', '合规认证', '渗透测试的标准产出：范围/方法/发现（含证据）/风险定级/修复建议。', '报告质量的关键是"可重放+可修复"。');
  g('供应链安全评估', '—', '合规认证', '对供应商/外包/开源依赖的安全评估：准入评估+持续监控+退出机制。', 'SolarWinds 之后供应链评估成为采购硬要求。');

  /* —— 收尾补充（凑满 200） —— */
  g('Number Matching', '—', 'Windows与域', 'MFA 推送时要求输入屏幕显示的数字，防"无脑点允许"的疲劳轰炸。', '看到陌生数字就要警觉：不是你发起的验证就拒绝。');
