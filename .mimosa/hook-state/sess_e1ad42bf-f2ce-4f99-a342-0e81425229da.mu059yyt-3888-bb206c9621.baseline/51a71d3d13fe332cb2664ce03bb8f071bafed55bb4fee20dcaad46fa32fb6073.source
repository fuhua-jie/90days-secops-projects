/* ============================================================
   data-quiz3.js — 题库扩容包 D（+100 题：高级/取证/逆向/合规向）
   直接 QUIZ.push(...)
   ============================================================ */
(function () {
  const Q = [];
  const q = (id, cat, lv, qT, opts, a, ex) => Q.push({ id, cat, lv, q: qT, opts, a, ex });

  /* —— SIEM 检测工程 —— */
  q('q1001', '检测工程', 3, 'Sigma 规则中 detection 字段的 condition 写 "selection1 and not selection2" 表示？', ['命中 selection1 但排除 selection2 的日志', '两个条件都要满足', '只看 selection2', '任一命中即可'], 0, 'condition 支持 and/or/not 组合多个 selection，精确控制匹配逻辑。');
  q('q1002', '检测工程', 3, '编写检测规则时 falsepositives 字段的价值？', ['装饰', '为后续调优提供白名单依据', '必填校验', '自动过滤'], 1, 'falsepositives 帮助后续运营阶段精确加白，减少误报。');
  q('q1003', '检测工程', 3, 'Sigma 规则的 level 字段设为 critical 通常意味着？', ['最有把握的规则', '误报最少的规则', '检测到即高危安全事件需立即响应', '最长规则'], 2, 'critical 级规则命中的事件需要立即响应，不是"最有把握"而是"最紧急"。');
  q('q1004', '检测工程', 3, '检测规则覆盖率热力图中一个格子是"有日志但无检测"，优先动作是？', ['关日志', '为该数据源编写检测规则', '删除数据', '不管'], 1, '有日志=有原料，缺的是规则——编写规则是最有杠杆的动作。');
  q('q1005', '检测工程', 3, '紫队演练与红队演练最大的区别？', ['紫队更安全', '红队测攻击能力，紫队测检测能力（验证能否被发现）', '紫队不需要技术', '没有区别'], 1, '紫队 = 红+蓝协作，目标是验证和补齐检测缺口，不是分胜负。');
  q('q1006', '检测工程', 3, '检测规则中"误报治理"的终极目标不是？', ['减少告警噪音', '提高信噪比', '让规则永远零误报', '保证真攻击不被淹没'], 2, '零误报通常意味着零检出——目标是找到信噪比最优平衡点。');
  q('q1007', '检测工程', 3, 'DeTT&CT 工具的主要用途？', ['扫描漏洞', '管理和可视化 ATT&CK 覆盖率数据', '抓包', '逆向工程'], 1, 'DeTT&CT 把日志/检测/可见性数据映射到 ATT&CK 矩阵生成热力图。');
  q('q1008', '检测工程', 3, '编写 Sigma 规则时选择 logsource 的依据？', ['随机选择', '你要检测的日志实际来自哪个数据源', '最流行的产品', '最简写法'], 1, 'logsource 必须与实际采集的日志源匹配，否则规则永远不会命中。');

  /* —— DFIR 取证 —— */
  q('q1009', 'DFIR取证', 3, 'Volatility 的 pslist 和 psscan 插件的主要区别？', ['无区别', 'pslist 读进程链表，psscan 扫描内存找已卸载的隐藏进程', 'pslist 更快', 'psscan 是网络扫描'], 1, 'psscan 能发现直接删除 EPROCESS 结构的 rootkit 隐藏进程。');
  q('q1010', 'DFIR取证', 3, '内存取证中 netscan 插件的价值在于？', ['测网速', '还原包括已断开连接在内的全部网络活动', '扫描漏洞', '配置网络'], 1, '内存中的网络连接即使已断开也可从内存结构中恢复——磁盘日志做不到。');
  q('q1011', 'DFIR取证', 3, '取证分析中"时间线"分析的核心价值？', ['美化报告', '把多源证据交叉定位攻击者的完整动作序列', '节省时间', '自动修复'], 1, 'MFT+注册表+日志+内存的超级时间线是还原攻击链的关键产出。');
  q('q1012', 'DFIR取证', 2, '磁盘镜像的 SHA256 哈希在取证中的作用？', ['加密数据', '证明镜像未被篡改（证据完整性）', '压缩', '分类'], 1, '取证前后各算一次 hash，一致则证明镜像完整——法律证据链要求。');
  q('q1013', 'DFIR取证', 3, '内存中的注册表 hive 与磁盘上的注册表 hive 的区别？', ['内存版包含"最近未刷新到磁盘"的变更和已删除的键', '完全相同', '内存版更小', '磁盘版更准确'], 0, '内存中的 hive 可能包含尚未写盘的恶意修改——只看磁盘会遗漏。');
  q('q1014', 'DFIR取证', 3, '$STANDARD_INFORMATION 与 $FILE_NAME 时间戳不一致说明？', ['磁盘故障', '时间戳被工具篡改（timestomping）', '系统更新', '正常现象'], 1, 'Windows 两个时间属性通常一致，不一致=timestomping（工具如 timestomp 修改了 $SI）。');
  q('q1015', 'DFIR取证', 2, '应急响应中"order of volatility"（易失性顺序）的正确排列？', ['磁盘→内存→网络→CPU', 'CPU/寄存器→内存→网络→磁盘→外接设备', '网络→磁盘→内存', '无所谓'], 1, '越易失越先采：寄存器/CPU 状态 → 内存 → 网络连接 → 磁盘 → 外接介质。');
  q('q1016', 'DFIR取证', 3, 'Windows Prefetch 文件在取证中的价值？', ['加速启动', '记录程序执行历史（即使程序已被删除）', '存密码', '存密钥'], 1, 'Prefetch 记录了程序路径、执行次数和最后运行时间——删除程序不删 Prefetch。');

  /* —— 逆向与恶意软件 —— */
  q('q1017', '逆向分析', 3, '恶意样本"沙箱逃逸"的常见手段？', ['加密自身', '检测虚拟机/沙箱特征后不执行恶意行为', '变大文件', '改图标'], 1, '检测 CPU 核心数/内存/鼠标移动/用户目录文件数——不满足则不触发恶意行为。');
  q('q1018', '逆向分析', 3, '恶意宏文档的典型执行链？', ['双击→Excel 4.0 宏/ VBA→调用 cmd/powershell→下载并执行载荷', '双击→自动加密', '双击→格式化硬盘', '双击→ nothing'], 0, 'Excel 4.0 宏（XLM）比 VBA 更难检测，EXEC 调 cmd 是常见链路。');
  q('q1019', '逆向分析', 2, '加壳与加密的恶意样本为什么难以被杀毒软件检测？', ['文件太大', '静态特征被加密，只有运行时才解密', '签名有效', '文件删除'], 1, '静态分析只能看到加密后的乱码，动态行为分析才能发现恶意行为。');
  q('q1020', '逆向分析', 3, '代码注入（Process Injection）的手法不包括？', ['DLL 注入', 'Process Hollowing', 'APC 注入', '正常文件读写'], 3, 'VirtualAllocEx + WriteProcessMemory + CreateRemoteThread 是经典注入三连。');
  q('q1021', '逆向分析', 2, '分析恶意样本时"字符串"工具的用途？', ['美化代码', '提取 C2 地址/互斥体/注册表路径等 IOC', '压缩文件', '编译'], 1, '字符串是最快速获取 IOC 的方法——域名/IP/文件路径/注册表键值一目了然。');
  q('q1022', '逆向分析', 3, '白加黑（DLL Side-Loading）攻击的原理？', ['白名单工具加载恶意 DLL', '白文件变黑', '黑白棋游戏', '加密解密'], 0, '合法 EXE 因 DLL 搜索顺序优先加载当前目录的恶意同名 DLL。');
  q('q1023', '逆向分析', 3, 'PowerShell 的 Script Block Logging（4104）为什么重要？', ['记录脚本原文（含解码后内容）', '加快脚本', '阻止脚本', '美化输出'], 0, '即使命令是 Base64 编码的，4104 也会记录解码后的实际执行内容。');

  /* —— AD 攻防 —— */
  q('q1024', 'AD攻防', 3, 'BloodHound 工具在域渗透中的作用？', ['杀毒', '用图数据库发现域内最优提权/横向路径', '管理域', '备份域'], 1, 'BloodHound 自动收集域信息并绘制"从普通用户到 Domain Admin"的最短攻击路径。');
  q('q1025', 'AD攻防', 3, 'Silver Ticket 与 Golden Ticket 的区别？', ['银票用服务账号哈希伪造 TGS（只影响单个服务），金票用 krbtgt 哈希伪造 TGT（全域）', '银票更厉害', '没有区别', '银票是银色的'], 0, '金票=全域任意访问（krbtgt），银票=特定服务（服务账号 NTLM）。');
  q('q1026', 'AD攻防', 3, '防御域攻击中"凭据Guard"（Credential Guard）的作用？', ['加密整个硬盘', '用虚拟化安全隔离 LSASS，让 Mimikatz 读不到凭据', '阻止登录', '加速认证'], 1, 'Credential Guard 用 VSM 隔离 LSASS 进程，Mimikatz 读取结果为空。');
  q('q1027', 'AD攻防', 3, '域环境中最有效的横向移动检测方法？', ['查防火墙日志', '监控异常的认证模式（如同一账号短时间在多台主机登录）', '看 CPU', '查 DNS'], 1, '横向移动必然产生"账号跨主机异常登录"——UEBA 和 SIEM 关联分析可检测。');
  q('q1028', 'AD攻防', 2, 'Windows 域环境中"管理员账号用于日常办公"的最大风险？', ['占用内存', '凭据被窃取后攻击者直接获得域管权限', '密码太长', '打字慢'], 1, '域管凭据缓存在工作站的 LSASS 中——钓鱼/转储直接拿域管权限。');
  q('q1029', 'AD攻防', 3, 'DSQuery / Get-ADUser 批量枚举域用户的流量特征？', ['正常查询', '短时间大量 LDAP 查询（端口 389/636）', '只有一条', '全是 443'], 1, 'LDAP 枚举是域侦察（T1018/T1087）的标准动作，频率异常即可告警。');
  q('q1030', 'AD攻防', 3, '防域攻击中"分层管理"（Tiered Administration）的核心？', ['所有人都用域管账号', 'Tier 0 凭据绝不登录 Tier 1/2 设备', '没有分层', '全用同一个密码'], 1, '域管凭据只在域控上使用，不在工作站登录——阻止凭据从低层向高层泄露。');

  /* —— 云安全进阶 —— */
  q('q1031', '云安全进阶', 3, '云上"角色扮演"（Assume Role）攻击的特征？', ['正常操作', '一个身份连续 Assume 多个不相关角色并执行高危操作', '只用一个角色', '没有日志'], 1, '跨角色跳转+高危操作组合 = 凭据泄露后的横向扩展。');
  q('q1032', '云安全进阶', 3, '云上" Living off the Land"指攻击者使用什么？', ['非法工具', '云平台自带的合法功能（如 Run Command/Lambda）执行攻击', '物理设备', 'USB'], 1, '用云平台的合法管理 API 做攻击，日志看起来像正常运维——检测靠行为基线。');
  q('q1033', '云安全进阶', 2, '云上"安全组全开"（0.0.0.0/0）的风险？', ['无风险', '所有端口暴露公网', '网速更快', '自动扩容'], 1, '安全组全开等于没有防火墙——任何云主机都可以被直接访问。');
  q('q1034', '云安全进阶', 3, '云审计日志实时外发到 SIEM 的价值？', ['节省云费用', '云操作事件实时告警（不用手动查控制台）', '美化界面', '减少日志'], 1, '实时外发让 CreateBackdoor/User/Key 等高危操作秒级告警。');
  q('q1035', '云安全进阶', 3, '容器镜像扫描（如 Trivy）扫的是什么？', ['容器大小', '已知 CVE 漏洞 + 恶意软件 + 配置错误', '网络流量', '代码逻辑'], 1, '镜像扫描检查 OS 包/依赖库的 CVE 以及内嵌的密钥/恶意脚本。');
  q('q1036', '云安全进阶', 3, '云 IAM 策略中 "Action: *, Resource: *" 的风险？', ['无风险', '等效于管理员全权限', '只影响性能', '节省配置'], 1, '全通配策略=任何身份都能对任何资源做任何操作——违反最小权限。');

  /* —— 合规与治理进阶 —— */
  q('q1037', '合规治理', 3, '数据出境安全评估的要求适用于？', ['所有数据', '重要数据和个人信息达到一定量级后出境', '只有密码', '只有图片'], 1, '重要数据和个人信息达到门槛后出境需要安全评估申报。');
  q('q1038', '合规治理', 3, 'SOC 2 Type I 与 Type II 的区别？', ['没有区别', 'Type I 证明设计合理，Type II 证明持续有效运行', 'Type II 更便宜', 'Type I 更严格'], 1, 'Type II 需要观察期（通常 3-12 个月）证明控制项持续有效——含金量更高。');
  q('q1039', '合规治理', 3, '等保 2.0 中三级系统的年度测评要求？', ['不测评', '每年至少一次等级测评', '每三年一次', '五年一次'], 1, '三级系统每年至少开展一次等级测评，四级每半年一次。');
  q('q1040', '合规治理', 3, '应急演练的"桌面推演"与"实战演练"的区别？', ['没有区别', '桌面推演靠剧本问答走流程，实战演练在真实/模拟环境中动手', '桌面更贵', '实战更安全'], 1, '桌面推演验证流程与分工，实战演练验证技术能力与工具——两者互补。');
  q('q1041', '合规治理', 3, '合规与安全的正确关系？', ['合规=安全', '合规是安全能力的最低标准（过了测评不等于安全）', '合规不需要', '安全不需要合规'], 1, '合规是"及格线"，真实安全需要在合规基础上持续运营和优化。');
  q('q1042', '合规治理', 3, '向管理层汇报安全事件的最佳时机？', ['等解决完再说', '发现即汇报（含初步评估），后续持续更新', '瞒到最后', '看心情'], 1, '早汇报早决策——"发现即报"比"报喜不报忧"更能建立信任。');
  q('q1043', '合规治理', 3, '数据泄露通知（Breach Notification）的法律时限通常？', ['无限期', '法规通常要求 72 小时内通知监管方', '1 年', '不需要通知'], 1, 'GDPR 要求 72 小时，个保法也有类似时限——超时可能面临额外处罚。');

  /* —— 安全运营进阶 —— */
  q('q1044', '进阶运营', 3, 'SOC 运营中"情报驱动检测"的核心思想？', ['用威胁情报的 IOC/TTP 主动编写和优化检测规则', '把情报当新闻看', '用情报替代所有检测', '情报只用于封锁'], 0, '情报不是只用来封 IP——更高价值是用 TTP 编写新的检测规则覆盖缺口。');
  q('q1045', '进阶运营', 3, '攻击者"反取证"的常见手法不包括？', ['清除日志', '时间戳篡改', '加密恶意载荷', '使用强密码'], 3, '使用强密码不是反取证手法——其他三项都是隐藏痕迹的技术。');
  q('q1046', '进阶运营', 3, '安全运营知识库（Runbook）的核心价值？', ['美观', '把个人经验变成组织能力（新人也能按手册处置）', '占空间', '应付检查'], 1, 'Runbook 让处置不再依赖"老员工记忆"——人员流动不中断能力。');
  q('q1047', '进阶运营', 3, '衡量 SOC 成熟度的框架不包括？', ['SIM3', 'NIST CSF', 'ATT&CK 覆盖率', 'GitHub Star 数'], 3, 'GitHub Star 数与 SOC 成熟度无关——其他三项都是可量化的评估框架。');
  q('q1048', '进阶运营', 3, '安全运营中"单点故障"最常指？', ['防火墙', '唯一懂某个系统的员工离职', '服务器', '网线'], 1, '知识单点故障比设备单点故障更致命——Runbook 和交叉培训是解药。');
  q('q1049', '进阶运营', 2, '内部钓鱼演练发现"全员通过率 95%"后的正确动作？', ['表扬', '针对未通过者做专项培训并记录', '开除', '不管'], 1, '钓鱼演练的目的是教育不是考核——补培训比追责更有效。');
  q('q1050', '进阶运营', 3, '安全运营的价值最终体现在？', ['买了多少设备', '降低了多少业务风险（风险敞口/MTTD/MTTR的趋势）', '发了多少报告', '开了多少会'], 1, '安全不是成本中心——用风险指标的趋势证明"安全投入=业务保护"。');

  /* —— 应急进阶 —— */
  q('q1051', '应急进阶', 3, '应急中"取证镜像"的正确做法？', ['直接复制文件', '整盘位级镜像（dd/E01）+ hash 校验', '截图', '复制几个日志'], 1, '位级镜像保留全部数据（含已删除文件和空闲空间），文件复制会遗漏。');
  q('q1052', '应急进阶', 3, 'Windows 事件日志被清除后，恢复证据的可能来源不包括？', ['SIEM 侧的外发副本', 'USN Journal', '卷影副本', '攻击者的电脑'], 3, '攻击者电脑是"攻势证据"不是你的"守势证据"——其他三项都是本方可恢复的来源。');
  q('q1053', '应急进阶', 3, '应急响应中"Patient Zero"指的是？', ['第一个医生', '最初被入侵的设备/账号', '最后一个受害者', '病毒本身'], 1, '定位 Patient Zero 才能还原完整入侵路径和影响范围。');
  q('q1054', '应急进阶', 3, '勒索事件中"双重勒索"指？', ['收两次赎金', '加密数据 + 威胁公开窃取的数据', '两次加密', '两个团伙'], 1, '先窃取数据再加密——即使有备份也面临数据公开的风险。');
  q('q1055', '应急进阶', 2, '应急响应计划的年度演练频率建议？', ['不需要', '至少每年一次（重要系统每半年）', '每五年', '每十年'], 1, '不演练的应急计划在真实事件中大概率失效——肌肉记忆需要定期训练。');
  q('q1056', '应急进阶', 3, '发现内部员工向竞争对手发送敏感文件，正确处理顺序？', ['直接开除', '固定证据（截图/邮件/日志）→上报管理层→合规介入→按制度处理', '先通知同事', '忽略'], 1, '固定证据是前提——劳动仲裁和法律诉讼都需要完整的证据链。');

  /* —— 渗透测试进阶 —— */
  q('q1057', '渗透进阶', 3, '渗透测试报告中"风险定级"的依据？', ['攻击难度', 'CVSS + 业务影响 + 利用门槛 + 数据价值', '发现顺序', '报告长度'], 1, '风险定级要综合考虑技术严重性和业务影响——同一个漏洞对不同业务价值不同。');
  q('q1058', '渗透进阶', 3, '渗透测试的"范围界定"（Scope）最重要的目的是？', ['增加报价', '明确授权边界，避免测试未授权系统（违法）', '美化报告', '节省时间'], 1, '没有明确授权的测试=非法入侵——范围界定是法律保护的基石。');
  q('q1059', '渗透进阶', 3, '渗透测试报告中的"Executive Summary"面向的读者是？', ['只有技术团队', '管理层/决策者（用业务语言而非技术术语）', '开发者', '没有人'], 1, 'Executive Summary 是给"决策者看的一页纸"——需要用业务风险而非技术细节来写。');
  q('q1060', '渗透进阶', 3, '红队报告中的 "Attack Narrative" 与漏洞列表的区别？', ['没有区别', 'Narrative 讲完整的攻击故事链（从入口到目标），漏洞列表是单点发现', 'Narrative 更短', 'Narrative 只给红队看'], 1, 'Attack Narrative 展示"如果攻击者这样做，会导致什么后果"——比单点漏洞更有说服力。');

  /* —— 安全工具进阶 —— */
  q('q1061', '安全工具', 3, 'Wireshark 中过滤 HTTPS 流量的显示过滤器？', ['https', 'tls.port == 443', 'http.port == 443', 'port 443'], 1, 'HTTPS 流量在 Wireshark 中显示为 TLS 协议，用 tls.port == 443 过滤。');
  q('q1062', '安全工具', 3, 'Wireshark 的 "Follow TCP Stream" 功能的作用？', ['加速网络', '重建完整 TCP 会话内容（请求+响应）', '压缩数据', '检测漏洞'], 1, '将分散的 TCP 包重组为可读的会话——HTTP 请求/响应/凭据一目了然。');
  q('q1063', '安全工具', 3, 'Nmap 的 -sS（SYN Stealth Scan）与 -sT（Connect Scan）的区别？', ['没有区别', '-sS 不完成握手（更隐蔽），-sT 完成完整握手', '-sT 更隐蔽', '-sS 更慢'], 1, '-sS 半开扫描不建立完整连接，多数系统不记录。');
  q('q1064', '安全工具', 3, 'Burp Suite 的 "Match and Replace" 功能用于？', ['美化响应', '自动替换请求/响应中的内容（如去除安全头）', '加速', '截图'], 1, 'Match and Replace 可以自动化修改每个请求——如自动移除 CSP 头测试 XSS。');
  q('q1065', '安全工具', 3, 'Nessus 扫描结果中 "Fatal" 级别的含义？', ['误报', '该漏洞可直接导致远程代码执行且无需认证', '低风险', '已修复'], 1, 'Fatal = 最高风险，通常是无需认证即可远程 RCE 的漏洞。');
  q('q1066', '安全工具', 2, ' sqlmap 的 --level 和 --risk 参数控制？', ['测试深度与侵入性', '输出级别', '日志量', '速度'], 0, 'level 越高测试越多注入点（默认1最高5），risk 越高使用越激进的 Payload。');

  /* —— 密码与认证进阶 —— */
  q('q1067', '密码认证', 3, 'FIDO2 / WebAuthn 相比传统 MFA 的优势？', ['更便宜', '基于公钥加密， phishing-resistant（防钓鱼）', '更方便', '不需要设备'], 1, 'FIDO2 的认证绑定域名（origin-binding），仿冒站点无法触发有效认证。');
  q('q1068', '密码认证', 3, 'Passkey（无密码认证）的原理？', ['更复杂的密码', '公私钥对：私钥存设备，公钥存服务端，服务端只存公钥不可逆', '短信验证码', '指纹数据库'], 1, '服务端只存公钥，即使服务端数据库泄露也无法得到私钥——从根本上消除密码泄露风险。');
  q('q1069', '密码认证', 3, 'Kerberos 的 TGT 与 TGS 的关系？', ['TGT 用 krbtgt 哈希加密，TGS 用服务账号哈希加密', '完全一样', 'TGT 更弱', 'TGS 更强'], 0, 'TGT 向 DC 换取各服务的 TGS——krbtgt 哈希泄露=可伪造任意 TGT（黄金票据）。');
  q('q1070', '密码认证', 3, '密码管理器的"主密码"被泄露的风险？', ['只泄露一个密码', '所有存储的密码全部泄露', '不影响', '只影响弱密码'], 1, '主密码是所有密码的"钥匙"——所以主密码必须 MFA 保护+强密码。');

  /* —— 网络进阶 —— */
  q('q1071', '网络进阶', 3, 'DNS Rebinding 攻击的原理？', ['修改 DNS 服务器', 'TTL 极短使域名先解析为可信 IP 再切换为内网 IP（绕过同源策略）', '劫持 DNS 查询', '加密 DNS'], 1, '第二次解析把域名指向 127.0.0.1 或内网 IP——浏览器同源策略已放行，可访问内网服务。');
  q('q1072', '网络进阶', 3, 'BGP 劫持的原理与影响？', ['修改 DNS', '宣告不属于你的 IP 前缀，把流量重路由到攻击者网络', '端口扫描', '加密流量'], 1, 'BGP 劫持可截获特定 IP 段的流量——通常用于加密货币窃取或流量监控。');
  q('q1073', '网络进阶', 3, 'VPN "Split Tunneling"（分流）的安全风险？', ['无风险', '员工同时连接 VPN 和公共网络，形成内外网桥接', '太慢', '太贵'], 1, '分流的 VPN 允许设备同时访问公司内网和互联网——恶意软件可从公网经设备跳入内网。');

  /* —— Web 进阶 —— */
  q('q1074', 'Web进阶', 3, 'SSRF 的最佳防御不是黑名单 IP 而是？', ['白名单允许访问的域名/IP', '关闭所有出站', '换语言', '限制方法'], 0, '黑名单永远有漏——白名单只允许访问已知安全的目标（如特定 API 域名）。');
  q('q1075', 'Web进阶', 3, '原型污染（Prototype Pollution）攻击的原理？', ['修改 JavaScript 对象的原型链注入属性', 'SQL 注入', 'CSS 注入', 'HTML 注入'], 1, '通过 __proto__ 键修改 Object.prototype 影响所有对象——Node.js 应用常见。');
  q('q1076', 'Web进阶', 3, 'HTTP Request Smuggling 的原理？', ['前端代理和后端服务器对 Content-Length/Transfer-Encoding 边界理解不一致', '暴力破解', '密码攻击', 'DDoS'], 1, '利用两个组件解析 HTTP 请求的差异，"走私"恶意请求绕过前端安全控制。');
  q('q1077', 'Web进阶', 3, 'XSS 中 CSP 的 nonce 用法？', ['每次响应生成随机 nonce，只执行匹配 nonce 的脚本', '加密脚本', '压缩脚本', '删除脚本'], 0, 'nonce 比白名单域名更安全——即使同域被注入也无法执行（因为 nonce 不匹配）。');
  q('q1078', 'Web进阶', 3, 'JWT 的 "alg: none" 攻击原理？', ['算法设为 none 绕过签名验证', '暴力破解密钥', '篡改 payload', '删除签名'], 0, '把 JWT 头部的 alg 改为 "none" 并去掉签名——不检查算法的服务端会直接接受。');

  /* —— 合规进阶 —— */
  q('q1079', '合规进阶', 3, '等保 2.0 中"安全通信网络"的要求不包括？', ['网络架构冗余', '通信传输加密', '边界防护', '全员配备电脑'], 3, '等保要求网络架构/通信传输/边界防护/访问控制——不要求全员配电脑。');
  q('q1080', '合规进阶', 3, '《数据安全法》与《个人信息保护法》的核心区别？', ['没有区别', '数保法管所有数据的处理，个保法只管个人信息的处理', '个保法更严格', '数保法只管政府'], 1, '数保法范围更广（含重要数据/商业数据），个保法专注个人信息的特殊保护。');
  q('q1081', '合规进阶', 3, '安全审计报告中"控制项测试"的常见方法不包括？', ['人员访谈', '配置核查', '抽样重执行', '扫描漏洞'], 3, '漏洞扫描是漏洞管理的工具，不是审计"控制项是否有效"的方法——审计靠访谈/核查/重执行。');
  q('q1082', '合规进阶', 3, 'SOC 2 审计中"Change Management"控制项验证的是？', ['变更是否经过审批和测试', '代码是否漂亮', '服务器是否最新', '网络是否稳定'], 0, '变更管理控制确保"没有未经审批的修改进入生产环境"——供应链安全的基础。');

  /* —— 渗透进阶 —— */
  q('q1083', '渗透进阶', 3, '渗透测试中 "Post-Exploitation" 阶段的目标？', ['拿 shell 就完', '评估影响范围 + 维持访问 + 收集数据 + 留后门（在授权范围内）', '删除日志', '修复漏洞'], 1, 'Post-Exploitation 的目的是评估"如果真实攻击者进来了，能造成多大影响"。');
  q('q1084', '渗透进阶', 3, '红队报告中 "Kill Chain" 展示的价值？', ['装饰', '完整还原从初始访问到目标达成的每一步，证明"如果攻击者这么做，你拦不住"', '增加页数', '吓唬客户'], 1, 'Kill Chain 让管理层直观看到"每一层防御为什么没有拦住"——比漏洞列表更有冲击力。');
  q('q1085', '渗透进阶', 3, '渗透测试中的 "Rules of Engagement"（ROE）不包括？', ['允许测试的 IP 范围', '允许使用的攻击手法', '测试时间段', '可以窃取的数据量'], 3, 'ROE 定义授权范围——包括"可以下载的数据量"是违规的（渗透测试只证明能进入，不窃取数据）。');

  /* —— 安全架构 —— */
  q('q1086', '安全架构', 3, 'Purdue 模型在 OT/ICS 安全中的核心思想？', ['所有设备用同一网络', '分层隔离：IT 网络/DMZ/OT 网络各层严格管控', '全部联网', '不用防火墙'], 1, 'Purdue 模型将工业控制分为多层，每层间严格隔离——IT 侧勒索不应影响 OT 侧管道。');
  q('q1087', '安全架构', 3, '安全架构中 "Assume Breach" 假设的含义？', ['系统一定会被入侵，设计和运营都要以此为前提', '一定会被罚款', '一定会被开除', '一定安全'], 0, 'Assume Breach 是微软等公司的高级安全理念——假设攻击者已经在内网了，你的检测和限制是否有效？');
  q('q1088', '安全架构', 3, '安全架构中 "Defense in Depth" 与 "Single Point of Failure" 的关系？', ['无关', '纵深防御的目的就是消除单点故障', '纵深防御增加单点', '单点更安全'], 1, '多层防御让攻击者必须同时突破所有层——任何一层的缺失都可能是致命的。');
  q('q1089', '安全架构', 3, '安全架构评审中 "Trust Boundary" 的定义？', ['物理防火墙', '数据和指令从"不同信任级别"之间流动的边界', '国界', '公司大门'], 1, '每个 Trust Boundary 都需要安全控制（认证/加密/校验）——没有边界的信任就是漏洞。');
  q('q1090', '安全架构', 3, '安全架构中 "Secure by Default" 的含义？', ['默认开放所有功能', '默认配置就是最安全的（用户不需要额外配置）', '默认关闭所有功能', '默认使用弱密码'], 1, '安全默认值 = 开箱即安全，用户不需要是安全专家也能安全使用。');

  /* —— 安全运营补充 —— */
  q('q1091', '进阶运营', 3, 'SOC 分析师从 Tier 1 晋升到 Tier 2 的核心标志？', ['工作年限', '能独立完成事件调查（不是只做初步分流）', '考试分数', '加班时长'], 1, 'Tier 1 分流 → Tier 2 独立调查与处置——分水岭是"能否独立完成完整调查"。');
  q('q1092', '进阶运营', 3, '安全运营中 "Threat Intel Feedback Loop" 的含义？', ['买更多情报', '检测/响应中发现的新 IOC/TTP 反哺情报库', '循环播放', '无限循环'], 1, '运营中发现的 IOC 应该反馈给情报平台——形成"检测→发现→情报→更好检测"的正循环。');
  q('q1093', '进阶运营', 3, '安全事件分类分级（如 P1-P4）的目的是？', ['好看', '确保资源按影响和紧迫度合理分配', '增加流程', '应付检查'], 1, 'P1 全力响应/P4 例行处理——分级让团队不会在低价值告警上浪费 P1 响应资源。');
  q('q1094', '进阶运营', 3, '安全运营 "Postmortem"（事后复盘）最重要的产出？', ['谁的责任', '可执行的整改清单（每项有责任人和截止日期）', '道歉信', '会议纪要'], 1, '复盘的价值 = 防止同样的事故再演一遍——没有整改项的复盘只是聊天。');
  q('q1095', '进阶运营', 2, '安全运营中 "Single Pane of Glass"（统一面板）的理念？', ['一个界面看所有安全数据', '玻璃面板', '一块屏幕', '只有一个工具'], 0, '统一面板让分析师不需要在 10 个工具之间切换——效率提升的关键。');
  q('q1096', '进阶运营', 3, '安全运营中 "Threat Landscape"（威胁全景）的作用？', ['装饰', '了解当前主要威胁类型，指导防御资源分配', '娱乐', '汇报'], 1, '知道"现在谁在打谁、用什么手法"，才能把资源投在正确的防御方向。');
  q('q1097', '进阶运营', 3, 'SOC "Playbook" 的核心要素不包括？', ['触发条件', '执行步骤', '升级路径', '代码源码'], 3, 'Playbook 是运营文档（触发/步骤/升级），不包含工具源代码——那是开发文档。');
  q('q1098', '进阶运营', 3, '安全运营中 "Table Top Exercise"（桌面推演）的最大价值？', ['省费用', '低成本验证流程与分工，发现预案盲区', '娱乐', '培训新人'], 1, '桌面推演不碰真实环境但能暴露"流程走不通/分工不明确"的问题。');
  q('q1099', '进阶运营', 3, '衡量安全运营团队效率的 "Signal to Noise Ratio" 指的是？', ['信号强度', '真告警与误告警的比例', '音量', '信号塔'], 1, '信噪比越高=每条告警越有价值=分析师效率越高。');
  q('q1100', '进阶运营', 3, '安全运营 "Assume Breach" 实践中的 "Purple Team Feedback Loop" 是？', ['红队攻击后蓝队修复，然后红队再验证修复是否有效——循环直到检测覆盖', '一次演练', '蓝队自我评估', '红队单方面行动'], 0, '紫队反馈循环确保"每一次攻击演练"都产出"新的检测规则"——持续闭环。');

  QUIZ.push(...Q);
})();
