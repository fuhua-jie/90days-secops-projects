  decisions: [
    { q: '收到"更换收款账户"邮件，最可靠的动作是？', opts: [
      { t: '用合同/官网上查到的电话号码回拨供应商核实', ok: true, fb: '✅ 带外核实（Out-of-band）是 BEC 的唯一可靠解药——注意必须用"旧渠道"的号码，而不是邮件里留的。' },
      { t: '回复这封邮件问一下是不是真的', ok: false, fb: '❌ 回复=和攻击者对话，他会继续演。邮箱本身已被冒用，用它核实毫无意义。' },
      { t: '看邮件域名对不对就行，域名对就付款', ok: false, fb: '⚠️ 核对域名是第一步（本例域名仿冒），但即便域名无异常，变更收款账户也必须电话二次核实——流程不能省。' },
