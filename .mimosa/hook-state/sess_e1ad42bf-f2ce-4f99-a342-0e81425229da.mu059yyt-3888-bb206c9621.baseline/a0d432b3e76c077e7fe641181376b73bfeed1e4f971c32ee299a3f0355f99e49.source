      { t: '给所有电脑换最新杀毒', ok: false, fb: '❌ 本案例全程无恶意文件，杀毒全程无感——这就是为什么 BEC 被称为"防不住技术的诈骗"。' },
      { t: '要求财务每天汇报心情', ok: false, fb: '😄 心态可以汇报，但真正防住 180 万的是"双人复核+回拨"。' },
    ]},
