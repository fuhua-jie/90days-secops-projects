  intro: '某制造业公司（化名"宏达制造"）自认为安全投入充足：防火墙、杀毒、UPS 一应俱全。直到那个周一早晨，全厂电脑同时弹出勒索信……本故事根据多起真实勒索事件改编，请你以"事后复盘员"身份走完全程。',
  timeline: [
    { time: '周五 14:20', kind: 'attack', title: 'HR 收到"简历"邮件', desc: '附件《应聘简历.pdf.exe》（系统默认隐藏后缀）。HR 觉得"是个 PDF"，双击。' },
    { time: '周五 14:20:07', kind: 'attack', title: '远控木马上线', desc: '杀毒软件未报（免杀变种）。木马连上境外 C2，攻击者获得内网立足点，开始键盘记录与摸排。' },
    { time: '周五晚 ~ 周日', kind: 'attack', title: '静默潜伏 + 横向移动', desc: '用抓到的域账号凭据，通过 445/RDP 在内网层层跳转，拿下文件服务器与域控，同时摸清备份盘位置。周末无人值班，无人察觉。' },
    { time: '周日 23:40', kind: 'attack', title: '总攻：全盘加密', desc: '删除卷影副本，通过组策略向全网终端分发勒索载荷。生产排程、ERP、共享盘全部加密，弹出勒索信：赎金等值 300 万。' },
    { time: '周一 07:50', kind: 'detect', title: 'IT 接到爆炸式求助', desc: '"我电脑打开全是乱码文件！"——此时距离入侵已过去 65 小时。第一台中毒的 HR 电脑就在角落，还连着网。' },
    { time: '周一 09:00', kind: 'response', title: '混乱的应急处置', desc: '有人主张"重启试试"，有人主张"先交钱"，IT 经理想起来：备份……在三周前被合并进了共享盘（同样被加密）。' },
    { time: '两周后', kind: 'lesson', title: '复盘结论', desc: '初始入侵成本：一封邮件。技术整改 12 项，管理整改 9 项，最贵的一课是"备份没离线"。' },
