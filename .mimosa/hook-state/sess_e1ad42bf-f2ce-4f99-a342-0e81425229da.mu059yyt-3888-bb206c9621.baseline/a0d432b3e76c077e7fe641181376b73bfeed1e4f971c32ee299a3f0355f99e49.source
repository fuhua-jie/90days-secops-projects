  id: 'case3', ico: '📞', title: '"CFO"的一个电话',
  sub: '全程无病毒的诈骗：BEC 商务邮件入侵', tag: '社工诈骗', diff: 1, read: 6,
  intro: '某外贸公司财务小林接到"CFO"的邮件。整个过程没有任何病毒、没有黑客入侵系统、杀毒软件全程静默——但公司还是损失了 180 万。这是最"低成本高回报"的攻击。',
  timeline: [
    { time: '第 1 天', kind: 'attack', title: '情报收集', desc: '攻击者从领英/官网/招标公告摸清公司架构：CFO 姓名、职务、正在进行的海外项目、合作供应商名单——全部公开信息。' },
    { time: '第 1 天', kind: 'attack', title: '仿冒域名上线', desc: '注册 corpf-cfo.com（与真实 corpf.com 只差一个连字符），配好邮箱，甚至买了 TLS 证书。' },
    { time: '第 3 天', kind: 'attack', title: '精准诱饵', desc: '"CFO"邮件：我和国外客户在谈敏感项目，不方便接电话。供应商更换了收款账户，附件是新账户信息，今天下午必须付款否则项目违约。——紧迫+权威+隔离核实渠道，三连招。' },
    { time: '第 3 天 14:00', kind: 'detect', title: '小林起了疑心', desc: '附件"新账户函"是 PDF 无病毒；但小林注意到两件事：这封邮件要求"别打电话确认"，且收款账户在第三国。她没有直接付款。' },
    { time: '第 3 天 14:10', kind: 'response', title: '走流程核实', desc: '按公司制度：大额/变更收款账户必须"合同电话回拨+双人复核"。小林拨合同上供应商的旧号码——对方表示从未变更账户。诈骗被中止。' },
    { time: '第 3 天 15:00', kind: 'lesson', title: '技术毫无用武之地的一课', desc: '整个攻击没有一行恶意代码，杀毒、防火墙、EDR 全部无感。防住它的只有两样东西：流程制度和较真的员工。' },
