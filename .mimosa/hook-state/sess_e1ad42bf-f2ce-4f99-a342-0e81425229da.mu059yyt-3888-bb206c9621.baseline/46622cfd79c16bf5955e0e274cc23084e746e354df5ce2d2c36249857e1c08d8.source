{ id:'q601', cat:'应急响应', lv:1, q:'发现主机感染勒索软件，第一步应该？', opts:['立即关机','断网隔离并保留现场','支付赎金','删除文件'], a:1, ex:'断网防扩散+保证据；关机毁证据、赎金不可控。' },
