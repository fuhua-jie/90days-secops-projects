{ id:'q604', cat:'应急响应', lv:2, q:'Windows 里发现可疑 PowerShell 带大量 -enc 参数，说明？', opts:['正常优化','Base64 混淆执行，高度可疑','日志压缩','调试'], a:1, ex:'-enc 是无文件攻击最爱用的命令混淆手法。' },
{ id:'q605', cat:'应急响应', lv:2, q:'查杀后恶意程序反复出现，最可能的原因？', opts:['杀毒软件旧','持久化入口未清除','网速慢','内存小'], a:1, ex:'计划任务/启动项/公钥等会重新拉起载荷，根除必须拔根。' },
{ id:'q606', cat:'应急响应', lv:3, q:'复盘会的正确姿势是？', opts:['找出责任人处罚','Blameless：追流程根因，整改项责任到人限期闭环','只谈技术','表扬大会'], a:1, ex:'无责文化让信息充分暴露；复盘输出是可跟踪的整改项。' },
