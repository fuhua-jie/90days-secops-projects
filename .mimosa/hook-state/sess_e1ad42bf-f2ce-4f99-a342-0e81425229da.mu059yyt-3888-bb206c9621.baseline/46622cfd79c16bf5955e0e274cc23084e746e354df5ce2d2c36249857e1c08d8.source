{ id:'q202', cat:'网络基础', lv:1, q:'端口可以理解为？', opts:['一台电脑上不同服务的"房间号"','另一台电脑','网线接口','WiFi 密码'], a:0, ex:'IP=门牌号，端口=房间号，6 万多个房间各跑各的服务。' },
{ id:'q203', cat:'网络基础', lv:1, q:'192.168.1.100 这类地址属于？', opts:['公网 IP','内网（私有）IP','MAC 地址','域名'], a:1, ex:'192.168.x.x / 10.x.x.x 是私有内网地址，外网无法直接访问。' },
{ id:'q204', cat:'网络基础', lv:2, q:'HTTPS 相比 HTTP 主要多了？', opts:['速度','传输加密与网站身份验证','颜色','内存'], a:1, ex:'HTTPS=加密+完整性+证书身份。但注意：钓鱼网站也能有自己的 HTTPS。' },
{ id:'q205', cat:'网络基础', lv:2, q:'网站返回 404，含义是？', opts:['成功','没有这个页面','服务器崩溃','需要登录'], a:1, ex:'404=资源不存在。大量 404 说明攻击者在扫路径"画地图"。' },
{ id:'q206', cat:'网络基础', lv:2, q:'日志里登录接口连续上千条 401 后出现一条 200，最该警惕？', opts:['缓存命中','暴力破解可能成功','网络抖动','正常重定向'], a:1, ex:'大量失败后突然成功=爆破成功的经典画像，立刻核查该账号。' },
