{ id:'q102', cat:'安全世界', lv:1, q:'攻击者入侵个人电脑，最常见的动机是？', opts:['欣赏照片','偷账号、组僵尸网络、勒索等牟利','学习技术','测试网速'], a:1, ex:'现代攻击以牟利为核心：卖数据、挖矿、勒索、把你的电脑变成攻击工具。' },
{ id:'q103', cat:'安全世界', lv:1, q:'"0day 漏洞"是指？', opts:['当天修复的漏洞','官方还没有补丁的未知漏洞','第 0 个漏洞','免费漏洞'], a:1, ex:'0day=官方未知/来不及修，无补丁可打，防御方最被动。' },
{ id:'q104', cat:'安全世界', lv:1, q:'勒索软件最典型的行为是？', opts:['加速电脑','加密文件并索要赎金','清理垃圾','优化内存'], a:1, ex:'勒索软件加密你的文件弹出勒索信，所以离线备份是"免死金牌"。' },
{ id:'q105', cat:'安全世界', lv:2, q:'CIA 三元组不包括？', opts:['保密性','完整性','可用性','美观性'], a:3, ex:'CIA=Confidentiality 保密、Integrity 完整、Availability 可用。' },
{ id:'q106', cat:'安全世界', lv:2, q:'商品价格被偷偷从 100 元改成 1 元，破坏的是？', opts:['保密性','完整性','可用性','不可否认性'], a:1, ex:'内容被未授权修改=完整性破坏。' },

