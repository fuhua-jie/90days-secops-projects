{ id:'q301', cat:'攻击手法', lv:1, q:'"暴力破解"密码的原理是？', opts:['物理砸键盘','程序自动尝试大量组合','贿赂管理员','断网'], a:1, ex:'爆破=自动化穷举。对策：长密码+限制尝试次数+两步验证。' },
{ id:'q302', cat:'攻击手法', lv:1, q:'用 A 网站泄露的密码去试 B 网站，叫？', opts:['撞库','备份','同步','爆破'], a:0, ex:'密码复用导致"一泄全泄"，对策是各站密码不同+密码管理器。' },
{ id:'q303', cat:'攻击手法', lv:1, q:'钓鱼邮件最典型的手法是？', opts:['加密邮件','冒充可信方诱导点击/输密码','发送大附件','抄送领导'], a:1, ex:'钓鱼=社会工程学+假页面，攻的是人心不是系统。' },
{ id:'q304', cat:'攻击手法', lv:1, q:'下列哪个密码最安全？', opts:['123456','password2024','我家蓝猫爱吃鱼!2026','qwerty'], a:2, ex:'长口令短语+多样字符最好记也最难破；前两个在所有字典里。' },
{ id:'q305', cat:'攻击手法', lv:2, q:'URL 出现 id=1\' OR \'1\'=\'1，这是？', opts:['XSS','SQL 注入','CSRF','路径穿越'], a:1, ex:'OR 恒真式是 SQL 注入标志，试图绕过条件拖库。' },
{ id:'q306', cat:'攻击手法', lv:2, q:'XSS 攻击的直接受害对象是？', opts:['数据库','浏览被注入页面的其他用户','服务器电源','域名商'], a:1, ex:'XSS 脚本在受害者浏览器里执行，偷其 Cookie/会话。' },
{ id:'q307', cat:'攻击手法', lv:2, q:'file=../../../etc/passwd 属于？', opts:['SQL 注入','路径穿越','SSRF','爆破'], a:1, ex:'../ 上跳目录读取任意文件=路径穿越（目录遍历）。' },
{ id:'q308', cat:'攻击手法', lv:2, q:'Webshell 是什么？', opts:['贝壳','留在服务器上的网页后门','防火墙','压缩包'], a:1, ex:'上传的恶意脚本文件，等于在服务器墙上开了扇自己的门。' },
{ id:'q309', cat:'攻击手法', lv:2, q:'服务器 CPU 长期 95%、外联 3333 端口，最可能？', opts:['业务繁忙','挖矿木马','系统更新','备份任务'], a:1, ex:'高 CPU+矿池端口是挖矿木马标配。' },
{ id:'q310', cat:'攻击手法', lv:2, q:'攻击者攻陷一台内网主机后继续攻下一台，叫？', opts:['横向移动','纵向升级','回滚','持久化'], a:0, ex:'内网"串门"式扩散=横向移动，东西向流量是主战场。' },
{ id:'q311', cat:'攻击手法', lv:3, q:'C2（C&C）服务器的作用是？', opts:['存储备份','攻击者远程指挥中毒主机的中枢','加速网站','日志审计'], a:1, ex:'C2=遥控指挥中心，中毒机器定期回连；掐断 C2 木马即"失聪"。' },
{ id:'q312', cat:'攻击手法', lv:3, q:'攻击者用计划任务保证重启后木马仍运行，属于攻击链哪一步？', opts:['侦察','持久化（驻留）','渗出','影响'], a:1, ex:'让权限长期保留=持久化，"配好备用钥匙"。' },
