    { id: 'skid', name: 'Skid_K1ller（脚本小子）', chain: [0, 1, 2, 3, 7] },
    { id: 'apt', name: 'APT_Ph4ntom（APT 组织）', chain: [0, 1, 2, 3, 4, 5, 6] },
    { id: 'ransom', name: 'LockByte（勒索团伙）', chain: [1, 3, 5, 7] },
    { id: 'bot', name: 'B0tMaster_9（僵尸网络）', chain: [0, 1, 3, 4, 7] },
    { id: 'insider', name: 'Ghost_HR（内鬼）', chain: [6] },
  ];
  const BLUE_NAMES = ['老陈', '小林', 'Ava', '大白', '夜莺', 'Stone', '阿杰', 'Momo', '老K', '小鹿', 'Vince', '南笙', '大熊', 'Lina'];
  const SEGS = [[1800, '最强王者'], [1600, '璀璨钻石'], [1400, '尊贵铂金'], [1200, '荣耀黄金'], [1000, '不屈白银'], [0, '坚韧黄铜']];
  const segName = r0 => (SEGS.find(s => r0 >= s[0]) || SEGS[SEGS.length - 1])[1];
  const TAUNT_BLOCK = ['换跳板了……你的封禁只挡了一会儿。', '此路不通？那再试一次。', 'IP 被封？小事，重新来过。'];
  const TAUNT_MISS = ['得手！继续深入……', '防守形同虚设，加速推进。', '很好，没人注意到。'];

  /* ============================================================
     状态
     ============================================================ */
  let box, inputLine, input;
  let st = null, timer = null;

  function scrollBottom() { box.scrollTop = box.scrollHeight; }
  function print(html, cls = 't-c') {
    const div = document.createElement('div');
    div.className = 'ln ' + cls;
    div.innerHTML = html;
    box.insertBefore(div, inputLine);
    scrollBottom();
  }
  function printRaw(t, cls) { print(esc(t), cls || 't-c'); }
  function feed(html) {
    const el = document.createElement('div');
    el.className = 'feed-item new';
    el.innerHTML = html;
    $('#ctFeed').prepend(el);
    while ($('#ctFeed').children.length > 60) $('#ctFeed').lastChild.remove();
  }
  function fmtClock(s) { const m = Math.floor(s / 60); return String(m).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); }
  function board() {
    const rows = [{ name: '蓝队·你（你）', score: st.me, me: true },
      ...st.mates.map(b => ({ name: '蓝队·' + b.name, score: b.score })),
      ...st.red.map(x => ({ name: x.name + '〔' + ACC[x.access] + '〕', score: x.score, red: true }))];
    rows.sort((a, b) => b.score - a.score);
    $('#ctBoard').innerHTML = rows.map((x, i) => `
      <div class="lb-row ${x.me ? 'me' : ''} ${x.red ? 'red' : ''}">
        <span class="lb-rank">${i + 1}</span>
        <span class="lb-name">${esc(x.name)}</span>
        <span class="lb-score">${x.score}</span>
      </div>`).join('');
  }
  function meters() {
    $('#ctBiz').textContent = Math.max(0, st.biz);
    $('#ctData').textContent = Math.max(0, st.data);
    $('#ctMy').textContent = st.me;
    $('#ctRed').textContent = st.red.reduce((s, x) => s + x.score, 0);
    $('#ctActive').textContent = activeCount();
    $('#ctStopped').textContent = st.stopped;
  }
  function activeCount() { return st.attacks.filter(x => x.state === 'active').length; }
  function activeOnMe() { return st.attacks.filter(x => x.state === 'active' && x.target === 'you'); }
  function activeOnMates() { return st.attacks.filter(x => x.state === 'active' && x.target !== 'you'); }

  /* ============================================================
     比赛构建
     ============================================================ */
  function start() {
    st = {
      t: 0, total: 30 * 60,
      biz: 100, data: 100,
      me: 0, stopped: 0, missed: 0, assists: 0, log: [],
      red: RED.map(x => ({ ...x, score: 0, step: 0, access: 0, ip: rip() })),
      mates: BLUE_NAMES.map((n, i) => ({ name: n, skill: 0.38 + ((i * 37) % 50) / 100, score: 0, cdUntil: 0 })),
      attacks: [], aid: 0,
      nextSpawn: 12 + r(10),      // 首波 12-22s
      lastResolve: 0,
      console: null,              // 当前在终端上的攻击（你或 assist 接管）
      resolved: true,
    };
    $('#ctfStart').style.display = 'none';
    $('#ctfConsole').style.display = 'block';
    $('#ctFeed').innerHTML = '';
    board(); meters();
    feed('🏁 比赛开始！蓝队 15 人 vs 红队 5 人。30 分钟内红队会持续进攻多名队友——盯紧你的终端与左侧战况。');
    printRaw('战场接入完成。你将随机遭受攻击（5 分钟防御窗口）。输入 help 查看手册，输入 assist 可接管队友被攻击事件。', 't-w');
    setTimeout(nextConsole, 1200);
  }

  /* ============================================================
     主循环（1s tick）
     ============================================================ */
  function tick() {
    st.t++;
    $('#ctClock').textContent = fmtClock(st.t);
    $('#ctRemain').textContent = fmtClock(Math.max(0, st.total - st.t));

    // 1) 你终端上的攻击：窗口倒计时 + 超时判定（5 分钟）
    if (st.console && st.console.state === 'active') {
      var left = st.console.deadline - st.t;
      var el = document.getElementById('ctTimer');
      if (el) {
        el.textContent = Math.max(0, left) + 's';
        el.style.color = left > 60 ? 'var(--tx2)' : left > 20 ? 'var(--am)' : 'var(--ro)';
      }
      var bar = document.getElementById('ctTimerBar');
      if (bar) { bar.style.width = Math.max(0, left / 300 * 100) + '%'; bar.style.background = left > 60 ? 'var(--grad)' : left > 20 ? '#fbbf24' : '#fb7185'; }
      if (left <= 0) failAttack(st.console, '5 分钟防御窗口超时');
    }

    // 2) 队友被攻击：AI 自动结算（技能 roll）
    st.attacks.forEach(x => {
      if (x.state !== 'active' || x.target === 'you' || x.assist) return;
      if (st.t >= x.aiResolveAt) {
        var mate = x.target.mate;
        if (Math.random() < mate.skill) {
          x.state = 'resolved'; mate.score += 12; mate.cdUntil = st.t + 60 + r(60);
          feed(`🛡️ ${esc(mate.name)} 防住了 <b>${esc(x.atk.n)}</b>（红队 0 分）· ${esc(x.redName)} +0`);
          x.redMember.cdUntil = st.t + 30 + r(30);
        } else {
          resolveMiss(x, null);
        }
      }
    });

    // 3) 队友被攻击事件滞留过久没人管 → 你可以 assist（提示一次）
    var pend = activeOnMates().filter(x => !x.assistHinted && st.t - x.born > 25);
    pend.forEach(x => { x.assistHinted = true; printRaw(`📡 ${esc(x.target.mate.name)} 正被【${esc(x.atk.n)}】攻击且尚未解决——输 assist 接管协防（+15）。`, 't-i'); });

    // 4) 红队新攻击
    if (st.t >= st.nextSpawn) {
      st.nextSpawn = st.t + 15 + r(16); // 15-30s 一波
      spawnAttack();
    }

    // 5) 比赛结束
    if (st.t >= st.total) return end();
    if (st.biz <= 0 && st.data <= 0) return end(true);
  }

  /* ---------- 红队发起攻击 ---------- */
  function spawnAttack() {
    var mem = st.red[r(st.red.length)];
    var stage = mem.chain[Math.min(mem.step, mem.chain.length - 1)];
    var pool = A.filter(a => a.st === stage && a.pf.includes(mem.id));
    if (!pool.length) pool = A.filter(a => a.st <= stage && a.pf.includes(mem.id));
    if (!pool.length) pool = A.filter(a => a.st === 1);
    var atk = pick(pool);
    mem.step++;

    // 目标选择：你 30%（空闲时），其余 14 名队友
    var freeMates = st.mates.filter(m => st.t >= m.cdUntil && !st.attacks.some(x => x.state === 'active' && x.target.mate === m));
    var youFree = !activeOnMe().length && st.t >= (st.youCd || 0);
    var targetMate = null;
    if (youFree && Math.random() < 0.32) targetMate = null;
    else {
      if (!freeMates.length) return; // 全员忙，红队观望
      targetMate = pick(freeMates);
    }

    var c = { ip: mem.ip, host: targetMate ? rhost() : rhost(), user: ruser(), dom: rdom() };
    var wv = atk.g(c);
    var aid = ++st.aid;
    var atkInst = {
      id: aid, atk: atk, mem: mem, redName: mem.name.split('（')[0],
      ctx: c, wave: wv, need: wv.need.map(x => x.slice()),
      target: targetMate ? { mate: targetMate } : 'you',
      born: st.t, deadline: st.t + 300,
      state: 'active', assist: false, assistHinted: false,
      aiResolveAt: targetMate ? st.t + 45 + r(45) : 0,
    };
    st.attacks.push(atkInst);

    if (targetMate) {
      feed(`🔴 <b>[A${String(aid).padStart(2, '0')}]</b> ${esc(mem.name)} 攻击 ${esc(targetMate.name)}：<b>${esc(atk.n)}</b>（输 assist A${String(aid).padStart(2, '0')} 接管）`);
    } else {
      pushConsole(atkInst);
      feed(`🔴 <b>[A${String(aid).padStart(2, '0')}]</b> 你的主机遭到 <b>${esc(atk.n)}</b>！5 分钟防御窗口开始`);
    }
    mem.cdUntil = 0;
  }

  /* ---------- 你的终端 ---------- */
  function pushConsole(x) {
    st.console = x;
    st.resolved = false;
    $('#ctWaveSrc').textContent = '⚠ 你的主机';
    $('#ctWaveSrc').className = 'src-badge src-SIEM';
    $('#ctWaveTitle').textContent = `[A${String(x.id).padStart(2, '0')}] ${x.atk.n}`;
    $('#ctWaveTarget').textContent = `目标：你的主机 · 防御窗口至 ${fmtClock(x.deadline)}`;
    $('#ctTelemetry').innerHTML = x.wave.tel.map(e => '· ' + esc(e)).join('<br>');
    $('#ctVerdict').innerHTML = '';
    printRaw(`── 🚨 你的主机遭到【${x.atk.n}】！防御窗口 5 分钟 ──`, 't-r');
    input.focus({ preventScroll: true });
  }
  function consoleStandby() {
    st.console = null;
    $('#ctWaveSrc').textContent = '监控台';
    $('#ctWaveSrc').className = 'src-badge src-NDR';
    $('#ctWaveTitle').textContent = '监视中';
    $('#ctWaveTarget').textContent = '';
    $('#ctTelemetry').innerHTML = '等待下一波攻击……<br> teammate 被攻击事件会实时出现在左侧战况，可随时 assist 接管。';
    $('#ctVerdict').innerHTML = '';
  }

  function nextConsole() {
    // 从队列取最早截止的你方攻击
    var q = activeOnMe().sort((a, b) => a.deadline - b.deadline);
    if (q.length) pushConsole(q[0]);
    else consoleStandby();
  }

  /* ---------- 判定 ---------- */
  function resolveSuccess(x, byAssist) {
    x.state = 'resolved';
    clearInterval(timer === null ? null : timer);
    if (x.target === 'you') {
      st.me += 15; st.stopped++;
      feed(`🛡️ 蓝队·你 防住 <b>[A${String(x.id).padStart(2, '0')}] ${esc(x.atk.n)}</b> +15`);
    } else {
      var mate = x.target.mate;
      st.me += 15; st.assists++; mate.score += 5;
      feed(`🤝 蓝队·你 接管协防成功 <b>${esc(x.atk.n)}</b> +15（${esc(mate.name)} +5）`);
    }
    printRaw('✅ 防御成功！+15。', 't-g');
    printRaw('📚 ' + x.atk.teach, 't-w');
    x.redMember.cdUntil = st.t + 60 + r(60);
    if (x.target === 'you') { st.youCd = st.t + 45 + r(45); nextConsole(); }
    board(); meters();
  }
  function failAttack(x, reason) {
    if (x.state !== 'active') return;
    x.state = 'missed';
    var mem = x.mem;
    mem.score += 15; applyDmg(x.atk);
    mem.cdUntil = st.t + 60 + r(60);
    if (x.target === 'you') { st.youCd = st.t + 45 + r(45); st.missed++; }
    feed(`💀 <b>[A${String(x.id).padStart(2, '0')}]</b> ${esc(x.redName)} 攻击得手（${esc(x.atk.n)}）—— 蓝队 0 分，业务/数据受损`);
    printRaw(`❌ [A${String(x.id).padStart(2, '0')}] 攻击得手：${x.atk.n}。`, 't-r');
    printRaw('📚 正确处置：' + x.need.map(y => y[0] + ' ' + y[1]).join(' 且 ') + ' —— ' + x.atk.teach, 't-w');
    if (x.target === 'you') { st.console = null; nextConsole(); }
    board(); meters();
  }
  function applyDmg(a) {
    st.biz = Math.max(0, st.biz - (a.dmg.biz || 0));
    st.data = Math.max(0, st.data - (a.dmg.data || 0));
    meters();
  }

  /* ---------- 命令 ---------- */
  function norm(s) { return String(s).toLowerCase().trim().replace(/\s+/g, ' '); }
  function argMatch(typed, key) {
    const u = norm(typed), k = norm(key);
    if (!u || !k) return false;
    return u === k || u.includes(k) || k.includes(u);
  }

  function run(raw) {
    const cmd = raw.trim();
    if (!cmd) return;
    print(`<span class="t-p">blue@awd:~$</span> ${esc(cmd)}`, '');
    const verb = cmd.split(/\s+/)[0].toLowerCase();
    const arg = cmd.slice(verb.length).trim();

    if (verb === 'help') return showHelp();
    if (verb === 'status') {
      printRaw(`时间 ${fmtClock(st.t)}/${fmtClock(st.total)} · 业务 ${st.biz}/100 · 数据 ${st.data}/100 · 我的得分 ${st.me} · 协防 ${st.assists} · 失守 ${st.missed}`);
      activeOnMe().length && printRaw(`⚠ 你的主机有 ${activeOnMe().length} 起未解决攻击！`, 't-r');
      activeOnMates().forEach(x => printRaw(`  [A${String(x.id).padStart(2, '0')}] ${x.target.mate.name} ← ${x.atk.n}（${esc(x.redName)}）`, 't-w'));
      return;
    }
    if (verb === 'assist') {
      var pend = activeOnMates().filter(x => !x.assist);
      if (!pend.length) { printRaw('assist: 当前没有可接管的队友攻击事件。', 't-w'); return; }
      if (st.console && st.console.state === 'active') { printRaw('assist: 你的终端已有进行中的防御，先解决它。', 't-w'); return; }
      var x = arg ? pend.find(y => String(y.id) === arg.replace(/^a/i, '')) || pend.find(y => norm(arg) === norm(y.target.mate.name)) : pend[0];
      if (!x) { printRaw('assist: 编号无效。可用：' + pend.map(y => 'A' + y.id).join('、'), 't-r'); return; }
      x.assist = true; x.target = 'you'; x.deadline = Math.max(x.deadline, st.t + 240);
      pushConsole(x);
      printRaw(`🤝 已接管 [A${String(x.id).padStart(2, '0')}] ${x.atk.n} —— 防御窗口剩余 ${x.deadline - st.t}s。`, 't-i');
      return;
    }
    if (!['block', 'isolate', 'kill', 'rm', 'disable', 'passwd', 'patch', 'hunt', 'restore', 'ignore'].includes(verb)) {
      printRaw(`bash: ${verb}: 未知的防御命令（输 help 查看手册）`, 't-r'); return;
    }
    if (!st.console || st.console.state !== 'active') { printRaw('当前没有待处置目标，等待下一波……', 't-w'); return; }

    var x = st.console;
    if (x.benign) {
      if (verb === 'ignore') return resolveBenign(x);
      return resolveMisop(x, `❌ 误伤业务！这其实是【${x.benign.n}】——${x.benign.teach}`);
    }
    var a = x.atk, need = x.need;

    if (verb === 'ignore') {
      var ign = need.findIndex(y => y[0] === 'ignore');
      if (ign > -1) { need.splice(ign, 1); return resolveSuccess(x, false); }
      return failAttack(x, '你选择忽略——攻击得逞了');
    }

    var idx = need.findIndex(y => y[0] === verb && (y[1] === '' ? !arg : argMatch(arg, y[1])));
    if (idx === -1) { printRaw('命令已执行，但目标与当前威胁不符（无害操作，浪费了时间）。仔细看遥测里的 IP/主机/文件名。', 't-w'); return; }
    need.splice(idx, 1);
    if (need.length) { printRaw(`✓ 动作生效（还差 ${need.length} 步：${need.map(y => y[0] + ' ' + y[1]).join(' / ')}）`, 't-g'); return; }
    resolveSuccess(x, x.assist);
  }

  function resolveBenign(x) {
    x.state = 'resolved';
    st.me += 8;
    feed('✅ 蓝队·你 正确放行正常业务 +8');
    printRaw('✅ 判定正确：正常业务放行（+8）。' + x.benign.teach, 't-g');
    nextConsole();
  }
  function resolveMisop(x, msg) {
    x.state = 'resolved';
    st.me = Math.max(0, st.me - 8); st.misop++;
    st.biz = Math.max(0, st.biz - 10);
    feed('⚠️ 蓝队·你 误伤正常业务 -8（业务可用性 -10）');
    printRaw(msg, 't-r');
    printRaw('⚠️ 误处置正常业务：业务可用性 -10，你的得分 -8。', 't-r');
    nextConsole();
  }

  function showHelp() {
    [['block <IP/域名>', '防火墙封禁来源'], ['isolate <主机>', '断网隔离主机'], ['kill <进程>', '终止恶意进程'],
     ['rm <文件/任务/公钥/服务>', '删除恶意落地物'], ['disable <账号>', '禁用可疑账号'], ['passwd <账号>', '重置凭据'],
     ['patch <组件>', '修复/升级组件'], ['hunt', '主动狩猎：全网回溯 IOC'], ['restore <备份>', '从备份恢复'],
     ['assist [A编号]', '接管队友被攻击事件协防'], ['ignore', '正常业务放行'], ['status', '当前态势']]
      .forEach(r0 => print(`  <span class="t-p">${esc(r0[0])}</span><span style="color:var(--tx3)"> — ${esc(r0[1])}</span>`));
  }

  /* ---------- 侧栏 / 面板 ---------- */
  function updateTop() {
    $('#ctClock').textContent = fmtClock(st.t);
    $('#ctRemain').textContent = fmtClock(Math.max(0, st.total - st.t));
    meters();
  }
  function meters() {
    $('#ctBiz').textContent = Math.max(0, st.biz);
    $('#ctData').textContent = Math.max(0, st.data);
    $('#ctMy').textContent = st.me;
    $('#ctRed').textContent = st.red.reduce((s, x) => s + x.score, 0);
    $('#ctActive').textContent = activeCount();
    $('#ctStopped').textContent = st.stopped;
  }
  function board() {
    const rows = [{ name: '蓝队·你（你）', score: st.me, me: true },
      ...st.mates.map(b => ({ name: '蓝队·' + b.name, score: b.score })),
      ...st.red.map(x => ({ name: x.name + '〔' + ACC[x.access] + '〕', score: x.score, red: true }))];
    rows.sort((a, b) => b.score - a.score);
    $('#ctBoard').innerHTML = rows.map((x, i) => `
      <div class="lb-row ${x.me ? 'me' : ''} ${x.red ? 'red' : ''}">
        <span class="lb-rank">${i + 1}</span>
        <span class="lb-name">${esc(x.name)}</span>
        <span class="lb-score">${x.score}</span>
      </div>`).join('');
  }

  /* ---------- 结算与排位 ---------- */
  function end(beat) {
    clearInterval(timer);
    $('#ctfConsole').style.display = 'none';
    var rep = $('#ctfReport');
    rep.style.display = 'block';
    var blueSum = st.me + st.mates.reduce(function (s, b) { return s + b.score; }, 0);
    var redSum = st.red.reduce(function (s, x) { return s + x.score; }, 0);
    var win = blueSum >= redSum && st.biz > 0;
    var rating = parseInt(localStorage.getItem('ctf_rating') || '1000', 10);
    var delta = Math.max(-30, Math.min(40, (win ? 20 : -15) + st.me / 5 - st.missed * 2 - st.misop * 2));
    var newRating = Math.max(800, Math.round(rating + delta));
    localStorage.setItem('ctf_rating', String(newRating));
    if (win) localStorage.setItem('ctf_w', (+localStorage.getItem('ctf_w') || 0) + 1);
    else localStorage.setItem('ctf_l', (+localStorage.getItem('ctf_l') || 0) + 1);

    var rows = [{ name: '蓝队·你（你）', score: st.me, me: true }]
      .concat(st.mates.map(function (b) { return { name: '蓝队·' + b.name, score: b.score }; }))
      .concat(st.red.map(function (x) { return { name: x.name + '〔' + ACC[x.access] + '〕', score: x.score, red: true }; }))
      .sort(function (a, b) { return b.score - a.score; });
    var myRank = 1; rows.forEach(function (x, i) { if (x.me) myRank = i + 1; });

    Progress.recordGame('ctf', win ? 'W' : 'L');
    Progress.addXP(Math.round(st.me / 3) + (win ? 30 : 10), 'CTF 攻防排位');
    if (window.App) App.confetti(win ? 90 : 40);

    var rep = $('#ctfReport');
    var html = '<div class="card game-over">' +
      '<div class="go-ico">' + (win ? '🏆' : '🛡️') + '</div>' +
      '<h3>' + (win ? '蓝队胜利！' : '红队占据上风') + '</h3>' +
      '<p>蓝队总分 <b style="color:var(--cy)">' + blueSum + '</b> vs 红队总分 <b style="color:var(--ro)">' + redSum + '</b> · 你的排名 <b style="color:var(--am)">第 ' + myRank + ' 名 / 20</b></p>' +
      '<div class="report-grid">' +
      '<div class="rg"><b>' + st.me + '</b><span>我的得分</span></div>' +
      '<div class="rg"><b>' + st.stopped + '</b><span>成功防御</span></div>' +
      '<div class="rg"><b>' + st.missed + '</b><span>失守次数</span></div>' +
      '<div class="rg"><b>' + st.assists + '</b><span>协防次数</span></div>' +
      '</div>' +
      '<div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:10px 0 16px">' +
      '<span class="tag am">排位分 ' + rating + ' → <b>' + newRating + '</b>（' + (delta >= 0 ? '+' : '') + delta + '）</span>' +
      '<span class="tag vi">段位：' + segName(newRating) + '</span>' +
      '<span class="tag">战绩 ' + localStorage.getItem('ctf_w') + ' 胜 ' + localStorage.getItem('ctf_l') + ' 负</span>' +
      '</div>' +
      '<div class="card" style="text-align:left;padding:14px 18px;margin:14px 0">' +
      '<h4 style="font-size:14px;font-weight:800;margin-bottom:10px">🏆 最终排名（20 名按积分）</h4>';
    rows.sort(function (a, b) { return b.score - a.score; }).forEach(function (x, i) {
      html += '<div style="display:flex;gap:10px;padding:5px 8px;border-radius:8px;' + (x.me ? 'background:rgba(34,211,238,.1)' : '') + ';' + (x.red ? 'color:var(--ro)' : '') + '">' +
        '<span style="font-family:var(--m);width:34px">' + (i + 1) + '</span>' +
        '<span style="flex:1;font-size:13.5px">' + esc(x.name) + (x.me ? ' ←你' : '') + '</span>' +
        '<b style="font-family:var(--m);font-size:13.5px">' + x.score + '</b></div>';
    });
    html += '</div>';
    if (st.log.length) {
      html += '<div style="text-align:left;margin:14px 0"><h4 style="font-size:14px;font-weight:800;margin-bottom:10px">📝 你的失守回合复盘</h4>';
      st.log.forEach(function (m0) {
        html += '<div class="card" style="padding:12px 16px;margin-bottom:9px;text-align:left"><b style="font-size:13.5px">' + esc(m0.n) + '</b>' +
          '<div style="font-size:12.5px;color:var(--tx2);line-height:1.8">正确处置：' + esc(m0.need) + '<br>💡 ' + esc(m0.teach) + '</div></div>';
      });
      html += '</div>';
    } else {
      html += '<p style="color:var(--gr);font-weight:700;margin:14px 0">全程零失守——铜墙铁壁！</p>';
    }
    html += '<div style="display:flex;gap:12px;justify-content:center;margin-top:16px">' +
      '<button class="btn btn-primary" onclick="location.reload()">⚔️ 再打一局（全新随机）</button>' +
      '<a class="btn btn-ghost" href="games.html">返回游戏中心</a></div></div>';
    rep.innerHTML = html;
    if (window.App) App.toast('排位 ' + (delta >= 0 ? '+' : '') + delta + ' · ' + segName(newRating), '⚔️', true);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ---------- 输入 ---------- */
  function buildInput() {
    inputLine = box.querySelector('.ln-in');
    input = box.querySelector('.term-input');
    input.addEventListener('keydown', e => { if (e.key === 'Enter') { const v = input.value; input.value = ''; run(v); } });
    $('#ctSend').addEventListener('click', () => { const v = input.value; input.value = ''; run(v); });
    box.addEventListener('click', () => { if (input && !(st && st.console && st.console.state === 'resolved')) input.focus({ preventScroll: true }); });
  }

  /* ---------- 启动 ---------- */
  document.addEventListener('DOMContentLoaded', () => {
    box = document.getElementById('ctTerm');
    if (!box) return;
    buildInput();
    inputLine.style.visibility = 'hidden';
    if (location.hash.includes('demo')) window.__ctfEnd = function () { end(false); };
    var rating = parseInt(localStorage.getItem('ctf_rating') || '1000', 10);
    $('#segTag').textContent = '段位：' + segName(rating);
    $('#ratingNow').textContent = rating;
    $('#recTag').textContent = '战绩 ' + (localStorage.getItem('ctf_w') || 0) + ' 胜 ' + (localStorage.getItem('ctf_l') || 0) + ' 负';
    $('#startBtn').onclick = function () {
      inputLine.style.visibility = 'visible';
      start();
    };
  });
})();
