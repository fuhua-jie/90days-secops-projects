/* ============================================================
   ctf.js v5 — CTF 蓝队攻防排位赛（30 分钟实时 AWD）
   · 蓝队 15 人（你 + 14 AI） vs 红队 5 攻击手
   · 红队全程随机攻击多名蓝队；同一成员在攻击解决前不会再被攻击
   · 你被攻击时有 5 分钟防御窗口；防住 +15，超时 0 分（红队拿分）
   · resolve 后成员进入 60-120s 休整（防住后 1-2 分钟休息）
   · assist 接管队友被攻击事件协防：成功 你+15 队友+5
   · 攻击库 29 类（gen 随机遥测），need 参数均为遥测真实值
   ============================================================ */
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const r = n => Math.floor(Math.random() * n);
  const pick = a => a[r(a.length)];
  const shuffle = a => a.map(x => [Math.random(), x]).sort((p, q) => p[0] - q[0]).map(x => x[1]);
  const rip = () => pick(['45.83.66.', '185.220.101.', '91.243.72.', '103.75.190.', '196.52.43.', '89.248.167.']) + (1 + r(254));
  const ruser = () => pick(['zhangwei', 'lisi', 'wangfang', 'hr02', 'ops01', 'svc_backup']);
  const rhost = () => pick(['WEB-03', 'APP-11', 'OA-02', 'DEV-04', 'GIT-02']);
  const rdom = () => pick(['evil-cdn.net', 'update-svc.xyz', 'log-collect.icu', 'paste-log.icu', 'cdn-metrics.top']);
  const ACC = ['未得手', '已获立足点', '用户权限', '管理员权限'];

  /* ============================================================
     攻击库（与排位规则同步：need 均为遥测真实值）
     ============================================================ */
