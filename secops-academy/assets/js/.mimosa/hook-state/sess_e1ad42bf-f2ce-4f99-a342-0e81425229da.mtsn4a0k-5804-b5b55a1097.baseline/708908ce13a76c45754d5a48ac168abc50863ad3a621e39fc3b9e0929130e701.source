(function () {
  const $ = s => document.querySelector(s);
  const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  /* ---------- 随机场景字段 ---------- */
  const r = n => Math.floor(Math.random() * n);
  const pick = a => a[r(a.length)];
  const rip = () => pick([45, 103, 185, 91, 203, 198, 192]) + '.' + r(255) + '.' + r(255) + '.' + (1 + r(254));
  const ripC = () => '10.1.' + r(6) + '.' + (2 + r(248));
  const rhost = () => pick(['FIN-02', 'APP-11', 'WEB-03', 'DB-01', 'HR-PC-07', 'DEV-04', 'OA-02', 'FILE-01', 'GIT-02']);
