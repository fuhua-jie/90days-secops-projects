        { t: '立即终止会话 + 冻结账号 + 更换为数字匹配 MFA', q: 'best', f: '✅ 会话是攻击者此刻的立足点，撤销会话比改密码更急。' },
        { t: '教育用户别乱点', q: 'bad', f: '❌ 深夜 47 推轰炸，圣人也难免手滑——这是设计问题不是素养问题。' },
        { t: '只重置密码', q: 'ok', f: '⚠️ 密码换了，但"允许过的会话"还有效，必须撤销。' },
      ],
      lvWhy: '账号已被接管 → P1。',
      natWhy: '轰炸后 ALLOW 的模式是 MFA 疲劳的教科书定义。' };
  }},
  { src: '威胁情报', gen() {
    const u = ruser();
    return { level: 'P2', nature: 'threat',
      title: '暗网泄露账密命中公司域名', meta: [['来源', '暗网监控频道'], ['内容', 'corp.com 域名邮箱+明文密码 214 组'], ['关联', u + ' 等高管账号在列'], ['时效', '昨夜新增']],
      evid: ['泄露库含 214 组 @corp.com 账密', '其中 3 组为部门负责人', '明文格式（该批来自某历史论坛库）'],
      acts: [
        { t: '强制重置命中账号 + 全网日志反查是否有成功登录', q: 'best', f: '✅ 情报到手先"对号入座"：查这些账密有没有已经被拿来登录过。' },
        { t: '仅内部通报提醒改密', q: 'ok', f: '⚠️ 提醒≠强制。命中的高权限账号必须强制重置。' },
        { t: '历史泄露库太旧，忽略', q: 'bad', f: '❌ 密码复用让"旧库"永远新鲜——改密率统计会告诉你。' },
      ],
      lvWhy: '214 组凭据暴露+高管在列 → P2（立即重置）。',
      natWhy: '明文凭据+域名精准，真实泄露。' };
  }},
  { src: 'DLP', gen() {
    const h = rhost(), u = ruser();
    return { level: 'P2', nature: 'threat',
      title: '陌生 USB 设备批量拷贝', meta: [['主机', h], ['用户', u], ['设备', '未知厂商 U 盘（首次接入）'], ['行为', '10 分钟拷贝 2.4GB 文档']],
      evid: ['USB 首次接入即批量读取 D:\\projects\\', '复制清单含 3 个核心仓库压缩包', '该终端策略应为"禁止可移动介质"'],
      acts: [
        { t: '终端告警核实 + 暂扣介质 + 按泄露流程评估', q: 'best', f: '✅ 介质策略被绕过本身就是事件——先扣证据再查动机。' },
        { t: '只更新 DLP 策略', q: 'ok', f: '⚠️ 策略该收紧，但已拷走的 2.4GB 要评估。' },
        { t: '可能是领导要资料，忽略', q: 'bad', f: '❌ "可能是领导"要核实，不是忽略——两者在报告里是两码事。' },
      ],
      lvWhy: '疑似数据外带 → P2。',
      natWhy: '首次设备+批量+策略绕过 → 倾向真实。' };
  }},
  { src: 'SIEM', gen() {
    const ak = 'AKIA' + Math.floor(Math.random() * 1e10).toString().padStart(10, '0');
    return { level: 'P1', nature: 'threat',
      title: '云 AccessKey 异地异常调用', meta: [['Key', ak + '（生产部署密钥）'], ['基线', '仅 10.1.2.40 使用'], ['异常', '柏林节点调用 DeleteBucket'], ['时间', '04:12']],
      evid: ['04:12 该 AK 自境外 IP 调用 DeleteBucket（删除存储桶）', '基线中该 AK 仅从固定内网 IP 使用', '调用前 30 分钟该 Key 出现在公开代码仓库提交中'],
      acts: [
        { t: '立即禁用该 AK + 轮换 + 审计其全部 API 调用历史', q: 'best', f: '✅ DeleteBucket=破坏进行中。先禁 Key 止损，再谈溯源与修复。' },
        { t: '在代码仓库里删掉泄露的 Key', q: 'ok', f: '⚠️ 已提交的 Key 会被爬虫秒收——删除历史也需要轮换，且轮换是第一步。' },
        { t: '等云厂商确认', q: 'bad', f: '❌ 你自己的审计日志就是证据，等确认的每一分钟都在冒烟。' },
      ],
      lvWhy: '云资源正在被破坏 → P1。',
      natWhy: '基线外地域+破坏性 API = 云接管。' };
  }},
  { src: 'SIEM', gen() {
    const pod = pick(['debug-tool', 'perf-test', 'ops-agent-v2']);
    return { level: 'P2', nature: 'threat',
      title: '生产集群创建特权容器', meta: [['集群', 'prod-k8s-01'], ['账号', 'cicd-bot'], ['Pod', pod], ['配置', 'privileged=true hostPID=true']],
      evid: [`03:10 由 cicd-bot 创建 ${pod}（privileged+hostPID）`, '该账号历史上只部署无特权应用', 'Pod 启动后 2 分钟内 exec 进入'],
      acts: [
        { t: '删除 Pod + 吊销 cicd-bot 凭据 + 集群审计该账号全部操作', q: 'best', f: '✅ CI 凭据失陷是容器集群最危险的入侵路径之一——它能部署一切。' },
        { t: '仅删除 Pod', q: 'ok', f: '⚠️ Pod 删了，凭据还在，它可以再创建十个。' },
        { t: 'CI 部署需要特权，忽略', q: 'bad', f: '❌ 正常 CI 部署业务镜像不需要 privileged+hostPID。' },
      ],
      lvWhy: '集群内持久化+高权限 → P2。',
      natWhy: '基线外权限+时间异常 → 真实威胁。' };
  }},
  { src: 'WAF', gen() {
    const ip = ripForeign();
    return { level: 'P1', nature: 'threat',
      title: 'Webshell 心跳通信', meta: [['路径', '/uploads/config1.php'], ['来源', ip], ['模式', '每 60 秒 POST 一次 · 持续 3 小时'], ['响应', '全部 200 空体']],
      evid: ['该 .php 文件 3 天前由上传功能创建', 'POST 参数 pass= 每次内容不同（命令结果）', '60 秒固定间隔 = Webshell 管理端心跳'],
      acts: [
        { t: '删除 Webshell + 隔离主机排查 + 回溯该 IP 全部历史', q: 'best', f: '✅ 心跳 3 小时=攻击者已持续控制 3 小时，按已失陷主机处置。' },
        { t: '删除文件不排查', q: 'ok', f: '⚠️ 这 3 小时里它可能加了账号/传了新马——必须倒查。' },
        { t: '文件是正常业务脚本', q: 'bad', f: '❌ 正常脚本不会每 60 秒被同一境外 IP POST 一次。' },
      ],
      lvWhy: '服务器被持续控制 → P1。',
      natWhy: '上传来源+固定心跳+命令参数，三证齐全。' };
  }},
  ];

  /* ============================================================
     引擎
     ============================================================ */
  let state = null;
  let timer = null;
  let durationMin = 30;

  function fmt(s) { const m = Math.floor(s / 60), ss = s % 60; return String(m).padStart(2, '0') + ':' + String(ss).padStart(2, '0'); }

  function buildPool() {
    // 打乱模板，保证一局内不重复
    const p = T.map((t, i) => i).sort(() => Math.random() - .5);
    return p;
  }

  function start() {
    durationMin = +($('#socStart .chip.on')?.dataset.dur || 30);
    state = {
      sec: 0, total: durationMin * 60,
      score: 0, maxScore: 0, sla: 100, handled: 0, combo: 0, bestCombo: 0,
      okLv: 0, okNat: 0, bestAct: 0,
      pool: buildPool(), cur: null, curStart: 0, spawning: false, resolved: 0,
      spawnAt: 8 + r(8), mistakes: [], lastSpawnSec: -999,
    };
    $('#socStart').style.display = 'none';
    $('#socConsole').style.display = 'block';
    $('#feed').innerHTML = '';
    renderStandby('等待第一条告警…', '你的班次开始了。喝口水，盯着大屏。');
    updateTop();
    clearInterval(timer);
    timer = setInterval(tick, 1000);
  }

  function tick() {
    state.sec++;
    updateTop();
    // 当前告警的响应计时（>120s 变黄，>180s 变红并标记超时）
    if (state.cur) {
      const el = document.getElementById('alertTimer');
      if (el) {
        const t = state.sec - state.curStart;
        el.textContent = fmt(t);
        if (t > 180) { el.style.color = 'var(--ro)'; el.textContent += ' ⚠ 超时'; }
        else if (t > 120) el.style.color = 'var(--am)';
      }
    }
    const remain = state.total - state.sec;
    // 下班
    if (remain <= 0) {
      if (!state.cur) return endShift();
      // 处置完当前这条就收工
      return;
    }
    // 弹警：上一条已解决 且 距离上次解决过了随机间隔 且 剩余时间够
    if (!state.cur && !state.spawning && remain > 45 && state.sec >= state.spawnAt) {
      spawn();
    }
  }

  function spawn() {
    if (!state.pool.length) state.pool = buildPool();
    const idx = state.pool.shift();
    const tpl = T[idx];
    const a = tpl.gen();
    a.src = tpl.src;
    a.alertSec = state.sec;
    state.cur = a;
    state.curStart = state.sec;
    state.slaTimed = false;
    // feed
    const el = document.createElement('div');
    el.className = 'feed-item new cur';
    el.id = 'feed-cur';
    el.innerHTML = `<div class="f-top"><span class="src-badge src-${a.src}">${a.src}</span><b>${esc(a.title)}</b><span class="f-time">${fmt(state.sec)}</span></div><small>点击右侧处置台研判 · 处置中…</small>`;
    $('#feed').prepend(el);
    renderTriage(a);
    App && App.toast(`🚨 新告警：${a.title}`, '🛰️');
  }

  function renderStandby(title, sub) {
    $('#triageWrap').innerHTML = `
      <div class="soc-standby">
        <div class="radar"></div>
        <h3 style="font-size:17px;font-weight:800;color:var(--tx2)">${title}</h3>
        <p style="font-size:13px;margin-top:6px">${sub}</p>
      </div>`;
  }

  function renderTriage(a) {
    const keys = ['①', '②', '③'];
    $('#triageWrap').innerHTML = `
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span class="src-badge src-${a.src}">${a.src}</span>
        <h3 style="font-size:18px;font-weight:800">${esc(a.title)}</h3>
        <span style="margin-left:auto;font-family:var(--m);font-size:12px;color:var(--tx3)">响应计时 <b id="alertTimer" style="color:var(--am)">00:00</b> / 建议 03:00 内</span>
      </div>
      <div class="ev-box">${a.meta.map(m => `<div><span style="color:var(--tx3)">${esc(m[0])}：</span>${esc(m[1])}</div>`).join('')}</div>
      <div class="ev-box" style="border-color:rgba(251,191,36,.3)">📌 证据${a.evid.map(e => `<div>· ${esc(e)}</div>`).join('')}</div>

      <div class="triage-step">
        <div class="ts-title"><span class="ts-no">①</span>给这条告警定级</div>
        <div class="opt-row inline" id="rowLv">${['P1 紧急', 'P2 高', 'P3 中', 'P4 低'].map((t, i) => `<button class="o-btn" data-v="${i}">${t}</button>`).join('')}</div>
      </div>
      <div class="triage-step">
        <div class="ts-title"><span class="ts-no">②</span>研判性质</div>
        <div class="opt-row inline" id="rowNat">${[['threat', '真实威胁'], ['false', '误报'], ['low', '低价值噪音']].map(x => `<button class="o-btn" data-v="${x[0]}">${x[1]}</button>`).join('')}</div>
      </div>
      <div class="triage-step">
        <div class="ts-title"><span class="ts-no">③</span>选择处置动作</div>
        <div class="opt-row" id="rowAct">${a.acts.map((x, i) => `<button class="o-btn" data-v="${i}">${esc(x.t)}</button>`).join('')}</div>
      </div>
      <div id="verdict"></div>
      <button class="btn btn-primary" id="submitBtn" style="width:100%;margin-top:16px" disabled>🛡️ 提交处置结论</button>`;

    let lv = -1, nat = '', act = -1;
    const check = () => { $('#submitBtn').disabled = !(lv >= 0 && nat && act >= 0); };
    $('#rowLv').querySelectorAll('.o-btn').forEach(b => b.onclick = () => { lv = +b.dataset.v; $('#rowLv').querySelectorAll('.o-btn').forEach(x => x.classList.remove('picked')); b.classList.add('picked'); check(); });
    $('#rowNat').querySelectorAll('.o-btn').forEach(b => b.onclick = () => { nat = b.dataset.v; $('#rowNat').querySelectorAll('.o-btn').forEach(x => x.classList.remove('picked')); b.classList.add('picked'); check(); });
    $('#rowAct').querySelectorAll('.o-btn').forEach(b => b.onclick = () => { act = +b.dataset.v; $('#rowAct').querySelectorAll('.o-btn').forEach(x => x.classList.remove('picked')); b.classList.add('picked'); check(); });
    $('#submitBtn').onclick = () => grade(a, lv, nat, act);
  }

  function grade(a, lv, nat, act) {
    // 计分
    const lvIdx = ['P1', 'P2', 'P3', 'P4'].indexOf(a.level);
    const dist = Math.abs(lv - lvIdx);
    const lvPts = dist === 0 ? 10 : dist === 1 ? 4 : 0;
    const natPts = nat === a.nature ? 10 : 0;
    const q = a.acts[act].q;
    const actPts = q === 'best' ? 10 : q === 'ok' ? 5 : 0;
    let slaHit = 0;
    if (q === 'bad') slaHit += 12;
    if (natPts === 0) slaHit += 6;
    if (lvPts === 0) slaHit += 3;
    const took = state.sec - state.curStart;
    if (took > 180 && state.sla > 0) { slaHit += 5; }
    state.score += lvPts + natPts + actPts;
    state.maxScore += 30;
    state.sla = Math.max(0, state.sla - slaHit);
    state.handled++;
    const allOk = lvPts === 10 && natPts === 10 && actPts === 10;
    state.combo = allOk ? state.combo + 1 : 0;
    state.bestCombo = Math.max(state.bestCombo, state.combo);
    if (lvPts === 10) state.okLv++;
    if (natPts === 10) state.okNat++;
    if (q === 'best') state.bestAct++;
    if (lvPts < 10 || natPts === 0 || q !== 'best') {
      state.mistakes.push({ title: a.title, src: a.src, lvSel: ['P1', 'P2', 'P3', 'P4'][lv], lvOk: a.level, natSel: nat, natOk: a.nature, actSel: a.acts[act].t, actQ: q, lvWhy: a.lvWhy, natWhy: a.natWhy, actFb: a.acts[act].f });
    }
    updateTop();

    // 标注选项对错
    const lvBtns = $('#rowLv').querySelectorAll('.o-btn');
    lvBtns.forEach((b, i) => { b.disabled = true; if (i === lvIdx) b.classList.add('right'); else if (i === lv) b.classList.add('wrong'); });
    const natBtns = $('#rowNat').querySelectorAll('.o-btn');
    natBtns.forEach(b => { b.disabled = true; if (b.dataset.v === a.nature) b.classList.add('right'); else if (b.dataset.v === nat) b.classList.add('wrong'); });
    const actBtns = $('#rowAct').querySelectorAll('.o-btn');
    actBtns.forEach((b, i) => { b.disabled = true; if (a.acts[i].q === 'best') b.classList.add('right'); else if (i === act) b.classList.add('wrong'); });

    const g = (ok, half) => ok ? '<span class="g-ok">✓ 满分</span>' : half ? '<span class="g-half">◐ 部分分</span>' : '<span class="g-no">✗ 0分</span>';
    $('#verdict').innerHTML = `
      <div class="grade-strip">
        <span>定级 ${lvPts}/10 ${g(lvPts === 10, lvPts === 4)}</span>
        <span>定性 ${natPts}/10 ${g(natPts === 10, false)}</span>
        <span>处置 ${actPts}/10 ${g(actPts === 10, actPts === 5)}</span>
        ${slaHit ? `<span class="g-no">SLA -${slaHit}</span>` : '<span class="g-ok">SLA 无损</span>'}
      </div>
      <div style="font-size:13.5px;line-height:1.9;color:var(--tx2)">
        <div>🔎 <b style="color:var(--cy)">定级：</b>${esc(a.lvWhy)}</div>
        <div>⚖️ <b style="color:var(--cy)">定性：</b>${esc(a.natWhy)}</div>
        <div>🛡️ <b style="color:var(--cy)">处置：</b>${esc(a.acts[act].f)}</div>
      </div>`;
    $('#submitBtn').outerHTML = `<button class="btn btn-primary" id="doneBtn" style="width:100%;margin-top:16px">✅ 完成处置，继续值班 →</button>`;
    $('#doneBtn').onclick = resolveCurrent;
  }

  function resolveCurrent() {
    if (!state.cur) return;
    const el = document.getElementById('feed-cur');
    if (el) { el.classList.remove('cur'); el.classList.add('done'); el.querySelector('small').textContent = '已处置 ✓'; el.removeAttribute('id'); }
    state.cur = null;
    state.resolved++;
    // 下一条的随机间隔：50-90 秒后（上一条解决之后才开始计）
    state.spawnAt = state.sec + 50 + r(41);
    updateTop();
    if (state.total - state.sec <= 0) return endShift();
    renderStandby('监视中…', '大屏滚动正常。下一条告警随时可能进来——上一条你已经处置完毕。');
  }

  function updateTop() {
    $('#scClock').textContent = fmt(state.sec);
    $('#scRemain').textContent = fmt(Math.max(0, state.total - state.sec));
    $('#scHandled').textContent = state.handled;
    $('#scScore').textContent = state.score;
    $('#scCombo').textContent = state.combo;
    $('#scSlaTxt').textContent = state.sla;
    const bar = $('#scSlaBar');
    bar.style.width = state.sla + '%';
    bar.style.background = state.sla > 66 ? 'linear-gradient(90deg,#34d399,#a3e635)' : state.sla > 33 ? 'linear-gradient(90deg,#fbbf24,#f59e0b)' : 'linear-gradient(90deg,#fb7185,#f43f5e)';
  }

  function endShift() {
    clearInterval(timer);
    $('#socConsole').style.display = 'none';
    const rep = $('#socReport');
    rep.style.display = 'block';
    const pct = state.maxScore ? Math.round(state.score / state.maxScore * 100) : 0;
    const rank = pct >= 90 ? 'S' : pct >= 75 ? 'A' : pct >= 60 ? 'B' : 'C';
    const rankTxt = { S: '🌟 资深值守——什么告警到你手里都先定级再动手', A: '🥈 优秀分析师——大方向稳，个别处置可以更快更准', B: '🥉 合格值班生——能闭环，但研判三步还要形成肌肉记忆', C: '📋 建议回炉——把课程区「告警与误报」「应急六步法」再过一遍' }[rank];
    const natName = { threat: '真实威胁', false: '误报', low: '低价值噪音' };
    Progress.recordGame('sim', rank);
    const xp = Math.round(state.score / 3) + (rank === 'S' ? 30 : rank === 'A' ? 15 : 0);
    Progress.addXP(xp, 'SOC 值班班次');
    rep.innerHTML = `
      <div class="card game-over">
        <div class="go-ico">${rank === 'S' ? '🌟' : rank === 'A' ? '🥈' : rank === 'B' ? '🥉' : '📋'}</div>
        <h3>班次结束 · 评价 ${rank} 级</h3>
        <p>${rankTxt}</p>
        <div class="report-grid">
          <div class="rg"><b>${state.handled}</b><span>处置告警</span></div>
          <div class="rg"><b>${state.maxScore ? pct : 0}%</b><span>研判得分率</span></div>
          <div class="rg"><b>${state.okNat}/${state.handled}</b><span>定性正确（真伪识别）</span></div>
          <div class="rg"><b>${state.bestCombo}</b><span>最高连对</span></div>
        </div>
        <div class="go-xp">+${xp} XP 已入账 · SLA ${state.sla}/100</div>
        ${state.mistakes.length ? `
        <div style="text-align:left;margin:18px 0">
          <h4 style="font-size:15px;font-weight:800;margin-bottom:10px">📝 本班次错题复盘（${state.mistakes.length} 条）</h4>
          ${state.mistakes.map(m => `
            <div class="card" style="padding:13px 16px;margin-bottom:10px;text-align:left">
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:5px">
                <span class="src-badge src-${m.src}">${m.src}</span><b style="font-size:13.5px">${esc(m.title)}</b>
              </div>
              <div style="font-size:12.5px;color:var(--tx2);line-height:1.8">
                定级：你选 ${m.lvSel} · 正确 ${m.lvOk} — ${esc(m.lvWhy)}<br>
                定性：你选 ${natName[m.natSel] || m.natSel} · 正确 ${natName[m.natOk]} — ${esc(m.natWhy)}<br>
                处置：${esc(m.actSel)} — ${esc(m.actFb)}
              </div>
            </div>`).join('')}
        </div>` : `<p style="color:${state.handled ? 'var(--gr)' : 'var(--am)'};font-weight:700;margin:14px 0">${state.handled ? '本班次零失误——教科书级值守！' : '本班次没有处置任何告警——下次手要快一点 😄'}</p>`}
        <div style="display:flex;gap:12px;justify-content:center;margin-top:18px">
          <button class="btn btn-primary" onclick="location.reload()">🔄 再值一班</button>
          <a class="btn btn-ghost" href="games.html">返回游戏中心</a>
        </div>
      </div>`;
    if (window.App) { App.confetti(80); if (rank === 'S') App.toast('S 级值守！冷静值日生徽章到手', '🌟', true); }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ---------- 启动 ---------- */
  document.addEventListener('DOMContentLoaded', () => {
    // 隐藏调试通道（#demo）：允许直接结束班次查看报告
    if (location.hash.includes('demo')) window.__socEnd = () => endShift();
    document.querySelectorAll('#socStart .chip').forEach(b => {
      b.onclick = () => {
        document.querySelectorAll('#socStart .chip').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
      };
    });
    $('#startBtn').onclick = start;
  });
})();
