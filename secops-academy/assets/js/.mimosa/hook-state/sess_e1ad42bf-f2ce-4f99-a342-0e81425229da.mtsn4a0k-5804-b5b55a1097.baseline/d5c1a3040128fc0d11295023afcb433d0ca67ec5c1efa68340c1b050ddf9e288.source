      { q: 'Windows"登录失败"事件 ID', hint: '看 CSV 里反复出现的 event 值', ans: ['4625'], teach: '🔢 4624 成功 / 4625 失败 / 4688 进程 / 4720 建号 / 7045 装服务。' },
      { q: '爆破成功发生在（时:分:秒）', hint: 'grep 4624 看来自同一 IP 的那条', ans: ['02:01:06'], teach: '⏱️ 5 连败后一条 4624 同源成功——爆破转化实锤。' },
    ],
    victory: ['结论：203.0.113.77 五次 RDP 爆破后于 02:01:06 成功登录 administrator。', '整改：NLA+锁定策略+3389 限源走堡垒机。'] },

  { id: 'n2', ico: '👤', title: 'Windows 日志 · 凭空多出的账号', cat: 'Windows 事件日志', diff: 2,
    brief: '事件流里有个账号的"出生记录"和"首次使用记录"挨得很近……',
    files: { '/logs/win/security_events.csv': [
