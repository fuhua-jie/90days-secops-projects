      { q: '创建账号的事件 ID', hint: '那条"账号创建"记录的 event 值', ans: ['4720'], teach: '🔢 4732=加入管理组，跟在 4720 后面=直接给了管理员权限。' },
      { q: '该账号首次登录的来源 IP', hint: 'grep "hacker_x" 看那条 4624', ans: ['45.83.66.10'], teach: '🌍 内网创建、境外登录——账号是给攻击者"远程进门"用的。' },
    ],
