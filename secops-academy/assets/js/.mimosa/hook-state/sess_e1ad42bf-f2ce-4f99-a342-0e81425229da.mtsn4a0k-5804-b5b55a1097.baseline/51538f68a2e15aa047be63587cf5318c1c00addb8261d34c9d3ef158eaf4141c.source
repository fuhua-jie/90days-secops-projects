/* ============================================================
   data-glossary.js — 术语速查（零基础人话版，7 大类 72 条）
   ============================================================ */

const GLOSSARY = [
/* —— 基础概念 —— */
{ t:'安全运营', en:'Security Operations', c:'基础概念', d:'让安全从"一次性项目"变成每天运转的机器：监控、检测、响应、加固的持续循环。', eg:'SOC 团队 7×24 盯告警就是安全运营的日常。' },
{ t:'SOC', en:'Security Operations Center', c:'基础概念', d:'安全运营中心，防守方的"110 指挥中心"，大屏+日志+一群分析师。', eg:'出事后第一个进场的就是 SOC 值班同学。' },
{ t:'蓝队 / 红队 / 紫队', en:'Blue / Red / Purple Team', c:'基础概念', d:'蓝队防守，红队模拟攻击，紫队=两边协作复盘改进。', eg:'攻防演练里红队打、蓝队防、紫队复盘。' },
{ t:'CIA 三元组', en:'CIA Triad', c:'基础概念', d:'安全的三大目标：保密性、完整性、可用性。', eg:'日记上锁是保密性，没人偷改是完整性，要用时能找到是可用性。' },
{ t:'资产', en:'Asset', c:'基础概念', d:'需要保护的一切：服务器、数据、账号、域名……不知道自己有什么，就谈不上保护。', eg:'资产盘点是安全建设的第一步。' },
{ t:'攻击面', en:'Attack Surface', c:'基础概念', d:'所有可能被攻击的入口总和。暴露的服务、弱密码、可点的员工都是。', eg:'关闭不用的服务=缩小攻击面。' },
{ t:'风险', en:'Risk', c:'基础概念', d:'风险 = 资产价值 × 脆弱性 × 威胁。用来排优先级。', eg:'核心系统+高危漏洞+在野利用=今晚就修。' },
{ t:'漏洞', en:'Vulnerability', c:'基础概念', d:'软件的设计/实现缺陷，可能被攻击者利用。', eg:'CVE 编号是全球通用的漏洞身份证。' },
{ t:'CVE / CVSS', en:'—', c:'基础概念', d:'CVE=漏洞的全球编号；CVSS=漏洞严重程度打分（10 分制）。', eg:'CVE-2021-44228（Log4Shell）评分 10.0。' },
{ t:'0day / Nday', en:'—', c:'基础概念', d:'0day=官方还没补丁的漏洞；Nday=已有补丁但没打的老漏洞。', eg:'大部分入侵其实用的是 Nday——补丁没打而已。' },
{ t:'补丁', en:'Patch', c:'基础概念', d:'官方发布的漏洞修复包，相当于"补墙上的裂缝"。', eg:'"打补丁了吗"是安全工程师的口头禅。' },
{ t:'PoC / Exploit', en:'—', c:'基础概念', d:'PoC=证明漏洞存在的验证代码；Exploit=真正利用漏洞的攻击代码。', eg:'有 PoC 不代表能打穿，Exploit 才是实弹。' },
{ t:'加密', en:'Encryption', c:'基础概念', d:'把内容变成乱码，没钥匙（密钥）解不开。', eg:'勒索软件加密你的文件，就是拿"加密"当武器。' },
{ t:'备份', en:'Backup', c:'基础概念', d:'数据的复印件。3-2-1 原则：3 份副本、2 种介质、1 份离线。', eg:'有了离线备份，勒索信对你无效。' },
{ t:'两步验证', en:'MFA / 2FA', c:'基础概念', d:'密码之外再要动态验证码（短信/APP/硬件钥匙），密码泄露也进不来。', eg:'性价比最高的个人安全措施，没有之一。' },

/* —— 网络与协议 —— */
{ t:'IP 地址', en:'IP Address', c:'网络协议', d:'设备的"门牌号"，如 192.168.1.10。', eg:'看日志先看"谁（IP）在连谁（IP）"。' },
{ t:'域名', en:'Domain', c:'网络协议', d:'网站的好记名字（baidu.com），通过 DNS 翻译成 IP。', eg:'paypa1.com 用 1 冒充 l——域名仿冒是钓鱼惯用招。' },
{ t:'端口', en:'Port', c:'网络协议', d:'一台电脑上服务的"房间号"：22=SSH、80/443=网页、3389=远程桌面。', eg:'扫描器就是挨个敲门看哪个房间有人。' },
{ t:'DNS', en:'Domain Name System', c:'网络协议', d:'互联网电话簿：域名→IP。黑客用它上线、外传数据、搭假站。', eg:'超长子域名查询=DNS 隧道外传数据。' },
{ t:'HTTP / HTTPS', en:'—', c:'网络协议', d:'网页传输协议；HTTPS 加了加密和身份验证。', eg:'HTTP 是明信片，HTTPS 是密封信。' },
{ t:'状态码', en:'Status Code', c:'网络协议', d:'服务器回话表情：200 成功、401 未登录、403 禁止、404 没有、500 崩了。', eg:'爆破里"401 海洋中的一条 200"最危险。' },
{ t:'Cookie / 会话', en:'Session', c:'网络协议', d:'登录后的"通行证"，被偷=不用密码也能进你的账号。', eg:'XSS 的目标就是偷 Cookie。' },
{ t:'SPF / DKIM / DMARC', en:'—', c:'网络协议', d:'邮件防伪三件套：发信白名单、防伪签名、失败处置策略。', eg:'判断"老板邮件"真假的技术依据。' },
{ t:'南北向 / 东西向流量', en:'—', c:'网络协议', d:'南北向=内外互访（大门看得见）；东西向=内网互访（横向移动主场）。', eg:'零信任的重点就是管住东西向。' },
{ t:'VPN', en:'Virtual Private Network', c:'网络协议', d:'加密隧道：远程安全接入内网，或隐藏真实来源。', eg:'VPN 账号被盗=黑客拿到进内网的隧道。' },

/* —— 攻击术语 —— */
{ t:'社会工程学', en:'Social Engineering', c:'攻击术语', d:'不攻系统攻人心：利用信任、恐惧、好奇、紧迫。', eg:'"我是 IT 部，把验证码给我"就是社工。' },
{ t:'钓鱼', en:'Phishing', c:'攻击术语', d:'冒充可信方骗你点击/输密码。群发=撒网，定向=鱼叉，骗钱=BEC。', eg:'"邮箱将停用，点击验证"是经典钓鱼。' },
{ t:'鱼叉攻击', en:'Spear Phishing', c:'攻击术语', d:'针对特定人的精准钓鱼，用你的真实信息定制，更难识别。', eg:'邮件里写对你全名+职位+项目名，就要警惕。' },
{ t:'BEC', en:'Business Email Compromise', c:'攻击术语', d:'商务邮件诈骗：冒充老板/供应商骗转账，全程无病毒。', eg:'唯一防线：双人复核+电话回拨。' },
{ t:'暴力破解', en:'Brute Force', c:'攻击术语', d:'程序自动穷举密码组合。', eg:'对策：长密码+登录失败锁定+MFA。' },
{ t:'撞库', en:'Credential Stuffing', c:'攻击术语', d:'拿 A 站泄露的账密批量试 B 站（吃定你密码复用）。', eg:'各站不同密码是对策。' },
{ t:'SQL 注入', en:'SQLi', c:'攻击术语', d:'把 SQL 代码混进输入骗数据库执行，绕过验证甚至拖库。', eg:'日志特征：id=1\' OR \'1\'=\'1、union select。' },
{ t:'XSS', en:'Cross-Site Scripting', c:'攻击术语', d:'把脚本塞进页面，在别人的浏览器里执行，偷 Cookie。', eg:'受害者是浏览页面的用户，不是服务器。' },
{ t:'CSRF', en:'—', c:'攻击术语', d:'借你已登录的身份，骗浏览器替攻击者发请求（如转账）。', eg:'你开着邮箱，别的网页就替你发了封邮件。' },
{ t:'SSRF', en:'—', c:'攻击术语', d:'骗服务器"替我访问这个网址"，探测内网、偷云凭证。', eg:'打 169.254.169.254 偷云主机的临时密钥。' },
{ t:'路径穿越', en:'Path Traversal', c:'攻击术语', d:'用 ../../ 上跳目录读服务器任意文件。', eg:'file=../../../etc/passwd。' },
{ t:'文件上传漏洞', en:'—', c:'攻击术语', d:'上传 Webshell 拿到服务器控制权。', eg:'"会自己拆的包裹"寄进后台。' },
{ t:'Webshell', en:'—', c:'攻击术语', d:'留在服务器上的网页后门，随时远程执行命令。', eg:'服务器多出陌生 .php 且被频繁 POST=危险信号。' },
{ t:'反序列化漏洞', en:'—', c:'攻击术语', d:'程序还原数据时执行了恶意代码，常见于 Java 应用。', eg:'Log4Shell 就是此类"明星漏洞"。' },
{ t:'弱口令', en:'Weak Password', c:'攻击术语', d:'123456、admin888 这类秒破密码。', eg:'大量入侵的起点就是它。' },
{ t:'爆破成功', en:'—', c:'攻击术语', d:'海量 401 后出现 200——密码被试出来了。', eg:'SOC 里属于必须立即处置的 P2 告警。' },
{ t:'恶意软件', en:'Malware', c:'攻击术语', d:'所有坏程序的统称：病毒、木马、蠕虫、勒索、挖矿……', eg:'按"中招表现"记忆更高效。' },
{ t:'勒索软件', en:'Ransomware', c:'攻击术语', d:'加密文件索要赎金，现代企业头号噩梦。', eg:'处置第一步：断网隔离（不是关机）。' },
{ t:'挖矿木马', en:'Crypto Miner', c:'攻击术语', d:'偷算力挖币。CPU 长期 90%+、连矿池端口。', eg:'3333/4444/5555 是常见矿池端口。' },
{ t:'远控木马', en:'RAT', c:'攻击术语', d:'被远程操控的后门，可键盘记录、屏幕监控。', eg:'伪装成"简历.exe"是最常见投递方式。' },
{ t:'蠕虫', en:'Worm', c:'攻击术语', d:'自我复制自动传播，如利用 445 端口的 WannaCry。', eg:'一夜感染全内网的就是它。' },
{ t:'僵尸网络', en:'Botnet', c:'攻击术语', d:'大量中毒电脑组成的"打工军团"，用于 DDoS/群发/代理。', eg:'你的电脑慢+异常外联，可能已入伙。' },
{ t:'C2 / C&C', en:'Command & Control', c:'攻击术语', d:'攻击者的遥控指挥中心，中毒主机定期回连。', eg:'掐断 C2 通道，木马即"失聪"。' },
{ t:'横向移动', en:'Lateral Movement', c:'攻击术语', d:'攻陷一台后用其权限攻下一台，内网串门。', eg:'偷了前台门禁卡，一层层往上刷。' },
{ t:'持久化', en:'Persistence', c:'攻击术语', d:'让权限"长期保留"：计划任务、启动项、公钥、服务。', eg:'杀完又复发=持久化没拔根。' },
{ t:'提权', en:'Privilege Escalation', c:'攻击术语', d:'从普通权限升级到管理员/root。', eg:'SUID 后门、内核漏洞是常见路径。' },
{ t:'无文件攻击', en:'Fileless Attack', c:'攻击术语', d:'不落地文件，全在内存里用 PowerShell 等工具作案，杀毒难抓。', eg:'-enc 混淆命令是典型特征。' },
{ t:'DDoS', en:'—', c:'攻击术语', d:'海量垃圾请求挤爆服务器，破坏可用性。', eg:'僵尸网络最爱干的活。' },
{ t:'拖库', en:'—', c:'攻击术语', d:'把整个数据库偷走。', eg:'用户密码一定不要明文存！' },
{ t:'供应链攻击', en:'Supply Chain Attack', c:'攻击术语', d:'污染软件更新包/第三方组件，"借道"进入所有下游。', eg:'SolarWinds 事件是教科书案例。' },
{ t:'杀链 / ATT&CK', en:'Kill Chain / ATT&CK', c:'攻击术语', d:'把攻击拆成标准阶段的框架；ATT&CK 是全球通用的"战术×技术"字典。', eg:'每条检测规则都该标注覆盖 ATT&CK 哪格。' },
{ t:'侦察', en:'Reconnaissance', c:'攻击术语', d:'攻击前的踩点：扫端口、搜邮箱、摸业务。', eg:'大量 404 扫描就是在画地图。' },

/* —— 设备与工具 —— */
{ t:'防火墙', en:'Firewall', c:'设备工具', d:'按规则放行/拦截流量的门卫。', eg:'买来默认全放行=摆设，要配规则。' },
{ t:'WAF', en:'Web Application Firewall', c:'设备工具', d:'网站专用门卫，审"请求单"里有没有攻击载荷。', eg:'拦 SQL 注入/XSS 的主力。' },
{ t:'IDS / IPS', en:'—', c:'设备工具', d:'IDS 只报警（探头），IPS 能阻断（自动关门）。', eg:'串在网络里盯可疑流量。' },
{ t:'EDR', en:'Endpoint Detection & Response', c:'设备工具', d:'终端行为记录仪+远程遥控：监控进程/网络/文件，可一键隔离主机。', eg:'应急遏制阶段的核心工具。' },
{ t:'SIEM', en:'—', c:'设备工具', d:'安全日志集中平台：采集→归一化→关联→告警。', eg:'"北京登录+5 分钟后境外登录"这类时空矛盾靠它发现。' },
{ t:'沙箱', en:'Sandbox', c:'设备工具', d:'隔离环境里"放毒试毒"，看附件到底干什么。', eg:'邮件附件先过沙箱再进收件箱。' },
{ t:'堡垒机', en:'Bastion Host', c:'设备工具', d:'运维进服务器的唯一通道，全程录像留痕。', eg:'堡垒机账号异常登录=P1 级告警。' },
{ t:'蜜罐', en:'Honeypot', c:'设备工具', d:'没有正常业务的假目标，谁碰谁可疑——零误报报警器。', eg:'蜜 token 被使用=立刻知道哪台主机失陷。' },
{ t:'Nmap / Wireshark', en:'—', c:'设备工具', d:'Nmap=端口扫描器；Wireshark=抓包看流量细节。', eg:'蓝队两大入门神器。' },
{ t:'Wazuh / ELK / Splunk', en:'—', c:'设备工具', d:'三个常见 SIEM/日志平台：Wazuh 开源一体、ELK 自由积木、Splunk 商业标杆。', eg:'想练手，装个 Wazuh 就能开始。' },

/* —— 应急响应 —— */
{ t:'应急响应', en:'Incident Response', c:'应急响应', d:'事件发生后的标准化处置流程：PICERL 六步法。', eg:'核心原则：隔离不关机、先取证再处置。' },
{ t:'PICERL', en:'—', c:'应急响应', d:'准备→识别→遏制→根除→恢复→复盘，全球通用应急框架。', eg:'慌乱是应急最大敌人，流程是解药。' },
{ t:'遏制', en:'Containment', c:'应急响应', d:'止损阶段：断网隔离、封 IP、重置凭据。', eg:'断网禁机，保留内存证据。' },
{ t:'取证', en:'Forensics', c:'应急响应', d:'保全证据：内存>网络>磁盘，时间戳全程记录。', eg:'关机=销毁内存里最有价值的证据。' },
{ t:'IOC', en:'Indicator of Compromise', c:'应急响应', d:'失陷指标：恶意 IP、域名、文件哈希。', eg:'用 IOC 反查全网日志=快速摸排影响面。' },
{ t:'时间线', en:'Timeline', c:'应急响应', d:'事件从入侵到恢复的完整时刻表，报告的骨架。', eg:'前提是各设备时间同步（NTP）。' },
{ t:'复盘', en:'Post-mortem', c:'应急响应', d:'事后分析根因、沉淀整改。对事不对人（Blameless）。', eg:'同一事故发生两次=复盘失败。' },
{ t:'last / lastb', en:'—', c:'应急响应', d:'Linux 命令：last 查成功登录，lastb 查失败登录（爆破证据）。', eg:'应急第一组命令。' },
{ t:'netstat', en:'—', c:'应急响应', d:'查看网络连接与对应进程，找可疑外联。', eg:'netstat -antp 是排查外联的标配。' },

/* —— 运营指标 —— */
{ t:'MTTD', en:'Mean Time to Detect', c:'运营指标', d:'从被攻击到被发现的平均时间——越短越好。', eg:'业界曾平均 200+ 天，压制它比买设备值钱。' },
{ t:'MTTR', en:'Mean Time to Respond', c:'运营指标', d:'从发现到恢复的平均时间。', eg:'预案+演练+自动化是缩短它三大法宝。' },
{ t:'误报 / 漏报', en:'False / Negative', c:'运营指标', d:'误报=狼没来乱报警；漏报=狼来了没报警。两者都要治理。', eg:'漏报比误报致命，误报比漏报常见。' },
{ t:'告警疲劳', en:'Alert Fatigue', c:'运营指标', d:'告警太多导致分析师"自动无视"，真攻击被淹没。', eg:'宁可规则少而准，不要多而吵。' },
{ t:'ATT&CK 覆盖度', en:'—', c:'运营指标', d:'检测能力覆盖 ATT&CK 矩阵的比例，用热力图找盲区。', eg:'空白格=下季度检测建设任务书。' },
{ t:'威胁情报', en:'Threat Intelligence', c:'运营指标', d:'关于对手的知识：IOC 指标 + TTP 手法 + 动机目标。', eg:'拿到新情报先回溯 90 天日志。' },
{ t:'TTP', en:'Tactics, Techniques & Procedures', c:'运营指标', d:'对手的战术、技术与程序——"作案手法"。', eg:'换车不换手，TTP 比 IOC 长命。' },
{ t:'纵深防御', en:'Defense in Depth', c:'运营指标', d:'不靠单点，层层设卡：门卫+WAF+EDR+备份+分段。', eg:'任何一层失守，下一层还有防线。' },
];

const GLOSSARY_CATS = ['全部','基础概念','网络协议','攻击术语','设备工具','应急响应','运营指标'];
