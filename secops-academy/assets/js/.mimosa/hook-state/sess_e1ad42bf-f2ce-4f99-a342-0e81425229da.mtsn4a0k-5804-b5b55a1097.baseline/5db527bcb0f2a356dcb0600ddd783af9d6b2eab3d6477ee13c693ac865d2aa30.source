    { q: '有人把网页上的商品价格偷偷从 100 改成 1 元，破坏的是？', opts: ['保密性', '完整性', '可用性', '兼容性'], a: 1, ex: '内容被未授权修改 = 完整性被破坏。' },
  ],
},

/* ========================= 模块二：上网是怎么回事 ========================= */
{
  id: 'm2l1', module: 2, ico: '🏠', title: 'IP、域名、端口',
  subtitle: '互联网就是一栋超级大楼：门牌号、名字、房间号', minutes: 11, tags: ['零基础', '网络'],
  content: [
    { type: 'p', html: '不懂网络也能学安全，但"看日志时不知道谁在和谁说话"会很难受。这一课用一个比方把三个核心概念一次讲透。' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '大楼理论', html: '把互联网想象成一栋超级大楼：<b>IP 地址 = 门牌号</b>（如 192.168.1.10，找到唯一一台电脑）；<b>域名 = 大楼的名字</b>（baidu.com，好记，翻译成门牌号就能找过去）；<b>端口 = 房间号</b>（一台电脑上有 6 万多个房间，每个房间提供不同服务）。' },
    { type: 'h', text: '必须认识的几个"房间号"（端口）' },
    { type: 'table', head: ['端口', '服务', '为什么运营关心'], rows: [
      ['22', 'SSH 远程登录 Linux', '被暴力破解的头号目标'],
      ['80 / 443', '网页 HTTP / HTTPS', 'Web 攻击主战场'],
      ['3389', 'Windows 远程桌面', '黑客横向跳板的常用入口'],
      ['445', 'Windows 文件共享', '勒索蠕虫最爱传播的通道'],
      ['53', 'DNS（域名翻译）', '数据外传的隐蔽通道'],
      ['3306 / 6379', 'MySQL / Redis 数据库', '弱口令重灾区'],
    ]},
    { type: 'h', text: '内网和外网' },
    { type: 'ul', items: [
      '<b>公网 IP</b>：全世界唯一，像"XX省XX市XX路100号"，外面能直接找到你。',
      '<b>内网 IP</b>：小区内部编号（192.168.x.x、10.x.x.x），外面找不到，只有小区内部能互访。',
      '<b>南北向流量</b>：外↔内（进出大门），防火墙看得见。',
      '<b>东西向流量</b>：内↔内（小区里串门），<b>黑客进一台电脑后到处串门就发生在这里</b>，大门保安看不见。',
    ]},
    { type: 'callout', ico: '🧠', kind: 'mind', title: '记忆卡', html: 'IP=门牌号，域名=大楼名字，端口=房间号。<b>看到日志先问：谁（IP）在敲谁（IP:端口）的房门？</b>' },
  ],
  takeaways: ['IP=门牌号，域名=名字，端口=房间号', '记住 6 个高危端口：22/80/443/3389/445/53', '内网之间"串门"的流量，大门保安看不见'],
  checks: [
    { q: 'baidu.com 这种"好记的名字"在术语里叫？', opts: ['IP 地址', '域名', '端口', '协议'], a: 1, ex: '域名是人类友好的"大楼名字"，通过 DNS 翻译成 IP 门牌号。' },
    { q: '攻击者从已沦陷的 Web 服务器去连内网数据库（3306），这种"小区内串门"属于？', opts: ['南北向流量', '东西向流量', '公网广播', '离线传输'], a: 1, ex: '内网主机互访 = 东西向流量，是横向移动的主场。' },
  ],
},
{
  id: 'm2l2', module: 2, ico: '⏎', title: '按下回车之后发生了什么？',
  subtitle: 'HTTP 请求与状态码：看懂网页世界的"对话"', minutes: 12, tags: ['零基础', 'HTTP'],
  content: [
    { type: 'p', html: '你在浏览器输入 <code>www.example.com</code> 按下回车，0.5 秒内发生了一连串事——理解它，你就能看懂 Web 日志。' },
    { type: 'code', text: '① 你：输入网址\n② DNS：把域名翻译成 IP（查电话簿）\n③ TCP：和对方服务器"接通电话"（三次握手）\n④ HTTP：浏览器发出请求 "给我首页"（Request）\n⑤ 服务器：返回网页内容 + 状态码（Response）\n⑥ 浏览器：把代码画成你看到的页面' },
    { type: 'h', text: 'HTTP 请求长什么样？' },
    { type: 'code', text: 'GET /news?id=1 HTTP/1.1          ← 方法 + 要什么 + 协议版本\nHost: www.example.com            ← 访问的域名\nUser-Agent: Mozilla/5.0 ...      ← 我是谁（浏览器身份）\nCookie: session=abc123           ← 我的"通行证"\n\nPOST /login HTTP/1.1             ← POST：提交数据（如登录表单）\n...账户密码在请求体里...' },
    { type: 'h', text: '状态码：服务器的"回话表情"' },
    { type: 'table', head: ['状态码', '意思', '安全视角'], rows: [
      ['200', 'OK，给你', '爆破后突然出现 200 = 可能试出密码了！'],
      ['302', '跳转到别处', '常见，一般无害'],
      ['403', '禁止访问', '大量 403 = 有人在扫敏感路径'],
      ['404', '没这个页面', '大量 404 = 攻击者在"踩点画地图"'],
      ['401', '未登录/密码错', '大量 401 = 正在暴力破解'],
      ['500', '服务器炸了', '突然 500 = 注入把后端搞崩了'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: 'GET vs POST', html: '<b>GET</b>=索取：参数暴露在网址里（?id=1）。<b>POST</b>=提交：数据藏在请求体里（如登录）。日志里 <b>POST 到奇怪路径</b>要格外注意——那可能是黑客在传数据、传木马。' },
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '两条安全直觉', html: '① <code>Cookie: session=xxx</code> 就是你的"登录通行证"，<b>被偷了 = 账号被偷</b>（不用密码也能进）。② 一个普通用户每秒点 1 次，日志里某 IP 每秒请求 50 次？那不是人，是脚本。' },
  ],
  takeaways: ['回车后：DNS 翻译 → TCP 接通 → HTTP 请求响应', '状态码即表情：200 正常、401/403 拒绝、404 踩点、500 崩了', 'Cookie 是通行证，被偷=账号被偷'],
  checks: [
    { q: '登录接口日志里出现上千条 401 后紧跟一条 200，最合理的怀疑是？', opts: ['网络波动', '暴力破解成功，密码被试出来了', '缓存命中', '正常重定向'], a: 1, ex: '大量失败（401）后突然成功（200），是爆破成功的经典画像，要立即核查该账号。' },
    { q: '日志中某 IP 每秒发起 60 次请求，说明？', opts: ['用户手速快', '是自动化脚本/工具在访问', '网速很好', '服务器繁忙'], a: 1, ex: '人类操作不可能每秒几十次，这是工具行为的铁证之一。' },
  ],
},
{
  id: 'm2l3', module: 2, ico: '🔒', title: 'HTTPS 与加密',
  subtitle: '浏览器地址栏的小锁，到底锁住了什么', minutes: 9, tags: ['零基础', 'HTTPS'],
  content: [
    { type: 'p', html: '地址栏开头的 <code>http://</code> 和 <code>https://</code>，多了一个 s 和一把小锁。这个 s 是 <b>Secure</b>：你和网站之间的通信被<b>加密</b>了。' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '明信片 vs 密封信', html: '<b>HTTP 像寄明信片</b>：内容裸奔，邮差（Wi-Fi 路由器、运营商）都能偷看甚至篡改。<b>HTTPS 像密封信</b>：只有收件人能拆开。在咖啡店连公共 Wi-Fi 时，明信片 mode 是很危险的。' },
    { type: 'h', text: '加密通信的三个效果' },
    { type: 'ul', items: [
      '<b>偷看不了</b>（保密）：密码、聊天内容变成乱码。',
      '<b>改不了</b>（完整）：半路篡改会被发现。',
      '<b>冒充不了</b>（身份）：数字证书证明"你连的真是官网"。',
    ]},
    { type: 'h', text: '数字证书：网站的"身份证"' },
    { type: 'p', html: 'HTTPS 靠<b>数字证书</b>证明网站身份，由可信机构（CA）颁发。当浏览器警告"证书无效/不受信任"时，可能原因：网站过期忘续费、企业内网拦截，或者——<b>你连的其实是个假冒网站</b>。看都不看直接点"继续访问"，是钓鱼受害者的高频动作。' },
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '小锁 ≠ 安全网站', html: 'HTTPS 只能证明"传输是加密的"和"域名是真的"。<b>钓鱼网站也可以申请自己的 HTTPS 证书</b>！看到小锁别放松，域名本身对不对才是关键（paypa1.com 也有小锁）。' },
    { type: 'callout', ico: '🧠', kind: 'mind', title: '运营视角', html: 'HTTPS 加密后，安全设备看不到你访问的<b>内容</b>，但仍看得到：目标 IP、端口、域名（SNI）。所以"黑名单域名告警"在 HTTPS 时代依然管用。' },
  ],
  takeaways: ['HTTPS=加密+完整+身份认证，HTTP=明信片裸奔', '数字证书是网站身份证，警告别乱点"继续"', '小锁不代表网站可信，域名对了才可信'],
  checks: [
    { q: 'HTTPS 相比 HTTP，主要多了什么？', opts: ['速度更快', '传输加密与网站身份验证', '界面更美观', '更省流量'], a: 1, ex: 'HTTPS 提供加密（偷看不了）、完整性（改不了）、证书（冒充不了）。' },
    { q: '"这个网站有 HTTPS 小锁，肯定是正规网站" 这句话？', opts: ['对', '错，钓鱼网站同样可以有自己的 HTTPS 证书', '只在手机上对', '只在国外对'], a: 1, ex: '小锁只证明加密和域名归属，假冒站点给自己申请证书毫无门槛。看域名本身！' },
  ],
},
{
  id: 'm2l4', module: 2, ico: '📬', title: 'DNS 与邮件的秘密',
  subtitle: '电话簿怎么被利用？一封"老板邮件"怎么鉴定真伪', minutes: 10, tags: ['零基础', 'DNS', '钓鱼'],
  content: [
    { type: 'p', html: '<b>DNS（域名系统）</b>就是互联网的电话簿：你问它"baidu.com 是几号门牌"，它回答"142.x.x.x"。它无处不在、几乎畅通无阻——所以黑客格外爱用它。' },
    { type: 'h', text: '黑客怎么用 DNS 使坏' },
    { type: 'ul', items: [
      '<b>上线报平安</b>：中毒的电脑定期联系"指挥官域名"（C2），换 IP 不换域名，封 IP 没用。',
      '<b>藏数据外传</b>：把偷来的数据拆碎藏进超长子域名里带出去（DNS 隧道），特征：<b>域名长得离谱地长</b>。',
      '<b>钓鱼跳板</b>：注册跟官方只差一个字母的域名（如 <code>paypa1.com</code>，1 冒充 l）。',
    ]},
    { type: 'h', text: '邮件防伪三件套（判钓鱼的核心知识）' },
    { type: 'table', head: ['协议', '干什么', '一句话'], rows: [
      ['SPF', '声明"哪些服务器有权替我发信"', '访客白名单'],
      ['DKIM', '给邮件盖防伪签名章', '封条'],
      ['DMARC', '前两个没过怎么办：拒收/放行', '处置规定'],
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '最重要的一条防骗常识', html: '邮件的<b>显示名可以随便写</b>！"王总 &lt;ceo@corp-cfo.com&gt;" 里，王总两个字是假的，括号里的域名才是真的。<b>判断邮件身份永远看 @ 后面的域名，绝不看显示名。</b>' },
    { type: 'h', text: '真实案例式自查' },
    { type: 'code', text: '✉️ 来自: 财务部王总 <wang@corrp-finance.com>   ← 真域名是 corpf.com\n     主题: 紧急！10 分钟内把项目款转到新账户\n     正文: 我在开会不方便接电话，先把款打了\n\n鉴定: ① 仿冒域名(多个 r) ② 制造紧迫 ③ 阻止电话核实\n     → 100% 商务邮件诈骗(BEC)，回复前先当面/电话确认！' },
  ],
  takeaways: ['DNS=电话簿；黑客用它上线、外传数据、搭假站', 'SPF/DKIM/DMARC 是邮件的防伪三件套', '邮件身份只看域名，不看显示名'],
  checks: [
    { q: '日志里出现大量超长随机子域名查询（60+ 字符），最可能是？', opts: ['正常访问', 'DNS 隧道在往外偷传数据', '系统更新', '时钟同步'], a: 1, ex: 'DNS 隧道把数据编码进子域名逐段带出，超长+高频是标志特征。' },
    { q: '"财务总监"邮件要求紧急转账且不方便接电话，正确做法是？', opts: ['马上转', '通过公司内通讯录拨号核实（不用邮件里给的号码）', '回复邮件确认', '先转一半'], a: 1, ex: 'BEC 靠"紧迫+隔离核实渠道"得逞。带外核实（自己拨号/当面确认）是唯一可靠动作。' },
  ],
},

/* ========================= 模块三：坏人的招数 ========================= */
{
  id: 'm3l1', module: 3, ico: '🔑', title: '密码攻防战',
  subtitle: '你的密码在黑客眼里有多脆？', minutes: 11, tags: ['零基础', '密码', '爆破'],
  content: [
    { type: 'p', html: '超过 80% 的入侵事件里，密码是重要突破口。<b>不是黑客太强，是我们的密码太懒。</b>' },
    { type: 'h', text: '黑客偷密码的五种姿势' },
    { type: 'table', head: ['姿势', '原理', '防法'], rows: [
      ['暴力破解', '程序自动试完所有组合：a, b, c…123456…', '密码长 + 限制尝试次数'],
      ['字典攻击', '只试人最爱的密码：password、qwerty', '别用"人话"当密码'],
      ['撞库', '拿 A 站泄露的账密去试 B 站（你爱用同一密码）', '各站密码不同'],
      ['钓鱼', '骗你自己在假网站上"填密码"', '看域名'],
      ['键盘记录', '中毒后你敲的每个键都被记录', '不乱下软件、装杀毒'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '密码强度靠什么', html: '两个词：<b>长度</b> 和 <b>多样性</b>。每多一位，破解时间翻好几倍；大小写+数字+符号混搭，破解时间再乘几十倍。<code>Tr0ub4dor&3</code> 还不如一句长口令 <code>我家蓝猫今年3岁爱吃鱼!</code>——又长又好记。' },
    { type: 'h', text: '算一笔账（本站「密码工坊」可以亲手玩）' },
    { type: 'code', text: '纯数字 6 位        → 1 秒内破解\n字母+数字 8 位     → 几小时\n大小写+数字+符号 12 位 → 几万年（按每秒百亿次试）\n\n结论: 长度是第一生产力，多样性是第二生产力。' },
    { type: 'h', text: '现代人密码管理守则' },
    { type: 'ul', items: [
      '<b>核心思路</b>：重要的账号（邮箱、支付、工作）密码各不相同，用密码管理器统一保管。',
      '<b>开启两步验证（MFA）</b>：就算密码泄露，没有你手机上的动态码也进不来——<b>这是性价比最高的安全措施，没有之一</b>。',
      '<b>别把密码发给任何人</b>：客服、IT 管理员永远不会要你的密码。',
    ]},
  ],
  takeaways: ['爆破/字典/撞库/钓鱼/键盘记录五大偷法', '长度 > 花样；口令短语胜过复杂短密码', '两步验证是最值得开的保命功能'],
  checks: [
    { q: '"撞库"是什么？', opts: ['把库撞塌', '拿别处泄露的账密批量来试这个网站', '数据库备份', '暴力改密码'], a: 1, ex: '用户爱复用密码，A 站泄露 → B 站遭殃，这就是撞库。对策：各站不同密码。' },
    { q: '两步验证（MFA）的价值在于？', opts: ['密码更长', '密码泄露后攻击者仍难以登录', '网速更快', '省内存'], a: 1, ex: 'MFA 加了一道动态验证，密码被偷也进不来，是性价比最高的防线。' },
  ],
},
{
  id: 'm3l2', module: 3, ico: '🎭', title: '钓鱼与社会工程学',
  subtitle: '防火墙拦得住端口扫描，拦不住"老板的红包"', minutes: 12, tags: ['零基础', '钓鱼', '社工'],
  content: [
    { type: 'p', html: '<b>社会工程学</b>= 不攻系统，专攻人心。利用的不是软件漏洞，而是人性漏洞：<b>信任、恐惧、好奇、紧迫</b>。全球大部分成功入侵，第一步都是"骗到一个真人"。' },
    { type: 'h', text: '四个心理开关' },
    { type: 'table', head: ['开关', '话术示例', '为什么有效'], rows: [
      ['权威', '"我是 IT 部，配合检查账号"', '服从上级是本能'],
      ['紧迫', '"2 小时内不处理，账号冻结"', '没时间冷静想'],
      ['恐惧', '"您的社保已停缴，点击补办"', '怕损失 > 想收益'],
      ['好奇/贪心', '"这是裁员名单，勿传"', '忍不住点'],
