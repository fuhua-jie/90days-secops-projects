{
  id: 'm4l2', module: 4, ico: '🏰', title: '企业防线全景图',
  subtitle: '防火墙、WAF、EDR、堡垒机……一次认清所有"兵器"', minutes: 12, tags: ['零基础', '设备'],
  content: [
    { type: 'p', html: '安全圈的产品名单能列一公里长。别慌，它们的本质只有四类：<b>看门的、过滤的、巡逻的、破案的</b>。' },
    { type: 'table', head: ['设备', '人话职责', '部署位置', '比方'], rows: [
      ['防火墙 FW', '按规则放行/拦截进出流量', '网络边界（大门）', '门卫，看车牌放行'],
      ['WAF', '专防 Web 攻击（注入等）', '网站前面', '前台审单员，检查单子有没有夹带'],
      ['IDS/IPS', '发现/阻断可疑流量', '网络内部', '巡逻探头'],
      ['杀毒/防恶意', '查杀已知恶意文件', '每台终端', '家里的保安'],
      ['EDR', '监控每台电脑的行为，可远程处置', '每台终端', '每名员工的行为记录仪+远程遥控'],
      ['SIEM', '集中收集全部日志、关联告警', '机房/云端', '指挥中心大屏'],
      ['堡垒机', '运维人员进服务器的唯一通道', '运维入口', '访客登记处，谁进了哪个房间全程记录'],
      ['VPN', '远程办公加密通道', '入口', '秘密隧道'],
      ['沙箱', '隔离环境里"放毒试毒"', '邮件网关旁', '隔离病房，看附件到底干什么'],
      ['蜜罐', '假目标引诱攻击者', '内网角落', '假保险柜'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '一图记住防线层次', html: '互联网 → <b>防火墙</b>(门卫) → <b>WAF</b>(前台审单) → 业务系统；每台电脑装 <b>EDR</b>(记录仪)；所有日志汇入 <b>SIEM</b>(大屏)；运维走<b>堡垒机</b>(登记处)。<b>层层设卡，互相补位。</b>' },
    { type: 'h', text: '为什么设备这么多还会被黑？' },
    { type: 'ul', items: [
      '<b>0day 打不了</b>：无补丁漏洞，设备也认不出。',
      '<b>规则没人调</b>：告警堆积没人看（设备是死的，运营是活的）。',
      '<b>人被骗</b>：钓鱼邮件直接绕过所有技术防线。',
      '<b>配置错误</b>：防火墙买来默认全放行 = 摆设。',
    ]},
    { type: 'callout', ico: '🧠', kind: 'mind', title: '记忆卡', html: '<b>EDR 是近年最火的角色</b>：它不只"查杀文件"，而是记录进程、网络、文件行为，发现异常可以一键把主机隔离出网——应急响应的神器。' },
  ],
  takeaways: ['四类角色：看门(FW/VPN)、过滤(WAF/IPS)、巡逻(杀毒/EDR)、破案(SIEM/蜜罐)', 'EDR=行为记录仪+远程遥控，可一键隔离主机', '设备≠安全：0day、没人调规则、被骗、配错都会失守'],
  checks: [
    { q: '专防 SQL 注入、XSS 这类 Web 攻击的设备是？', opts: ['防火墙', 'WAF', 'VPN', '堡垒机'], a: 1, ex: 'WAF（Web Application Firewall）守在网站前审"请求单"，专拦 Web 攻击。' },
    { q: '应急时想"一键把疑似失陷主机隔离出网"，靠哪个能力？', opts: ['SIEM', 'EDR', 'VPN', '蜜罐'], a: 1, ex: 'EDR 支持主机隔离（断网禁机），是遏制阶段的核心工具。' },
  ],
},
{
  id: 'm4l3', module: 4, ico: '🚪', title: '零信任与最小权限',
  subtitle: '现代安全思想两根支柱，一句话各记住一个', minutes: 10, tags: ['零基础', '零信任'],
  content: [
    { type: 'p', html: '传统安全像城堡：<b>护城河外全是敌人，墙内全是自己人</b>。问题来了——黑客一旦混进墙内，就畅行无阻（横向移动）。现代安全思想改为：<b>别再假设墙内没坏人</b>。' },
    { type: 'h', text: '零信任（Zero Trust）' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '一句话版', html: '<b>"永不信任，持续验证"</b>。传统模式：脸熟就放行。零信任：就算天天见，<b>每次进门都查工牌</b>（验证身份+设备健康），而且你只能去你该去的房间。' },
    { type: 'ul', items: [
      '不再区分"内网=可信 / 外网=不可信"。',
      '每次访问都要验证：你是谁（身份）+ 你的设备安全吗（健康度）+ 你要去哪（权限）。',
      '内网分段：数据库和办公网之间也要过验证——<b>横向移动直接被卡死</b>。',
    ]},
    { type: 'h', text: '最小权限原则' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '一句话版', html: '<b>"只给你干活所必需的最小权限，多一点都不给"</b>。实习生不需要动生产数据库的权限；前台不需要管理员账号。权限越小，被攻陷后的损失越小。' },
    { type: 'ul', items: [
      '按角色授权（RBAC），定期回收离职/转岗人员的权限。',
      '重要操作双人复核。',
      '管理员账号与日常账号分开（别拿 admin 逛网页）。',
    ]},
    { type: 'h', text: '两者组合拳' },
    { type: 'code', text: '场景: 攻击者偷到了普通员工的账密\n\n传统城堡:  ✔ 登进内网 → 畅通无阻 → 拖库成功\n零信任+最小权限:  ✔ 登录需要 MFA(卡住)\n                  就算登进 → 只能访问本职系统\n                  想连数据库 → 需要额外审批 → 卡住' },
    { type: 'callout', ico: '🧠', kind: 'mind', title: '记忆卡', html: '零信任=<b>每次都查工牌</b>；最小权限=<b>只开该开的门</b>。它俩让"一台失陷、全网沦陷"变成"一台失陷、损失可控"。' },
  ],
  takeaways: ['零信任：永不信任，持续验证，内网也不例外', '最小权限：只给必需的权限，少一点都不给', '两者共同目标：一台失陷，损失可控'],
  checks: [
    { q: '零信任的核心理念是？', opts: ['内网绝对可信', '永不信任、持续验证，每次访问都验证', '只买贵的设备', '全网断网最安全'], a: 1, ex: '零信任取消"内网可信"假设，身份+设备+上下文持续验证。' },
    { q: '按最小权限原则，正确的做法是？', opts: ['所有人都是管理员，省事', '按岗位授予刚好够用的权限', '权限越大越好', '密码共享即可'], a: 1, ex: '最小权限=必需的最小授权，直接决定失陷后的爆炸半径。' },
  ],
},

/* ========================= 模块五：日志与检测入门 ========================= */
{
  id: 'm5l1', module: 5, ico: '📼', title: '什么是日志？',
  subtitle: 'IT 世界的行车记录仪：出事后唯一能回放的东西', minutes: 9, tags: ['零基础', '日志'],
  content: [
    { type: 'p', html: '电脑和设备会自动把"发生过的每件事"记下来，这就是<b>日志（Log）</b>：谁登录了、访问了什么网页、什么程序启动了……出事之后，日志是<b>唯一能"回放现场"</b>的证据。' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '通俗版', html: '日志=行车记录仪。平时没人看，出事故时全靠它定责。没装记录仪（没开日志）= 有理说不清。' },
    { type: 'h', text: '安全运营常看的日志' },
    { type: 'table', head: ['日志', '记录什么', '能回答什么'], rows: [
      ['系统/安全日志', '登录、进程、账号变更', '谁进的门、干了什么'],
      ['Web 访问日志', '每个 HTTP 请求', '谁访问了网站、访问了啥'],
      ['DNS 日志', '所有域名解析', '内网机器联系了谁'],
      ['防火墙/网关日志', '放行/拦截记录', '什么流量被挡了'],
      ['EDR/杀毒日志', '恶意行为与告警', '哪台机中招了'],
      ['VPN/堡垒机日志', '远程接入与运维操作', '谁从哪进来、执行了什么命令'],
    ]},
    { type: 'h', text: 'Windows 里几个"明星"事件 ID' },
    { type: 'table', head: ['ID', '含义', '用途'], rows: [
      ['4624', '登录成功', '查异常登录'],
      ['4625', '登录失败', '统计爆破'],
      ['4688', '进程创建', '看执行了什么命令'],
      ['4720', '新建账号', '揪后门账号'],
      ['7045', '安装新服务', '常见持久化手法'],
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '日志三大命门', html: '① <b>没开</b>：很多系统默认不记关键日志；② <b>时间不同步</b>：各设备差几分钟，案情串不起来（要统一 NTP）；③ <b>能被删</b>：攻击者会清日志——<b>关键日志必须实时外发到集中平台</b>，本地留一份等于没留。' },
  ],
  takeaways: ['日志=行车记录仪，出事后唯一可回放的证据', '常见源：系统、Web、DNS、防火墙、EDR、VPN', '三命门：没开、时间不同步、能被删（要集中外发）'],
  checks: [
    { q: '统计"谁在暴力破解登录"，主要看？', opts: ['4624 登录成功', '4625 登录失败', '7045 新服务', 'DNS 日志'], a: 1, ex: '爆破=海量失败尝试，统计 4625（或 Linux 的 Failed password）即可定位。' },
    { q: '为什么日志要"集中外发"存储？', opts: ['节省磁盘', '防止攻击者入侵后删除本地日志毁证', '日志更美观', '加快查询'], a: 1, ex: '入侵后清日志是标准动作，实时外发到 SIEM/日志服务器才能保住证据。' },
  ],
},
{
  id: 'm5l2', module: 5, ico: '📄', title: '读懂 Web 访问日志',
  subtitle: '一行日志=一条证词，带注释逐字段拆解', minutes: 11, tags: ['零基础', 'Web 日志'],
  content: [
    { type: 'p', html: 'Web 日志是运营分析师看得最多的数据。别怕，它只是把"谁、什么时候、要了什么"记成一行行文字。' },
    { type: 'code', text: '203.0.113.66 - - [06/Sep/2026:03:12:44 +0800] "GET /news.php?id=1%20OR%201=1 HTTP/1.1" 200 5021 "-" "sqlmap/1.7"\n\n拆解:\n203.0.113.66      ← 谁来的（来源 IP）\n[06/Sep/...03:12] ← 什么时候（凌晨三点！)\nGET /news.php...  ← 要什么（路径+参数）\n200               ← 结果（成功了）\n"sqlmap/1.7"      ← 自报家门（User-Agent: SQL注入工具！）' },
    { type: 'h', text: '异常信号四看' },
    { type: 'table', head: ['看什么', '正常', '可疑'], rows: [
      ['看 UA（自报家门）', 'Mozilla/5.0 Chrome', 'sqlmap、nmap、python-requests、空白'],
      ['看 URL 特征', '常规业务路径', "%20OR%201=1、../../、.env、cmd=whoami"],
      ['看状态码', '200/302 为主', '成串 401/403/404、突现 500'],
      ['看频率', '人类节奏', '每秒几十次、深夜高频、单一 IP 猛冲'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '看懂 %xx 百分号编码', html: 'URL 里的空格写成 <code>%20</code>，单引号 <code>%27</code>，<code>&lt;</code> 写成 <code>%3C</code>。黑客用编码躲关键词检测，所以分析前要<b>先解码</b>：<code>%27+OR+%271%27%3D%271</code> 解码就是 <code>\' OR \'1\'=\'1</code>（SQL 注入实锤）。' },
    { type: 'h', text: '三条实战直觉' },
    { type: 'ul', items: [
      '登录接口大量 401 后<b>突然一条 200</b> → 爆破成功，立刻核查！',
      '扫描器常先要 <code>/robots.txt</code>，再成串访问 <code>/admin、/.env、/phpmyadmin</code> → 踩点中。',
      '上传功能后出现<b>新的 .php 文件被频繁 POST</b> → 疑似 Webshell 已就位。',
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '别被 200 骗了', html: '<b>200 ≠ 安全</b>。SQL 盲注可能全是 200；反过来大量 404 也不是"没打着"，而是攻击者在画地图——踩点本身就是入侵前奏。' },
  ],
  takeaways: ['一行日志六要素：IP、时间、方法、路径、状态码、UA', '四看：UA、URL 特征、状态码、频率', '先解码再分析；401 后的 200 最危险'],
  checks: [
    { q: '日志 User-Agent 显示 sqlmap/1.7，说明？', opts: ['正常浏览器', 'SQL 注入工具在测站', '手机访问', 'CDN 节点'], a: 1, ex: 'sqlmap 是最常用的自动化 SQL 注入工具，出现即被"点名"。' },
    { q: '%27 在 URL 编码里代表？', opts: ['空格', '单引号 \'', '斜杠', '问号'], a: 1, ex: '%27=单引号，%20=空格。解码是日志分析的基本功。' },
  ],
},
{
  id: 'm5l3', module: 5, ico: '⌨️', title: 'grep 与正则入门',
  subtitle: '从"肉眼翻日志"进化到"一键捞针"', minutes: 13, tags: ['零基础', 'grep', '正则'],
  content: [
    { type: 'p', html: '一个日志文件几百万行，肉眼看等于失明。<b>grep</b> 是"在文本里找关键词"的命令，<b>正则</b>是"描述一类特征的模板"。两者组合=大海捞针神功。' },
    { type: 'h', text: '第一课：find（先找到关键词）' },
    { type: 'code', text: 'grep "401" access.log          # 找出含 401 的行（爆破现场）\ngrep "203.0.113.66" access.log # 找出这个 IP 的所有行为\ngrep -c "401" access.log       # -c 只数数量\ngrep -i "sqlmap" access.log    # -i 不分大小写\ngrep -v " 200 " access.log     # -v 反选：不含 200 的行' },
    { type: 'h', text: '第二课：管道（命令接力棒）' },
    { type: 'code', text: '# 统计 Top10 访问 IP —— 分析师最常用的"万能公式"\nawk \'{print $1}\' access.log | sort | uniq -c | sort -rn | head -10\n#        ↑取第1列(IP)      ↑排序   ↑数数     ↑按次数倒序  ↑取前10' },
    { type: 'h', text: '第三课：正则（特征模板）' },
    { type: 'table', head: ['符号', '意思', '例子'], rows: [
      ['.', '任意一个字符', 'a.c → abc/a1c'],
      ['\\d', '一个数字', '192.168.1.\\d+'],
      ['[a-z]+', '连续小写字母', '[a-z]+\\.php'],
      ['*', '+', '?', '重复：0+次 / 1+次 / 0或1次', '\\d{1,3}(\\.\\d{1,3}){3} 匹配IP'],
      ['^  $', '行首 / 行尾', '^ERROR'],
      ['(a|b)', 'a 或 b', '(union|select)'],
    ]},
    { type: 'h', text: '实战：抓攻击特征' },
    { type: 'code', text: '# 抓 SQL 注入试探（解码后特征）\ngrep -E "(union.{0,10}select|OR 1=1|sleep\\([0-9]+\\))" access.log\n\n# 抓路径穿越\ngrep -E "(\\.\\./){2,}" access.log\n\n# 抓疑似 Webshell 的诡异参数\ngrep -E "cmd=|exec=|system\\(" access.log' },
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '两个新手坑', html: '① <code>.*</code> 乱用：匹配一切，慢且误报多，<b>锚点要具体</b>。② <b>忘了解码</b>：日志里是 %27%20OR，直接搜 "OR 1=1" 一个都搜不到。<b>先解码，再匹配。</b>' },
    { type: 'callout', ico: '💡', kind: 'tip', title: '练习场', html: '去游戏区玩「<b>日志侦探</b>」——这一课所有特征都会变成关卡，玩两局就形成肌肉记忆。' },
  ],
  takeaways: ['grep 找关键词；-c 数数、-v 反选、-i 忽略大小写', 'awk|sort|uniq -c|sort -rn = Top-N 万能公式', '正则锚点要具体；先解码再匹配'],
  checks: [
    { q: '统计日志里出现最多的 IP，正确流水线是？', opts: ["awk '{print $1}' | sort | uniq -c | sort -rn", 'grep ip | wc -l', 'cat | more', 'ls -l'], a: 0, ex: '取 IP 列→排序→计数→按次数倒序，这是 Top-N 统计的标准姿势。' },
    { q: '为什么检测前要先把 URL 解码？', opts: ['为了美观', '防止 %27%20OR 这类编码绕过关键词匹配', '省内存', '日志规范'], a: 1, ex: '不解码，编码后的攻击载荷全部漏网。' },
  ],
},
{
  id: 'm5l4', module: 5, ico: '🔔', title: '告警与误报',
  subtitle: '狼来了的故事：为什么好规则比多规则重要', minutes: 10, tags: ['零基础', '告警', '误报'],
  content: [
    { type: 'p', html: '安全设备按"规则"报警：命中条件就响。理想很美好，现实是——<b>90% 的告警是误报</b>。学会分辨和治理误报，是分析师的看家本领。' },
    { type: 'h', text: '告警长什么样？' },
    { type: 'code', text: '[P2] 暴力破解疑似成功\n主机: FIN-03 (10.1.2.33)  账号: admin\n证据: 10分钟内 143 次 4625 失败 → 1 次 4624 成功\n来源: 45.83.x.x (境外IDC)\n建议: 核实登录是否本人，必要时隔离主机' },
    { type: 'h', text: '误报从哪来？' },
    { type: 'ul', items: [
      '<b>正常业务长得像攻击</b>：爬虫批量下载、凌晨定时备份、自己做安全扫描。',
      '<b>阈值不合理</b>："登录失败 5 次报警"——对接企业微信的应用一天失败几百次很正常。',
      '<b>特征太宽</b>：规则匹配"select"一词 → 所有带"选择"的业务全中招。',
      '<b>资产底账不清</b>：不知道那台"陌生 IP"其实是新上线的服务器。',
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '研判三连问', html: '来了一条告警，按顺序问：<b>① 这台机器/账号是干什么的？</b>（资产背景）→ <b>② 有没有正常解释？</b>（变更窗口、定时任务）→ <b>③ 证据链指向恶意吗？</b>（时间线、外联、后续行为）。三问之后再定性。' },
    { type: 'h', text: '告警分级' },
    { type: 'table', head: ['级别', '定义', '例子', '时限'], rows: [
      ['P1', '正在/即将造成损失', '勒索执行、堡垒机异常登录', '10 分钟'],
      ['P2', '大概率入侵成功', '爆破成功、Webshell 落地', '30 分钟'],
      ['P3', '攻击明确但被拦住', 'WAF 拦截的注入', '当天'],
      ['P4', '噪音', '零星探测', '周报'],
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '告警疲劳=蓝队头号杀手', html: '日均 2000 条、九成误报，分析师会练成"自动无视"——<b>真攻击混进来也没人看</b>。宁可规则少而准，不要多而吵。每周做一次"误报归因→修规则→历史回测"的调优闭环。' },
  ],
  takeaways: ['告警=规则命中，误报占大头是常态', '研判三连问：资产背景→正常解释→证据链', '分级响应；每周调优对抗告警疲劳'],
  checks: [
    { q: '规则日均 500 条告警、98% 误报，正确做法？', opts: ['关掉规则', '归因误报→加白名单/收特征→回测→上线', '调小音量', '加人手'], a: 1, ex: '关掉会漏真攻击；调优闭环（归因→修→回测）才是正解。' },
    { q: '研判告警时第一个应该确认的是？', opts: ['攻击者是谁', '这台机器/账号的正常业务背景', '报告格式', '领导意见'], a: 1, ex: '先建立基线（它正常什么样），异常才有意义——这是研判的第一步。' },
  ],
},
{
  id: 'm5l5', module: 5, ico: '🖥️', title: 'SIEM：安全指挥中心',
  subtitle: '把全城摄像头接进一块大屏，还能自动串并联', minutes: 9, tags: ['零基础', 'SIEM'],
  content: [
    { type: 'p', html: '<b>SIEM</b>（安全信息与事件管理）= 安全运营的中央大脑：把全网日志收进来、洗整齐、自动关联、产出告警。' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '通俗版', html: '各设备的日志像各小区自己的监控录像，谁也看不到谁。<b>SIEM=把全城录像实时汇进指挥中心</b>，还能自动串并联：A 小区丢电瓶 + B 小区拍到同一个人 = 蛛丝马迹。' },
    { type: 'h', text: 'SIEM 的五步流水线' },
    { type: 'code', text: '采集 → 归一化 → 关联分析 → 告警 → 处置闭环\n\n关联分析有多神？（单看哪条都无害）\n[用户A 09:00 在北京登录VPN] + [09:05 同账号 在境外登录]\n→ 时空矛盾 → 高置信度告警: 账号被盗！' },
    { type: 'h', text: '常见平台' },
    { type: 'table', head: ['平台', '一句话'], rows: [
      ['Splunk', '商业标杆，检索强大（贵）'],
      ['Elastic/ELK', '开源积木，自由度高'],
      ['Wazuh', '开源免费，入门实战首选'],
      ['国产平台', '态势感知/天眼类，合规场景常见'],
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '最大的误区', html: '<b>SIEM 买得贵 ≠ 安全</b>。没有规则运营的 SIEM = 装了摄像头没人看。检测能力在人 + 流程 + 规则，不在许可证。' },
    { type: 'callout', ico: '🧠', kind: 'mind', title: '关联的价值', html: '安全真相往往"藏在组合里"：一次登录无害、一次下载无害、一个新进程无害——<b>三者串起来就是完整入侵</b>。这是人工翻日志做不到、SIEM 存在的意义。' },
  ],
  takeaways: ['SIEM 五步：采集→归一化→关联→告警→闭环', '关联分析把孤立事件拼成案情', '买了 SIEM 还要持续运营规则'],
  checks: [
    { q: 'SIEM 最核心的价值是？', opts: ['存日志多', '跨源关联分析，产生高置信度告警', '网速快', '界面炫'], a: 1, ex: '单源事件往往无害，跨源关联才能拼出真相——这是 SIEM 的灵魂。' },
    { q: '"北京登录 5 分钟后境外同账号登录"，SIEM 用的检测思路是？', opts: ['特征码匹配', '关联分析（时空矛盾）', '文件查杀', '端口封禁'], a: 1, ex: '时空矛盾是经典关联规则场景：物理上不可能的两地登录=账号被盗。' },
  ],
},

/* ========================= 模块六：应急响应入门 ========================= */
{
  id: 'm6l1', module: 6, ico: '🚨', title: '中招了怎么办？六步法',
  subtitle: '慌乱是应急最大的敌人，流程是唯一的解药', minutes: 11, tags: ['零基础', '应急'],
  content: [
    { type: 'p', html: '真出事时没人天生冷静，靠的是<b>流程肌肉记忆</b>。全球通用的应急六步法（SANS PICERL），每步都有明确的"该做/别做"。' },
    { type: 'table', head: ['步骤', '做什么', '千万别做'], rows: [
      ['1 准备', '平时: 预案、联系人、备份演练', '临时抱佛脚'],
      ['2 识别', '确认: 真攻击还是误报？影响多大？', '不确认就大动干戈'],
      ['3 遏制', '止损: 断网隔离、封 IP、改密码', '直接关机（毁证据！）'],
      ['4 根除', '杀干净: 补漏洞、清所有后门', '只杀马不堵洞（三天后复发）'],
      ['5 恢复', '验证干净后恢复业务、持续观察', '没验证就恢复（带回后门）'],
      ['6 复盘', '时间线、根因、整改项', '开成批斗会（没人说真话）'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '医院类比', html: '<b>识别</b>=分诊判断病情 → <b>遏制</b>=隔离病房防传染 → <b>根除</b>=手术切病灶 → <b>恢复</b>=康复出院观察 → <b>复盘</b>=病例讨论会。' },
    { type: 'h', text: '黄金四原则（背下来）' },
    { type: 'ul', items: [
      '<b>隔离 ≠ 关机</b>：断网保机器——内存里有攻击通道和线索，关机=帮攻击者擦现场。',
      '<b>先取证，再处置</b>：动手前先截屏、拍照、导出关键日志。',
      '<b>记录一切</b>：每一步操作+时间+执行人，报告全靠它。',
      '<b>重大事件先上报</b>：别一个人扛，管理层/法务/公关需要同步知情。',
    ]},
    { type: 'h', text: '为什么"杀完三天又复发"？' },
    { type: 'p', html: '因为<b>持久化的"根"没拔掉</b>：计划任务、启动项、SSH 公钥、Webshell、后门账号……它们会重新拉起恶意程序。根除 = 杀进程 + <b>逐项清点所有持久化点</b>（下一课给清单）。' },
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '个人版口诀', html: '家里电脑中招的简化流程：<b>断网 → 杀毒全盘扫 → 改密码（用别的干净设备改）→ 系统重装最稳妥 → 检查备份是否完好</b>。' },
  ],
  takeaways: ['六步：准备→识别→遏制→根除→恢复→复盘', '隔离不关机；先取证再处置；记录一切', '根除必须拔根：清点所有持久化点'],
  checks: [
    { q: '应急"遏制"阶段的正确动作是？', opts: ['立即关机', '断网隔离、封禁恶意 IP、重置相关密码', '格式化', '等攻击者停手'], a: 1, ex: '遏制=阻止扩散并保留证据：断网禁机+封通道+换凭据。' },
    { q: '主机查杀后反复复发，最可能漏了？', opts: ['杀毒版本旧', '持久化入口（计划任务/启动项/公钥）未清除', '网速慢', '没重启'], a: 1, ex: '持久化会重新拉起恶意载荷，不拔根必复发。' },
  ],
},
{
  id: 'm6l2', module: 6, ico: '🪟', title: 'Windows 排查手册',
  subtitle: '口诀：进程→网络→持久化→账号→痕迹', minutes: 12, tags: ['零基础', 'Windows'],
  content: [
    { type: 'p', html: '收到"某 Windows 主机疑似失陷"的告警后照这张单子查，五步走完案情基本清楚。<b>本课是"抄作业"页，建议收藏。</b>' },
    { type: 'h', text: '① 进程：谁在跑？' },
    { type: 'code', text: 'tasklist /svc                       # 进程和服务对应\nwmic process get name,processid,commandline   # 完整命令行\n\n疑点信号:\n- 系统进程却跑在奇怪路径\n- 名字像系统文件却在用户目录\n- PowerShell/cmd 的"父进程"是 Word/Excel（宏攻击！）' },
    { type: 'h', text: '② 网络：在和谁通话？' },
    { type: 'code', text: 'netstat -ano | findstr ESTABLISHED   # 外联 IP:端口 + 进程号\n# 可疑: 陌生境外 IP、非常见端口、进程名对不上' },
    { type: 'h', text: '③ 持久化：重启后它还在吗？' },
    { type: 'code', text: 'schtasks /query /fo LIST /v          # 计划任务（重灾区）\nreg query "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run"\nwmic startup get caption,command     # 启动项' },
    { type: 'h', text: '④ 账号：有外人吗？' },
    { type: 'code', text: 'net user                             # 陌生账号（尤其带 $ 的隐藏账号）\nnet localgroup administrators        # 管理员组被加人？\n# 事件查看器看: 4624 登录 / 4625 失败 / 4688 进程 / 4720 建号' },
    { type: 'h', text: '⑤ 痕迹：它干过什么？' },
    { type: 'ul', items: [
      'Web 目录按修改时间排查新文件（找 Webshell）。',
      'PowerShell 历史：<code>ConsoleHost_history.txt</code>。',
      '杀软/EDR 告警历史、勒索信文件（README_xxx.txt）。',
      '预取 Prefetch：执行过什么程序、什么时候执行的。',
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: 'PowerShell 红旗', html: '命令行出现 <code>-enc</code>（Base64 混淆）、<code>DownloadString</code>（远程下载执行）→ 基本可定性为恶意行为，这是无文件攻击的最爱。' },
  ],
  takeaways: ['五步口诀：进程→网络→持久化→账号→痕迹', '必查：计划任务、Run 注册表、新账号、ESTABLISHED 外联', '-enc / DownloadString = PowerShell 恶意标志'],
  checks: [
    { q: 'Windows 应急查持久化，第一个查？', opts: ['回收站', '计划任务与注册表 Run 启动项', '壁纸', '书签'], a: 1, ex: '计划任务和 Run 键是最常用的持久化点，必查。' },
    { q: 'PowerShell 命令出现大量 -enc 参数意味着？', opts: ['系统优化', 'Base64 混淆执行，典型恶意手法', '压缩日志', '性能调优'], a: 1, ex: '-enc 把命令 Base64 混淆执行，是恶意 PowerShell 的经典特征。' },
  ],
},
{
  id: 'm6l3', module: 6, ico: '🐧', title: 'Linux 排查手册',
  subtitle: '服务器应急，十个人九个从 crontab 开始', minutes: 12, tags: ['零基础', 'Linux'],
  content: [
    { type: 'p', html: 'Linux 应急同样五步：<b>进程 → 网络 → 持久化 → 账号 → 痕迹</b>。继续"抄作业"。' },
    { type: 'h', text: '① 进程' },
    { type: 'code', text: 'top -c            # CPU 排序 + 完整命令（挖矿立现）\nps auxf           # 进程树，看父子关系' },
    { type: 'h', text: '② 网络' },
    { type: 'code', text: 'netstat -antp     # 外联 + 进程（ss -antp 同理）\nlsof -i :3333     # 谁占着矿池端口\n# 可疑: 矿池端口 3333/4444/5555、陌生境外 IP' },
    { type: 'h', text: '③ 持久化（Linux 特色全家桶）' },
    { type: 'code', text: 'crontab -l                    # 当前用户计划任务\nls -alt /etc/cron*            # 系统级 cron，看最近新增\nls -al ~/.ssh/authorized_keys # ⚠ 被塞陌生公钥了吗！\nsystemctl list-unit-files --state=enabled\ncat /etc/rc.local' },
    { type: 'h', text: '④ 账号与登录' },
    { type: 'code', text: 'last        # 登录成功记录\nlastb       # 登录失败（爆破证据）\nw           # 当前在线\nawk -F: \'$3==0{print $1}\' /etc/passwd   # 有几个 UID=0 的？' },
    { type: 'h', text: '⑤ 痕迹' },
    { type: 'ul', items: [
      '历史命令：<code>history</code> / <code>~/.bash_history</code>（被清空=掩盖痕迹）。',
      '24h 新增文件：<code>find / -mtime -1 -type f</code>。',
      'SSH 登录日志：<code>/var/log/secure</code> 或 <code>auth.log</code>。',
      'SUID 后门：<code>find / -perm -4000 -type f</code>。',
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '新手最容易懂的一条', html: '<code>~/.ssh/authorized_keys</code> 里如果出现你没添加过的公钥，<b>等于小偷在门上装了自己的锁</b>——随时免密回来。发现即高危，立刻删除并排查来源。' },
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '进阶冷知识', html: '<code>/etc/ld.so.preload</code> 非空 = 可能存在"进程隐藏"木马（连 ls 都看不到它）。见到直接拉最高级别处置。' },
  ],
  takeaways: ['Linux 五步与 Windows 相同', '必查：crontab、authorized_keys、UID=0 账号、lastb', 'authorized_keys 陌生公钥=小偷装了自己的锁'],
  checks: [
    { q: 'SSH 公钥后门藏在哪个文件？', opts: ['/etc/passwd', '~/.ssh/authorized_keys', '/var/log/secure', '/etc/hosts'], a: 1, ex: '写入公钥即可免密登录，是最隐蔽的持久化之一。' },
    { q: '检查"有几个人拥有最高权限（UID=0）"，用哪条命令？', opts: ["awk -F: '$3==0{print $1}' /etc/passwd", 'ls /root', 'top', 'df -h'], a: 0, ex: 'UID=0 即 root 等价权限，正常应只有 root 一个。' },
  ],
},

/* ========================= 模块七：毕业进阶 ========================= */
{
  id: 'm7l1', module: 7, ico: '📡', title: '威胁情报：通缉令数据库',
  subtitle: '从"被动看告警"升级到"主动知道谁在打我"', minutes: 9, tags: ['零基础', '情报'],
  content: [
    { type: 'p', html: '<b>威胁情报</b>=关于"对手"的知识库：他用的 IP、域名、文件指纹、惯用手法。相当于 SOC 的"全国通缉令数据库"。' },
    { type: 'h', text: '情报的两个层次' },
    { type: 'table', head: ['层次', '内容', '有效期', '比方'], rows: [
      ['IOC 指标', '恶意 IP、域名、文件哈希', '短（几天到几周）', '嫌疑人的车牌号和长相'],
      ['TTP 手法', '行为模式：怎么踩点、怎么驻留', '长（几个月到几年）', '作案手法——换车不换手'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '为什么要分两层', html: '黑客可以随时换 IP、换域名（换车），但<b>作案手法很难改（不换手）</b>。高阶蓝队靠匹配 TTP 抓人，比只查车牌号（IOC）更可靠。' },
    { type: 'h', text: '情报怎么用？（标准五连）' },
    { type: 'code', text: '获取(订阅公开情报源) → 比对(导入 SIEM/EDR 自动匹配)\n→ 核查(命中了≠中招，先排除巧合) → 处置(封禁/排查主机)\n→ 回溯(用新情报查 90 天历史日志: 早中招了吗?)' },
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '误报重灾区', html: '很多 CDN/云服务 IP 会"共享"出现在黑名单里——<b>直接封可能封死自家业务</b>。情报消费必须带上下文核查，盲信黑名单=自断粮草。' },
  ],
  takeaways: ['IOC=车牌号（短命），TTP=作案手法（长命）', '五连：获取→比对→核查→处置→历史回溯', '情报命中先核查上下文再处置'],
  checks: [
    { q: '相比 IOC，TTP 情报的优势是？', opts: ['格式简单', '对手换基础设施后仍能靠行为模式识别', '更便宜', '数量更多'], a: 1, ex: '换车不换手——手法比车牌号的生命周期长得多。' },
    { q: '拿到新的 C2 域名情报后，最有价值的动作？', opts: ['封禁完事', '封禁同时回溯 90 天日志，看是否早已失联', '转发领导', '存文件夹'], a: 1, ex: '历史回溯（hunting）能揪出早已潜伏的失陷主机，价值远大于"封完就完"。' },
  ],
},
{
  id: 'm7l2', module: 7, ico: '🍯', title: '蜜罐：假保险柜',
  subtitle: '谁碰谁暴露——误报率最低的告警器', minutes: 8, tags: ['零基础', '蜜罐'],
  content: [
    { type: 'p', html: '<b>蜜罐（Honeypot）</b>= 一台没有任何正常业务、专门"引诱"攻击者的假目标。<b>它最大的价值：几乎零误报</b>——正常员工永远不会去碰它，谁碰谁可疑。' },
    { type: 'callout', ico: '💡', kind: 'easy', title: '通俗版', html: '小区里停几辆装了隐形报警器的"假奔驰"——小偷一碰全城皆知。对内网横向移动尤其灵：<b>没人有正当理由去登录一个假的数据库副本</b>。' },
    { type: 'h', text: '两种形态' },
    { type: 'table', head: ['类型', '原理', '特点'], rows: [
      ['低交互', '模拟端口和 Banner（假 SSH/假 Redis）', '安全省事，信息浅'],
      ['高交互', '真实系统/虚拟机，完整记录攻击', '情报价值高，但要严格隔离'],
    ]},
    { type: 'h', text: '欺骗防御全家桶' },
    { type: 'ul', items: [
      '<b>蜜 token</b>：假密码文件/假云密钥，谁使用→立刻报警并反查是哪台主机。',
      '<b>蜜文件</b>：命名诱人的假资源（<code>passwords.xlsx</code>、<code>backup_最终版.rar</code>）。',
      '<b>蜜域名</b>：只写在恶意软件配置里的假 C2 域名，命中=该主机已失陷。',
    ]},
    { type: 'callout', ico: '⚠️', kind: 'warn', title: '部署三不要', html: '不要放真实数据；不要疏于监控（引狼入室却没人看）；<b>不要让蜜罐能主动连内网其他机器</b>——否则从"传感器"变"跳板"。' },
  ],
  takeaways: ['蜜罐=零误报的攻击探测器', '蜜 token/蜜文件是内网横向的绝佳报警器', '三不要：不存真数据、不疏于监控、限制出向'],
  checks: [
    { q: '蜜罐告警为什么被认为是高置信度的？', opts: ['数量多', '没有正常业务会碰它，命中即可疑', '速度快', '厂商宣传'], a: 1, ex: '零业务属性，任何触碰都异常——天然零误报。' },
    { q: '蜜罐部署最重要的安全约束？', opts: ['界面好看', '严格限制其主动出向连接、不存真实数据', '越大越好', '用生产账号'], a: 1, ex: '失控蜜罐会被反向利用成跳板，必须隔离+限制出向。' },
  ],
},
{
  id: 'm7l3', module: 7, ico: '📊', title: '用数字说话 + 你的下一步',
  subtitle: 'MTTD/MTTR 运营指标，以及从今天起的成长路线', minutes: 11, tags: ['零基础', '指标', '职业'],
  content: [
    { type: 'p', html: '安全做得好不好，不能靠"感觉挺稳的"。四个数字让效果看得见——也是面试和汇报的高频词。' },
    { type: 'table', head: ['指标', '含义', '类比', '怎么变好'], rows: [
      ['MTTD 平均检测时间', '从被攻击到被发现', '小偷进屋到被发现', '加检测规则覆盖'],
      ['MTTR 平均响应时间', '从发现到恢复', '报警到制服小偷', '预案+演练+自动化'],
      ['误报率', '告警里假警报占比', '烤鱼触发烟雾报警', '每周调优规则'],
      ['ATT&CK 覆盖度', '检测能力覆盖多少攻击技术', '小区监控死角比例', '按热力图补盲区'],
    ]},
    { type: 'callout', ico: '💡', kind: 'easy', title: '为什么管理层在乎 MTTD', html: '业界从失陷到发现的平均时间曾高达 200+ 天——意味着攻击者有 200 天随便搬东西。<b>把 MTTD 从 30 天压到 7 天，比买任何一台新设备都值钱。</b>' },
    { type: 'callout', ico: '🧠', kind: 'mind', title: '对上汇报心法', html: '领导不懂"SQL 注入"，但懂"零中断、损失为零、风险已闭环"。<b>把技术翻译成业务语言</b>，是你从技术岗走向负责人的第一课。' },
    { type: 'h', text: '你的成长路线（本站学完后）' },
    { type: 'code', text: '第 1 步 ✅ 本站全部课程 + 游戏全通关（你正在这里）\n第 2 步  动手: 装 Wazuh/ELK 玩真实日志，会 grep 会写规则\n第 3 步  认证: CompTIA Security+ → 蓝 bridge 实战训练营\n第 4 步  实战: 应急响应靶场（蓝桥/CTF 防守题）、日志分析比赛\n第 5 步  入行: SOC 监控岗/安全服务工程师 → 分析师 → 响应专家' },
    { type: 'ul', items: [
      '<b>每天 30 分钟</b>：看一个安全公众号/情报源，保持"新闻感"。',
      '<b>每周一次</b>：把本站游戏的日志特征亲手在真实/模拟环境里复现一遍。',
      '<b>每月一次</b>：完整复盘一道应急案例（案例区随时可练）。',
    ]},
  ],
  takeaways: ['四大指标：MTTD、MTTR、误报率、ATT&CK 覆盖度', '把技术风险翻译成业务语言再汇报', '路线：本站通关 → 动手搭平台 → 认证/靶场 → 入行'],
  checks: [
    { q: 'MTTD 从 30 天降到 7 天，最直接的意义？', opts: ['告警更少', '攻击者驻留窗口大幅缩短，损失更低', '加班更多', '日志更多'], a: 1, ex: '发现越快，攻击者活动时间越短，止损与溯源成本越低。' },
    { q: '向管理层汇报安全成果，最有效的表达？', opts: ['展示 100 条拦截日志', '业务语言：零中断、闭环率、MTTD/MTTR 趋势', '罗列工具名', '展示攻击代码'], a: 1, ex: '管理层关心业务影响与趋势，用指标讲故事最有说服力。' },
  ],
},
];
