      ['2 武器化', '制作带毒文档/攻击工具', '配万能钥匙'],
      ['3 投递', '发钓鱼邮件、攻击暴露服务', '混进大楼'],
      ['4 利用', '点开就中招 / 漏洞执行', '溜进大堂'],
