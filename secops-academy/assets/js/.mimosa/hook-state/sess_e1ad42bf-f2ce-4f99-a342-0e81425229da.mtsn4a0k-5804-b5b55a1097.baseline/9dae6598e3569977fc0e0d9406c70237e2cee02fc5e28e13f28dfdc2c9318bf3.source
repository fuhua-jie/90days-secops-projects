    tasks: [
      { q: '特权 Pod 的名字', hint: 'grep privileged /logs/k8s_audit.csv', ans: ['debug-box'], teach: '📦 privileged+hostPID 双开=容器内可以直接操作宿主机进程与命名空间。' },
