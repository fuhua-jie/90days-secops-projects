    brief: 'k8s 审计日志显示：有人从容器"跨"到了宿主机。',
    files: { '/logs/k8s_audit.csv': [
      'ts,user,verb,resource,detail',
      '03:00:00,dev01,create,pod,"name=debug-box privileged=true hostPID=true ns=default"',
